+//验证调用者的CPU内存区域
+static bool Sdmmc_CpuBufferValid(const void *buffer, uint32_t bytes, bool write)
+{
+    uint32_t address = (uint32_t)buffer;
+    uint32_t end;
+    bool valid;
+
+    //拒绝零长度、溢出和专用DMA区，避免memcpy自覆盖或外设寄存器访问
+    if (buffer == NULL || bytes == 0U || address > UINT32_MAX - (bytes - 1U))
+        return false;
+    end = address + bytes - 1U;
+    valid = (address >= 0x20000000UL && end < 0x20020000UL) ||
+        (address >= 0x24008000UL && end < 0x24080000UL) ||
+        (address >= 0x30000000UL && end < 0x30048000UL) ||
+        (address >= 0xD0000000UL && end < 0xD0400000UL);
+
+    //写卡允许从Flash读取常量，读卡不能把Flash当作可写目的区
+    if (write && address >= 0x08000000UL && end < 0x08200000UL)
+        valid = true;
+    return valid;
+}
+
+//确认本次IDMA已不再访问AXI缓冲区
+static bool Sdmmc_Quiescent(void)
+{
+    __DSB();
+    return (SDMMC1->IDMACTRL & SDMMC_IDMA_IDMAEN) == 0U &&
+        (SDMMC1->STA & (SDMMC_FLAG_DPSMACT | SDMMC_FLAG_CMDACT)) == 0U &&
+        (SDMMC1->CMD & SDMMC_CMD_CMDTRANS) == 0U;
+}
+
+//处理真实硬件终止状态
+static void Sdmmc_ServiceEvents(void)
+{
+    uint32_t primask, notified, flags, errors;
+
+    //IRQ和主循环之间只交换事件，不在临界区内运行HAL
+    primask = __get_PRIMASK();
+    __disable_irq();
+    notified = s_irq_status;
+    s_irq_status = 0U;
+    flags = SDMMC1->STA;
+    __set_PRIMASK(primask);
+    errors = flags & (SDMMC_FLAG_DCRCFAIL | SDMMC_FLAG_DTIMEOUT |
+        SDMMC_FLAG_RXOVERR | SDMMC_FLAG_TXUNDERR | SDMMC_FLAG_IDMATE);
+    if ((flags & SDMMC_FLAG_DATAEND) == 0U && errors == 0U)
+        return;
+
+    //先保存错误，因为当前HAL先处理DATAEND，可能清除同周期错误标志
+    if (errors != 0U)
+    {
+        if ((errors & SDMMC_FLAG_DTIMEOUT) != 0U)
+            s_batch_error |= HAL_SD_ERROR_DATA_TIMEOUT;
+        if ((errors & SDMMC_FLAG_DCRCFAIL) != 0U)
+            s_batch_error |= HAL_SD_ERROR_DATA_CRC_FAIL;
+        if ((errors & SDMMC_FLAG_RXOVERR) != 0U)
+            s_batch_error |= HAL_SD_ERROR_RX_OVERRUN;
+        if ((errors & SDMMC_FLAG_TXUNDERR) != 0U)
+            s_batch_error |= HAL_SD_ERROR_TX_UNDERRUN;
+        if ((errors & SDMMC_FLAG_IDMATE) != 0U)
+            s_batch_error |= HAL_SD_ERROR_DMA;
+    }
+    if (notified == 0U)
+        s_io.lost_irq_polls++;
+    s_io.status = flags;
+    SDMMC1->MASK = 0U;
+
+    //IDMA错误不由当前HAL IRQ覆盖，交给任务侧统一Abort
+    if ((errors & SDMMC_FLAG_IDMATE) == 0U)
+        HAL_SD_IRQHandler(&s_sd);
+    __DSB();
+}
+
+//等待传输完成和卡恢复可传输状态
+static SysResult_t Sdmmc_WaitBatch(uint32_t started, uint32_t timeout_ms)
+{
+    uint32_t raw, elapsed, state;
+    bool present;
+    SysResult_t result;
+
+    for (;;)
+    {
+
+        //卡拔出和时间到期都优先于成功，避免交付已经过期的结果
+        result = BSP_SDMMC_ReadDetect(&raw, &present);
+        if (result != SYS_OK || !present)
+            return result != SYS_OK ? result : SYS_ERR_NOT_FOUND;
+        elapsed = HAL_GetTick() - started;
+        if (elapsed >= timeout_ms)
+            return SYS_ERR_TIMEOUT;
+        Sdmmc_ServiceEvents();
+        if (s_batch_error != 0U || HAL_SD_GetError(&s_sd) != 0U)
+            return Sdmmc_Result(HAL_ERROR, s_batch_error | HAL_SD_GetError(&s_sd));
+
+        //HAL回调、主机停止和卡TRANSFER都满足才能复用本批DMA内存
+        if (s_batch_done && Sdmmc_Quiescent() && HAL_SD_GetState(&s_sd) == HAL_SD_STATE_READY)
+        {
+            //DATAEND之外再核对剩余字节，拒绝完成回调与计数器矛盾的帧
+            if (SDMMC1->DCOUNT != 0U)
+                return SYS_ERR_PROTOCOL;
+            state = HAL_SD_GetCardState(&s_sd);
+            if (HAL_SD_GetError(&s_sd) != 0U)
+                return Sdmmc_Result(HAL_ERROR, HAL_SD_GetError(&s_sd));
+            if (HAL_GetTick() - started >= timeout_ms)
+                return SYS_ERR_TIMEOUT;
+            if (state == HAL_SD_CARD_TRANSFER)
+                return SYS_OK;
+        }
+
+        //有限阻塞还可发现丢失IRQ，等待期间其他业务任务正常运行
+        elapsed = HAL_GetTick() - started;
+        if (elapsed >= timeout_ms)
+            return SYS_ERR_TIMEOUT;
+        result = s_wait_ops.wait(s_wait_ops.context, timeout_ms - elapsed > 5U ? 5U : timeout_ms - elapsed);
+        if (result != SYS_OK && result != SYS_ERR_TIMEOUT)
+            return result;
+    }
+}
+
+//停止失败的IDMA事务
+static SysResult_t Sdmmc_StopIo(void)
+{
+    HAL_StatusTypeDef status;
+    SysResult_t result;
+
+    //屏蔽事件后才停止硬件，清理期间不允许旧IRQ改变事务
+    HAL_NVIC_DisableIRQ(SDMMC1_IRQn);
+    SDMMC1->MASK = 0U;
+    status = HAL_SD_Abort(&s_sd);
+    result = Sdmmc_Result(status, 0U);
+    if (result == SYS_OK && !Sdmmc_Quiescent())
+        result = SYS_ERR_IO;
+    if (result == SYS_OK)
+    {
+        __HAL_SD_CLEAR_FLAG(&s_sd, SDMMC_STATIC_FLAGS);
+        HAL_NVIC_ClearPendingIRQ(SDMMC1_IRQn);
+        s_batch_active = false;
+        s_irq_status = 0U;
+        s_io.active = 0U;
+    }
+
+    //无论停止是否成功，原卡状态都不能直接继续使用
+    s_io.fault = 1U;
+    s_io.transfer_ready = 0U;
+    s_diagnostics.ready = 0U;
+    return result;
+}
+
+//执行带统一截止时间的分批块读写
+static SysResult_t Sdmmc_Transfer(uint32_t lba, uint32_t count, void *buffer,
+    uint32_t timeout_ms, bool write)
+{
+    uint32_t started, done = 0U, blocks, bytes, primask;
+    uint32_t raw;
+    bool present;
+    SysResult_t result;
+    HAL_StatusTypeDef status;
+
+    //使用减法校验范围，避免HAL中lba+count产生无符号回绕
+    if (count == 0U || count > UINT32_MAX / BSP_SDMMC_BLOCK_SIZE ||
+        timeout_ms == 0U || timeout_ms > INT32_MAX ||
+        !Sdmmc_CpuBufferValid(buffer, count * BSP_SDMMC_BLOCK_SIZE, write))
+        return SYS_ERR_INVALID_ARG;
+    if (!Sdmmc_CanInit() || s_wait_ops.can_wait == NULL ||
+        !s_wait_ops.can_wait(s_wait_ops.context) || !BSP_SDMMC_MemoryValid())
+        return SYS_ERR_INVALID_STATE;
+    if (!Sdmmc_Take())
+        return SYS_ERR_BUSY;
+    if (s_io.transfer_ready == 0U || s_io.fault != 0U || s_diagnostics.ready == 0U)
+    {
+        Sdmmc_Give();
+        return SYS_ERR_INVALID_STATE;
+    }
+    //共享时钟或寄存器被其他代码改写后拒绝传输，不能沿用旧40MHz诊断
+    if (__HAL_RCC_GET_SDMMC_SOURCE() != RCC_SDMMCCLKSOURCE_PLL ||
+        HAL_RCCEx_GetPeriphCLKFreq(RCC_PERIPHCLK_SDMMC) != SDMMC_KERNEL_HZ ||
+        (SDMMC1->CLKCR & SDMMC_CLKCR_WIDBUS) != SDMMC_BUS_WIDE_4B ||
+        (SDMMC1->CLKCR & SDMMC_CLKCR_CLKDIV) != (s_io.high_speed != 0U ? 3U : 5U))
+    {
+        s_io.fault = 1U;
+        s_io.transfer_ready = 0U;
+        s_diagnostics.ready = 0U;
+        Sdmmc_Give();
+        return SYS_ERR_INVALID_STATE;
+    }
+    if (lba >= s_card.logical_block_count || count > s_card.logical_block_count - lba ||
+        (s_card.card_type == CARD_SDSC && lba + count - 1U > UINT32_MAX / BSP_SDMMC_BLOCK_SIZE))
+    {
+        Sdmmc_Give();
+        return SYS_ERR_INVALID_ARG;
+    }
+
+    //取得唯一操作权后更新请求诊断，不重置历史IRQ计数
+    started = HAL_GetTick();
+    s_io.lba = lba;
+    s_io.requested_blocks = count;
+    s_io.completed_blocks = 0U;
+    s_io.write = write ? 1U : 0U;
+    s_io.result = SYS_OK;
+    s_io.recovery_result = SYS_OK;
+    s_io.hal_error = 0U;
+    s_io.active = 1U;
+    s_io.dma_address = (uint32_t)g_sdmmc_dma_buffer;
+    s_io.dma_bytes = sizeof(g_sdmmc_dma_buffer);
+    result = SYS_OK;
+    while (done < count)
+    {
+
+        //每批都重新检查卡和剩余时间，不在大请求中无限续期
+        result = BSP_SDMMC_ReadDetect(&raw, &present);
+        if (result != SYS_OK || !present)
+        {
+            result = result != SYS_OK ? result : SYS_ERR_NOT_FOUND;
+            break;
+        }
+        if (HAL_GetTick() - started >= timeout_ms)
+        {
+            result = SYS_ERR_TIMEOUT;
+            break;
+        }
+        if (!Sdmmc_Quiescent() || HAL_SD_GetState(&s_sd) != HAL_SD_STATE_READY)
+        {
+            result = SYS_ERR_INVALID_STATE;
+            break;
+        }
+        blocks = count - done > BSP_SDMMC_DMA_BLOCKS ? BSP_SDMMC_DMA_BLOCKS : count - done;
+        bytes = blocks * BSP_SDMMC_BLOCK_SIZE;
+        if (write)
+            memcpy(g_sdmmc_dma_buffer, (const uint8_t *)buffer + done * BSP_SDMMC_BLOCK_SIZE, bytes);
+
+        //CPU准备完成后建立本批状态，清除旧事件再交给IDMA
+        primask = __get_PRIMASK();
+        __disable_irq();
+        SDMMC1->MASK = 0U;
+        __HAL_SD_CLEAR_FLAG(&s_sd, SDMMC_STATIC_FLAGS);
+        HAL_NVIC_ClearPendingIRQ(SDMMC1_IRQn);
+        s_irq_status = 0U;
+        s_batch_done = false;
+        s_batch_error = 0U;
+        s_batch_write = write;
+        s_batch_active = true;
+        __DSB();
+        __set_PRIMASK(primask);
+        status = write ? HAL_SD_WriteBlocks_DMA(&s_sd, g_sdmmc_dma_buffer, lba + done, blocks) :
+            HAL_SD_ReadBlocks_DMA(&s_sd, g_sdmmc_dma_buffer, lba + done, blocks);
+        result = Sdmmc_Result(status, HAL_SD_GetError(&s_sd));
+        if (result != SYS_OK)
+            break;
+
+        //IDMATE没有独立MASK使能位，由有限等待后的状态检查捕获
+        result = Sdmmc_WaitBatch(started, timeout_ms);
+        if (result != SYS_OK)
+            break;
+        s_batch_active = false;
+        __DSB();
+        if (!write)
+            memcpy((uint8_t *)buffer + done * BSP_SDMMC_BLOCK_SIZE, g_sdmmc_dma_buffer, bytes);
+        done += blocks;
+        s_io.completed_blocks = done;
+    }
+
+    //先保存原错误，再尝试停止；清理结果不能覆盖原操作结果
+    s_io.result = result;
+    s_io.hal_error = s_batch_error | HAL_SD_GetError(&s_sd);
+    if (result != SYS_OK)
+        s_io.recovery_result = Sdmmc_StopIo();
+    else
+        s_io.active = 0U;
+    s_io.elapsed_ms = HAL_GetTick() - started;
+    Sdmmc_Give();
+    return result;
+}
diff --git a/CM7/BSP/bsp_sdmmc.h b/CM7/BSP/bsp_sdmmc.h
index 8aa262f..f55fa62 100644
--- a/CM7/BSP/bsp_sdmmc.h
+++ b/CM7/BSP/bsp_sdmmc.h
@@ -79,4 +79,70 @@ SysResult_t BSP_SDMMC_GetDiagnostics(BspSdmmcDiagnostics_t *diagnostics);
 //释放本外设资源，失败时保留占用以便再次清理
 SysResult_t BSP_SDMMC_DeInit(void);
 
+//SDMMC专用AXI区域，32KiB一次最多64个逻辑扇区
+#define BSP_SDMMC_DMA_BASE   0x24000000UL
+#define BSP_SDMMC_DMA_BYTES  (32UL * 1024UL)
+#define BSP_SDMMC_BLOCK_SIZE 512UL
+#define BSP_SDMMC_DMA_BLOCKS (BSP_SDMMC_DMA_BYTES / BSP_SDMMC_BLOCK_SIZE)
+
+//等待适配只使用普通C类型，不把RTOS句柄传入BSP
+//wait允许虚假唤醒，BSP每次醒来重新检查硬件和统一截止时间
+//notify只由SDMMC IRQ调用，context必须在驱动使用期间始终有效
+typedef struct
+{
+    bool (*can_wait)(void *context);
+    SysResult_t (*wait)(void *context, uint32_t timeout_ms);
+    void (*notify)(void *context);
+    void *context;
+} BspSdmmcWaitOps_t;
+
+//记录最近一次块请求和清理结果，不把HAL READY当作完成证明
+typedef struct
+{
+    uint32_t active;//请求占用内部缓冲区，FAULT时可能继续保留
+    uint32_t fault;//必须显式恢复后才能再请求
+    uint32_t transfer_ready;//已经完成4-bit及速度模式配置
+    uint32_t high_speed;//成功执行High Speed切换，不等同卡宣传速度
+    uint32_t lba;//本次请求起始扇区
+    uint32_t requested_blocks;//本次请求总扇区数
+    uint32_t completed_blocks;//已经确认成功的批次扇区数
+    uint32_t write;//本次是否写入
+    uint32_t irq_count;//SDMMC中断次数
+    uint32_t lost_irq_polls;//任务检测到事件但未收到IRQ通知的次数
+    uint32_t status;//清理前STA原始值
+    uint32_t hal_error;//原始HAL错误，不被Abort覆盖
+    uint32_t elapsed_ms;//整次请求时间，含恢复
+    uint32_t dma_address;//实际内部缓冲区地址
+    uint32_t dma_bytes;//内部区域容量
+    SysResult_t result;//原始操作结果
+    SysResult_t recovery_result;//停止和恢复结果
+} BspSdmmcIoDiagnostics_t;
+
+//启动期配置专用MPU区域，不改变全局Cache开关
+SysResult_t BSP_SDMMC_MemoryInit(void);
+
+//验证链接地址和MPU属性，拒绝缓存属性或地址不匹配的缓冲区
+bool BSP_SDMMC_MemoryValid(void);
+
+//登记静态等待适配，只允许首次登记或相同适配重复登记
+SysResult_t BSP_SDMMC_SetWaitOps(const BspSdmmcWaitOps_t *ops);
+
+//低速识卡后切换4-bit，支持High Speed时使用40MHz，否则24MHz
+SysResult_t BSP_SDMMC_EnableTransferMode(void);
+
+//任务侧读取扇区，IDMA仅访问内部AXI区，成功后复制到调用者
+SysResult_t BSP_SDMMC_ReadBlocks(uint32_t lba, uint32_t count, void *buffer, uint32_t timeout_ms);
+
+//任务侧写入扇区，调用者数据先复制到内部AXI区，写超时不自动重试
+SysResult_t BSP_SDMMC_WriteBlocks(uint32_t lba, uint32_t count, const void *buffer, uint32_t timeout_ms);
+
+//获取最近一次块请求诊断，事务运行中返回BUSY避免读取半更新状态
+SysResult_t BSP_SDMMC_GetIoDiagnostics(BspSdmmcIoDiagnostics_t *diagnostics);
+
+//获取当前识卡会话的原始CID，仅用于卡身份校验
+SysResult_t BSP_SDMMC_GetIdentity(uint32_t cid[4]);
+
+//显式停止并重置SDMMC1，成功后仍需要重新识卡和配置速度
+SysResult_t BSP_SDMMC_Recover(void);
+
 #endif
diff --git a/CM7/BSP/bsp_sdmmc_memory.c b/CM7/BSP/bsp_sdmmc_memory.c
new file mode 100644
index 0000000..0af1b7a
--- /dev/null
+++ b/CM7/BSP/bsp_sdmmc_memory.c
@@ -0,0 +1,87 @@
+//SDMMC缓冲区独立放入AXI，MPU只覆盖这一块32KiB区域
+#include "bsp_sdmmc.h"
+#include "stm32h7xx_hal.h"
+#include "framework_init.h"
+
+//链接器将本段独占放在0x24000000，不允许普通数据进入同一区域
+uint8_t g_sdmmc_dma_buffer[BSP_SDMMC_DMA_BYTES]
+    __attribute__((section(".sdmmc_dma"), zero_init, aligned(32)));
+
+//编译时核对MPU区域与块大小，宏改变后不能静默产生属性覆盖
+typedef char Sdmmc_DmaSizeCheck[(BSP_SDMMC_DMA_BYTES == (1UL << (MPU_REGION_SIZE_32KB + 1U))) ? 1 : -1];
+typedef char Sdmmc_DmaBaseCheck[(BSP_SDMMC_DMA_BASE & (BSP_SDMMC_DMA_BYTES - 1U)) == 0U ? 1 : -1];
+typedef char Sdmmc_DmaBlockCheck[(BSP_SDMMC_DMA_BYTES % BSP_SDMMC_BLOCK_SIZE) == 0U ? 1 : -1];
+
+//保存启动期配置结果，失败只禁止SD操作，不影响Camera和USB初始化
+static bool s_memory_ready;
+
+//准备内存并保留独立故障状态，不让可选SD设备阻止Framework启动
+static SysResult_t Sdmmc_MemoryPrepare(void);
+
+//启动期配置SDMMC专用MPU区域
+SysResult_t BSP_SDMMC_MemoryInit(void)
+{
+    MPU_Region_InitTypeDef region = {0};
+    uint32_t primask;
+
+    //Cache已经开启时不修改未知旧属性，避免遗留脏行覆盖DMA数据
+    if (__get_IPSR() != 0U || (SCB->CCR & SCB_CCR_DC_Msk) != 0U ||
+        (uint32_t)g_sdmmc_dma_buffer != BSP_SDMMC_DMA_BASE)
+        return SYS_ERR_INVALID_STATE;
+
+    //配置发生在任务运行前，只在MPU更新期间短暂屏蔽中断
+    primask = __get_PRIMASK();
+    __disable_irq();
+    HAL_MPU_Disable();
+    region.Enable = MPU_REGION_ENABLE;
+    region.Number = MPU_REGION_NUMBER3;
+    region.BaseAddress = BSP_SDMMC_DMA_BASE;
+    region.Size = MPU_REGION_SIZE_32KB;
+    region.AccessPermission = MPU_REGION_FULL_ACCESS;
+    region.DisableExec = MPU_INSTRUCTION_ACCESS_DISABLE;
+    region.TypeExtField = MPU_TEX_LEVEL1;
+    region.IsCacheable = MPU_ACCESS_NOT_CACHEABLE;
+    region.IsBufferable = MPU_ACCESS_NOT_BUFFERABLE;
+    region.IsShareable = MPU_ACCESS_SHAREABLE;
+    HAL_MPU_ConfigRegion(&region);
+    HAL_MPU_Enable(MPU_PRIVILEGED_DEFAULT);
+    __DSB();
+    __ISB();
+    __set_PRIMASK(primask);
+    s_memory_ready = true;
+    return SYS_OK;
+}
+
+//核对链接位置和实际MPU属性
+bool BSP_SDMMC_MemoryValid(void)
+{
+    uint32_t primask, previous, base, attributes;
+    uint32_t expected = MPU_RASR_ENABLE_Msk | MPU_RASR_XN_Msk |
+        (3UL << MPU_RASR_AP_Pos) | (1UL << MPU_RASR_TEX_Pos) |
+        MPU_RASR_S_Msk | (MPU_REGION_SIZE_32KB << MPU_RASR_SIZE_Pos);
+
+    //地址和容量必须由真实链接结果满足，不能用类型转换掩盖DTCM地址
+    if (!s_memory_ready || (uint32_t)g_sdmmc_dma_buffer != BSP_SDMMC_DMA_BASE ||
+        sizeof(g_sdmmc_dma_buffer) != BSP_SDMMC_DMA_BYTES || (MPU->CTRL & MPU_CTRL_ENABLE_Msk) == 0U)
+        return false;
+
+    //RNR是共享选择寄存器，读回后恢复原值，避免影响其他MPU检查
+    primask = __get_PRIMASK();
+    __disable_irq();
+    previous = MPU->RNR;
+    MPU->RNR = MPU_REGION_NUMBER3;
+    base = MPU->RBAR & MPU_RBAR_ADDR_Msk;
+    attributes = MPU->RASR;
+    MPU->RNR = previous;
+    __set_PRIMASK(primask);
+    return base == BSP_SDMMC_DMA_BASE && attributes == expected;
+}
+
+//注册启动期内存准备
+static SysResult_t Sdmmc_MemoryPrepare(void)
+{
+    (void)BSP_SDMMC_MemoryInit();
+    return SYS_OK;
+}
+
+FRAMEWORK_INIT_REGISTER(Sdmmc_MemoryPrepare, INIT_LEVEL_PLATFORM);
diff --git a/CM7/Platform/sd_block.c b/CM7/Platform/sd_block.c
new file mode 100644
index 0000000..2b4b37b
--- /dev/null
+++ b/CM7/Platform/sd_block.c
@@ -0,0 +1,128 @@
+//块设备适配只负责RTOS等待，HAL和IDMA细节保持在BSP
+#include "sd_block.h"
+#include "FreeRTOS.h"
+#include "task.h"
+#include "semphr.h"
+#include "framework_init.h"
+#include "stm32h7xx.h"
+
+//二值信号量只合并唤醒事件，不承载完成结果或缓冲区所有权
+static StaticSemaphore_t s_event_storage;
+
+//保存静态信号量句柄，不占用内核堆
+static SemaphoreHandle_t s_event;
+
+//记录等待适配初始化结果，不让SD故障阻断其他Initcall
+static SysResult_t s_prepare_result = SYS_ERR_INVALID_STATE;
+
+//检查调用环境允许阻塞和SDMMC中断唤醒
+static bool SdBlock_CanWait(void *context);
+
+//有限阻塞等待中断事件，超时后BSP仍会检查硬件状态
+static SysResult_t SdBlock_Wait(void *context, uint32_t timeout_ms);
+
+//从SDMMC中断唤醒当前唯一等待者
+static void SdBlock_Notify(void *context);
+
+//准备静态同步资源，不识卡也不读写扇区
+static SysResult_t SdBlock_Prepare(void);
+
+//识卡并配置4-bit正式传输模式
+SysResult_t SD_Block_Init(void)
+{
+    SysResult_t result;
+
+    //只允许准备完成后的任务调用，不能在Initcall或ISR中开始块访问
+    if (s_prepare_result != SYS_OK || !SdBlock_CanWait(NULL))
+        return SYS_ERR_INVALID_STATE;
+    result = BSP_SDMMC_Init();
+    if (result != SYS_OK && result != SYS_ERR_ALREADY_EXISTS)
+        return result;
+    return BSP_SDMMC_EnableTransferMode();
+}
+
+//读取逻辑扇区
+SysResult_t SD_Block_Read(uint32_t lba, uint32_t count, void *buffer, uint32_t timeout_ms)
+{
+    return BSP_SDMMC_ReadBlocks(lba, count, buffer, timeout_ms);
+}
+
+//写入逻辑扇区
+SysResult_t SD_Block_Write(uint32_t lba, uint32_t count, const void *buffer, uint32_t timeout_ms)
+{
+    return BSP_SDMMC_WriteBlocks(lba, count, buffer, timeout_ms);
+}
+
+//读取本地卡信息副本
+SysResult_t SD_Block_GetInfo(BspSdmmcCardInfo_t *info)
+{
+    return BSP_SDMMC_GetCardInfo(info);
+}
+
+//停止故障事务并撤销旧卡信息
+SysResult_t SD_Block_Recover(void)
+{
+    return BSP_SDMMC_Recover();
+}
+
+//检查任务可以阻塞等待
+static bool SdBlock_CanWait(void *context)
+{
+    (void)context;
+
+    //屏蔽IRQ或暂停调度器时不允许进入阻塞操作
+    return s_event != NULL && __get_IPSR() == 0U && __get_PRIMASK() == 0U &&
+        __get_BASEPRI() == 0U && xTaskGetSchedulerState() == taskSCHEDULER_RUNNING;
+}
+
+//等待一次事件或有限超时
+static SysResult_t SdBlock_Wait(void *context, uint32_t timeout_ms)
+{
+    TickType_t ticks;
+    (void)context;
+
+    //至少等待一个Tick，不把不足一个Tick转换为忙轮询
+    if (!SdBlock_CanWait(NULL) || timeout_ms == 0U)
+        return SYS_ERR_INVALID_STATE;
+    ticks = pdMS_TO_TICKS(timeout_ms);
+    if (ticks == 0U)
+        ticks = 1U;
+    return xSemaphoreTake(s_event, ticks) == pdTRUE ? SYS_OK : SYS_ERR_TIMEOUT;
+}
+
+//合并SDMMC中断唤醒
+static void SdBlock_Notify(void *context)
+{
+    BaseType_t wake = pdFALSE;
+    (void)context;
+
+    //IRQ优先级7满足FreeRTOS阈值，事件满时仍由硬件状态保证结果不丢失
+    if (s_event != NULL)
+    {
+        (void)xSemaphoreGiveFromISR(s_event, &wake);
+        portYIELD_FROM_ISR(wake);
+    }
+}
+
+//准备块设备等待适配
+static SysResult_t SdBlock_Prepare(void)
+{
+    BspSdmmcWaitOps_t ops;
+
+    //只创建一次静态资源，不重复初始化已经登记的队列控制块
+    if (s_event == NULL)
+        s_event = xSemaphoreCreateBinaryStatic(&s_event_storage);
+    if (s_event == NULL)
+    {
+        s_prepare_result = SYS_ERR_NO_RESOURCE;
+        return SYS_OK;
+    }
+    ops.can_wait = SdBlock_CanWait;
+    ops.wait = SdBlock_Wait;
+    ops.notify = SdBlock_Notify;
+    ops.context = NULL;
+    s_prepare_result = BSP_SDMMC_SetWaitOps(&ops);
+    return SYS_OK;
+}
+
+FRAMEWORK_INIT_REGISTER(SdBlock_Prepare, INIT_LEVEL_PLATFORM);
diff --git a/CM7/Platform/sd_block.h b/CM7/Platform/sd_block.h
new file mode 100644
index 0000000..d78ba59
--- /dev/null
+++ b/CM7/Platform/sd_block.h
@@ -0,0 +1,21 @@
+#ifndef CM7_SD_BLOCK_H
+#define CM7_SD_BLOCK_H
+
+#include "bsp_sdmmc.h"
+
+//识卡并切换正式速度，只允许可阻塞的普通任务调用
+SysResult_t SD_Block_Init(void);
+
+//读取任意合法数量的512B扇区，失败时不得使用整次请求的数据
+SysResult_t SD_Block_Read(uint32_t lba, uint32_t count, void *buffer, uint32_t timeout_ms);
+
+//写入扇区，调用者负责文件系统或授权原始区域，超时可能已部分写入
+SysResult_t SD_Block_Write(uint32_t lba, uint32_t count, const void *buffer, uint32_t timeout_ms);
+
