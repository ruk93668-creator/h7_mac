+        event->command_id != s_supervisor.status.pending_id)
+        return SYS_OK;
+
+    //åªæœ‰æœåŠ¡è‡ªå·±ç»™å‡ºçš„åŒ¹é…ç»ˆç»“æ‰èƒ½è½¬ç§»å·²ç¡®è®¤çŠ¶æ€ã€‚
+    component = pending->bit;
