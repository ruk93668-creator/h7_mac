+    if (slot == NULL)
+        return SYS_ERR_INVALID_ARG;
+    if (!Record_TaskContext() || !App_MessagesIsOwner(owner))
+        return SYS_ERR_INVALID_STATE;
+
+    //Recordæ²¡æœ‰ISRè®¿é—®è€…ã€‚ä½¿ç”¨å†…æ ¸ä¸´ç•ŒåŒºæŠŠä¿¡å·æäº¤å’ŒçŠ¶æ€å‘å¸ƒç»‘å®šåœ¨åŒä¸€æ¬¡ä»»åŠ¡è°ƒåº¦è¾¹ç•Œä¸Š
+    taskENTER_CRITICAL();
+    if (slot->state != RECORD_WAITING)
+    {
+        taskEXIT_CRITICAL();
+        return SYS_ERR_ALREADY_EXISTS;
+    }
+
+    //ä¿¡å·æ§½ç§æœ‰ä¸”é”€æ¯æ—¶å·²æ’ç©ºã€‚å³ä½¿æäº¤å¼‚å¸¸ï¼Œä¹Ÿå¿…é¡»å†»ç»“å®é™…å¤±è´¥å¹¶é‡Šæ”¾ä¸´ç•ŒåŒº
+    signal_result = AppV3Queue_Put(slot->signal, &token, 0U);
+    if (result == SYS_OK && signal_result != SYS_OK)
+        result = signal_result;
+    slot->instance = result == SYS_OK ? instance : NULL;
