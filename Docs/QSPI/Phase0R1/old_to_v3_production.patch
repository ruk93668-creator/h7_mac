+    s_supervisor.desired = desired;
+    s_supervisor.file_number = file_number;
+    //è‹¥ä»æœ‰æœªè¯æ˜é€€å‡ºçš„æœåŠ¡ï¼Œæ¸…ç†è®¡åˆ’ä¿ç•™æ—§é¦–é”™ã€‚
+    if (s_supervisor.status.uncertain == 0U)
