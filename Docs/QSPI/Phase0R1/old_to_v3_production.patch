+    if (operation == SUPERVISOR_RECOVER &&
+        ((s_supervisor.status.uncertain & component) == 0U ||
+         ((s_supervisor.status.active | s_supervisor.status.uncertain) & Supervisor_Dependents(component)) != 0U))
