+    void *context;
+    //æœåŠ¡èº«ä»½ï¼Œç”¨äºç­›é€‰ç»“æœæˆ–å‘é€ç”Ÿå‘½å‘¨æœŸå‘½ä»¤
+    RuntimeEventTarget_t service;
+    //å½“å‰ç™»è®°çš„å‡­æ®ï¼Œæ’¤é”€åä¸èƒ½å†å¼•ç”¨æ—§ä¸Šä¸‹æ–‡
+    uint32_t ticket;
+} AppV3BusinessSubscription_t;
+
+//è®¢é˜…ã€åˆ†å‘ä¸è¯Šæ–­ä»…ç”±Controlæ“ä½œï¼Œä¸åœ¨å…¨å±€ä¸­æ–­é”å†…è°ƒç”¨å¤–éƒ¨å›è°ƒ
+static AppV3BusinessSubscription_t s_subscriptions[BUSINESS_SUBSCRIPTIONS];
+//ç”±Controlç»´æŠ¤çš„ä¸šåŠ¡ç»“æœä¸æ‹’ç»è®°å½•
+static AppV3BusinessDiagnostics_t s_diagnostics;
+//è®¢é˜…ç¥¨å·æ°´ä½ï¼Œè€—å°½æ—¶åœæ­¢åˆ†é…ä»¥é˜²å¤ç”¨
