+static uint32_t s_uvc_reader_id;
+
+//åªæ‰¿è®¤çœŸæ­£çš„å®Œæˆã€å–æ¶ˆæˆ–å…³é—­ä½œä¸ºé€€åœºç†ç”±
+static bool UsbService_IsExitReason(UsbUvcReaderExit_t reason)
