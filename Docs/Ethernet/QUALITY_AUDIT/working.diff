-//组装普通HTTP响应并交给主循环发送
-static void EthHttp_Respond(unsigned code)
-{
-    const char *status, *body, *type = "text/plain; charset=utf-8", *allow = "";
-    char page[512];
-    char ip[16];
-    int length;
-    switch (code)
