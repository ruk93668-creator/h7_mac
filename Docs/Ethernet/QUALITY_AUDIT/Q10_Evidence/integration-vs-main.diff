++             '/Fo' + str(out) + '\\']
++    for sources, warning in ((port, '/W4'), (lwip, '/W3')):
++        subprocess.run(['cl', *flags, warning, '/WX', '/c', *sources], cwd=root, check=True)
++    objects = [str(out / (Path(source).stem + '.obj')) for source in port + lwip]
