diff --git a/main-after/Platform/Ethernet/eth_board_stm32h747.c b/main-after/Platform/Ethernet/eth_board_stm32h747.c
new file mode 100644
index 0000000..003dd65
--- /dev/null
+++ b/main-after/Platform/Ethernet/eth_board_stm32h747.c
@@ -0,0 +1,55 @@
+//STM32H747 原理图相关的时钟、RMII GPIO 和 PHY 硬件复位
+#include "eth_board.h"
+#ifdef ETH_MAC_HOST_TEST
+#include "fake_hal.h"
+#else
+#include "stm32h7xx_hal.h"
+#endif
+
+//内部功能函数声明
+static void EthBoard_ConfigurePins(void);
+
+//对外接口实现
+
+//准备板级资源，不配置描述符或启动 MAC/DMA
+void EthBoard_Prepare(void)
+{
+	__HAL_RCC_SYSCFG_CLK_ENABLE();
+	HAL_SYSCFG_ETHInterfaceSelect(SYSCFG_ETH_RMII);
+	(void)SYSCFG->PMCR;
+	__HAL_RCC_ETH1MAC_CLK_ENABLE();
+	__HAL_RCC_ETH1TX_CLK_ENABLE();
+	__HAL_RCC_ETH1RX_CLK_ENABLE();
+	EthBoard_ConfigurePins();
+}
+
+//内部功能函数实现
+
+//按原理图配置 RMII 引脚并复位 PHY
+static void EthBoard_ConfigurePins(void)
+{
+	GPIO_InitTypeDef gpio = {0};
+
+	__HAL_RCC_GPIOA_CLK_ENABLE();
+	__HAL_RCC_GPIOC_CLK_ENABLE();
+	__HAL_RCC_GPIOG_CLK_ENABLE();
+	//PG9 控制 PHY 复位，RMII 输入和 strap 稳定前保持低电平
+	HAL_GPIO_WritePin(GPIOG, GPIO_PIN_9, GPIO_PIN_RESET);
+	gpio.Pin = GPIO_PIN_9;
+	gpio.Mode = GPIO_MODE_OUTPUT_PP;
+	gpio.Pull = GPIO_NOPULL;
+	gpio.Speed = GPIO_SPEED_FREQ_LOW;
+	HAL_GPIO_Init(GPIOG, &gpio);
+	gpio.Mode = GPIO_MODE_AF_PP;
+	gpio.Speed = GPIO_SPEED_FREQ_VERY_HIGH;
+	gpio.Alternate = GPIO_AF11_ETH;
+	gpio.Pin = GPIO_PIN_1 | GPIO_PIN_2 | GPIO_PIN_7;
+	HAL_GPIO_Init(GPIOA, &gpio);
+	gpio.Pin = GPIO_PIN_1 | GPIO_PIN_4 | GPIO_PIN_5;
+	HAL_GPIO_Init(GPIOC, &gpio);
+	gpio.Pin = GPIO_PIN_11 | GPIO_PIN_13 | GPIO_PIN_14;
+	HAL_GPIO_Init(GPIOG, &gpio);
+	HAL_Delay(2U);
+	HAL_GPIO_WritePin(GPIOG, GPIO_PIN_9, GPIO_PIN_SET);
+	HAL_Delay(10U);
+}
diff --git a/main-after/Platform/Ethernet/eth_dma.c b/main-after/Platform/Ethernet/eth_dma.c
new file mode 100644
index 0000000..ebe79c8
--- /dev/null
+++ b/main-after/Platform/Ethernet/eth_dma.c
@@ -0,0 +1,246 @@
+//描述符环和内部缓冲区管理
+#include "eth_dma.h"
+#include <string.h>
+typedef char descriptor_size_check[(sizeof(EthDmaDescriptor_t) == 32U) ? 1 : -1];
+typedef char buffer_alignment_check[(ETH_BUFFER_SIZE % 32U == 0U) ? 1 : -1];
+typedef char rx_descriptor_offset_check[(offsetof(EthDmaMemory_t, rx) == 128U) ? 1 : -1];
+typedef char tx_buffer_offset_check[(offsetof(EthDmaMemory_t, tx_buffer) == 256U) ? 1 : -1];
+typedef char rx_buffer_offset_check[(offsetof(EthDmaMemory_t, rx_buffer) == 6400U) ? 1 : -1];
+
+//内部功能函数声明
+static uint32_t EthDma_Address(const void *pointer);
+
+static unsigned EthDma_NextIndex(unsigned index);
+
+static int EthDma_MemoryOverlaps(
+	const EthDmaRing_t *ring,
+	const void *pointer,
+	size_t length
+);
+
+static void EthDma_Barrier(EthDmaRing_t *ring);
+
+static void EthDma_PostRx(
+	EthDmaRing_t *ring,
+	unsigned index
+);
+
+//对外接口实现
+
+//仅在硬件停止后重建描述符和软件索引
+EthResult_t eth_ring_reset(
+	EthDmaRing_t *ring,
+	EthDmaMemory_t *memory,
+	const EthDmaOps_t *ops
+)
+{
+	unsigned index;
+
+	if (ring == NULL || memory == NULL || ops == NULL || ops->barrier == NULL ||
+		ops->tx_kick == NULL || ops->rx_kick == NULL || ((uintptr_t)memory & 31U) != 0U)
+		return ETH_ARGUMENT;
+	//DMA 停止并确认复位后才能重建，丢弃的发送由上层统计
+	memset(ring, 0, sizeof(*ring));
+	ring->memory = memory;
+	ring->ops = *ops;
+	memset(memory, 0, sizeof(*memory));
+	ring->rx_guard = ETH_RING_CAPACITY;
+	for (index = 0U;
+		 index < ETH_RING_CAPACITY;
+		 ++index)
+		EthDma_PostRx(ring, index);
+	return ETH_OK;
+}
+
+//复制发送数据并发布描述符所有权
+EthResult_t eth_ring_tx(
+	EthDmaRing_t *ring,
+	const void *data,
+	size_t length,
+	uint32_t *ticket
+)
+{
+	EthDmaDescriptor_t *descriptor;
+	unsigned index;
+
+	if (ring == NULL || ring->memory == NULL || data == NULL || ticket == NULL || length < 14U ||
+		length > ETH_FRAME_MAX)
+		return ETH_ARGUMENT;
+	if (EthDma_MemoryOverlaps(ring, data, length) ||
+		EthDma_MemoryOverlaps(ring, ticket, sizeof(*ticket)))
+		return ETH_ARGUMENT;
+	if (ring->tx_count == ETH_RING_CAPACITY)
+	{
+		++ring->statistics.tx_full;
+		return ETH_BUSY;
+	}
+	index = ring->tx_head;
+	descriptor = &ring->memory->tx[index];
+	if (ring->pending[index] || (descriptor->w[3] & ETH_DESC_OWN) != 0U)
+	{
+		++ring->statistics.ownership_errors;
+		return ETH_STATE;
+	}
+	EthDma_Barrier(ring);
+	memcpy(ring->memory->tx_buffer[index], data, length);
+	descriptor->w[0] = EthDma_Address(ring->memory->tx_buffer[index]);
+	descriptor->w[1] = 0U;
+	descriptor->w[2] = UINT32_C(0x80000000) | (uint32_t)length; //使能完成中断并填写缓冲区长度
+	ring->pending[index] = 1U;
+	ring->ticket[index] = ++ring->sequence;
+	*ticket = ring->ticket[index];
+	++ring->tx_count;
+	ring->tx_head = EthDma_NextIndex(index);
+	++ring->statistics.tx_submitted;
+	EthDma_Barrier(ring);
+	descriptor->w[3] = ETH_DESC_OWN | ETH_DESC_FD | ETH_DESC_LD | (uint32_t)length;
+	EthDma_Barrier(ring);
+	//尾指针指向下一个描述符，OWN 仍限制 DMA 访问
+	ring->ops.tx_kick(ring->ops.context, EthDma_Address(&ring->memory->tx[ring->tx_head]));
+	return ETH_OK;
+}
+
+//按提交顺序回收已完成的发送槽
+EthResult_t eth_ring_reclaim(
+	EthDmaRing_t *ring,
+	uint32_t *ticket
+)
+{
+	uint32_t status;
+	unsigned index;
+	EthResult_t result = ETH_OK;
+
+	if (ring == NULL || ring->memory == NULL || ticket == NULL)
+		return ETH_ARGUMENT;
+	if (EthDma_MemoryOverlaps(ring, ticket, sizeof(*ticket)))
+		return ETH_ARGUMENT;
+	if (ring->tx_count == 0U)
+		return ETH_EMPTY;
+	index = ring->tx_tail;
+	status = ring->memory->tx[index].w[3];
+	if (!ring->pending[index])
+	{
+		++ring->statistics.ownership_errors;
+		return ETH_STATE;
+	}
+	if ((status & ETH_DESC_OWN) != 0U)
+		return ETH_EMPTY;
+	EthDma_Barrier(ring);
+	if ((status & (ETH_DESC_ES | UINT32_C(0x40000000))) != 0U ||
+		(status & (ETH_DESC_FD | ETH_DESC_LD)) != (ETH_DESC_FD | ETH_DESC_LD))
+	{
+		++ring->statistics.tx_errors;
+		result = ETH_FRAME_ERROR;
+	}
+	else
+		++ring->statistics.tx_completed;
+	*ticket = ring->ticket[index];
+	ring->pending[index] = 0U;
+	--ring->tx_count;
+	ring->tx_tail = EthDma_NextIndex(index);
+	return result;
+}
+
+//复制有效接收帧并轮转接收 guard
+EthResult_t eth_ring_rx(
+	EthDmaRing_t *ring,
+	void *data,
+	size_t capacity,
+	size_t *length
+)
+{
+	unsigned index;
+	uint32_t status;
+	size_t frame_length;
+	EthResult_t result;
+	if (ring == NULL || ring->memory == NULL || data == NULL || length == NULL)
+		return ETH_ARGUMENT;
+	if (EthDma_MemoryOverlaps(ring, data, capacity) ||
+		EthDma_MemoryOverlaps(ring, length, sizeof(*length)))
+		return ETH_ARGUMENT;
+	*length = 0U;
+	index = ring->rx_head;
+	status = ring->memory->rx[index].w[3];
+	if ((status & ETH_DESC_OWN) != 0U)
+		return ETH_EMPTY;
+	EthDma_Barrier(ring);
+	frame_length = (size_t)(status & UINT32_C(0x7FFF));
+	if ((status & ETH_DESC_FD) != 0U)
+		ring->dropping = 0U;
+	if (ring->dropping || (status & (ETH_DESC_FD | ETH_DESC_LD)) != (ETH_DESC_FD | ETH_DESC_LD) ||
+		(status & (ETH_DESC_ES | UINT32_C(0x40000000))) != 0U || frame_length < 14U ||
+		frame_length > ETH_FRAME_MAX)
+	{
+		++ring->statistics.rx_errors;
+		result = ETH_FRAME_ERROR;
+		ring->dropping = (uint8_t)((status & ETH_DESC_LD) == 0U);
+	}
+	else
+	{
+		*length = frame_length;
+		if (capacity < frame_length)
+		{
+			++ring->statistics.rx_small;
+			return ETH_CAPACITY;
+		}
+		memcpy(data, ring->memory->rx_buffer[index], frame_length);
+		++ring->statistics.rx_delivered;
+		result = ETH_OK;
+	}
+	EthDma_PostRx(ring, ring->rx_guard);
+	ring->rx_guard = index;
+	ring->rx_head = EthDma_NextIndex(index);
+	//尾指针指向新 guard，归还旧 guard 的接收容量
+	ring->ops.rx_kick(ring->ops.context, EthDma_Address(&ring->memory->rx[ring->rx_guard]));
+	return result;
+}
+
+//内部功能函数实现
+
+//转换硬件使用的 32 位地址
+static uint32_t EthDma_Address(const void *pointer)
+{
+	return (uint32_t)(uintptr_t)pointer;
+}
+
+//推进环索引并处理回绕
+static unsigned EthDma_NextIndex(unsigned index)
+{
+	return (index + 1U) % ETH_RING_SIZE;
+}
+
+//检查调用者内存是否与 DMA 对象重叠
+static int EthDma_MemoryOverlaps(
+	const EthDmaRing_t *ring,
+	const void *pointer,
+	size_t length
+)
+{
+	uintptr_t caller_address = (uintptr_t)pointer;
+	uintptr_t dma_address = (uintptr_t)ring->memory;
+
+	return caller_address <= dma_address ? dma_address - caller_address < length
+										 : caller_address - dma_address < sizeof(*ring->memory);
+}
+
+//保证数据、OWN 和尾指针的发布顺序
+static void EthDma_Barrier(EthDmaRing_t *ring)
+{
+	ring->ops.barrier(ring->ops.context);
+}
+
+//重备接收地址并把描述符发布给 DMA
+static void EthDma_PostRx(
+	EthDmaRing_t *ring,
+	unsigned index
+)
+{
+	EthDmaDescriptor_t *descriptor = &ring->memory->rx[index];
+
+	descriptor->w[0] = EthDma_Address(ring->memory->rx_buffer[index]);
+	descriptor->w[1] = 0U;
+	descriptor->w[2] = 0U;
+	EthDma_Barrier(ring);
+	descriptor->w[3] = ETH_RX_POST;
+	EthDma_Barrier(ring);
+}
diff --git a/main-after/Platform/Ethernet/eth_dma.h b/main-after/Platform/Ethernet/eth_dma.h
new file mode 100644
index 0000000..3079def
--- /dev/null
+++ b/main-after/Platform/Ethernet/eth_dma.h
@@ -0,0 +1,111 @@
+//描述符环和内部缓冲区管理
+#ifndef ETH_DMA_H
+#define ETH_DMA_H
+
+#include "eth_types.h"
+#include <stddef.h>
+#define ETH_RING_SIZE 4U
+#define ETH_RING_CAPACITY (ETH_RING_SIZE - 1U) //保留一个尾指针 guard
+#define ETH_BUFFER_SIZE 1536U
+#define ETH_FRAME_MAX 1522U
+#define ETH_DESC_OWN UINT32_C(0x80000000)
+#define ETH_DESC_FD UINT32_C(0x20000000)
+#define ETH_DESC_LD UINT32_C(0x10000000)
+#define ETH_DESC_ES UINT32_C(0x00008000)
+#define ETH_RX_POST UINT32_C(0xC1000000) //DMA 所有权、完成中断和缓冲区有效位
+//硬件字段与跳过字段各 16 字节，DSL=4，描述符步长 32 字节
+typedef struct
+{
+	//硬件读写的四个描述符字
+	volatile uint32_t w[4];
+	//匹配 DSL 配置的跳过区域
+	uint32_t skip[4];
+} EthDmaDescriptor_t;
+typedef struct
+{
+	//物理发送描述符数组
+	EthDmaDescriptor_t tx[ETH_RING_SIZE];
+	//物理接收描述符数组
+	EthDmaDescriptor_t rx[ETH_RING_SIZE];
+	//描述符对应的内部发送副本
+	uint8_t tx_buffer[ETH_RING_SIZE][ETH_BUFFER_SIZE];
+	//描述符对应的内部接收空间
+	uint8_t rx_buffer[ETH_RING_SIZE][ETH_BUFFER_SIZE];
+} EthDmaMemory_t;
+
+typedef struct
+{
+	//回调上下文，由调用者管理
+	void *context;
+	void (*barrier)(void *context);
+	void (*tx_kick)(void *context, uint32_t tail);
+	void (*rx_kick)(void *context, uint32_t tail);
+} EthDmaOps_t;
+typedef struct
+{
+	//专用 DMA 内存池
+	EthDmaMemory_t *memory;
+	//硬件屏障及尾指针适配
+	EthDmaOps_t ops;
+	//下一次提交位置
+	unsigned tx_head;
+	//下一次回收位置
+	unsigned tx_tail;
+	//尚未回收的发送槽数
+	unsigned tx_count;
+	//下一次消费位置
+	unsigned rx_head;
+	//限制 DMA 处理范围的保留槽
+	unsigned rx_guard;
+	//软件占用标志，清 OWN 后仍须回收
+	uint8_t pending[ETH_RING_SIZE];
+	//跨描述符错误帧丢弃状态
+	uint8_t dropping;
+	//发送 ticket 序号
+	uint32_t sequence;
+	//每个待回收槽的完成标识
+	uint32_t ticket[ETH_RING_SIZE];
+	//软件环计数
+	EthRingStatistics_t statistics;
+} EthDmaRing_t;
+
+//仅在硬件停止并确认复位后重建；内存须 32 字节对齐、DMA 可达且非缓存
+//调用者串行使用，ISR 不操作软件环
+EthResult_t eth_ring_reset(
+	EthDmaRing_t *ring,
+	EthDmaMemory_t *memory,
+	const EthDmaOps_t *ops
+);
+
+//同步复制输入，调用者保留原始数据；成功取得完成 ticket
+//内部副本直到完成回收或硬件复位后才能复用
+EthResult_t eth_ring_tx(
+	EthDmaRing_t *ring,
+	const void *data,
+	size_t length,
+	uint32_t *ticket
+);
+
+//每次按序回收一个完成；空环或头部仍归 DMA 所有时返回 EMPTY
+//ticket 仅在 OK 或 FRAME_ERROR 时有效
+EthResult_t eth_ring_reclaim(
+	EthDmaRing_t *ring,
+	uint32_t *ticket
+);
+
+//接收数据复制给调用者，不交出 DMA 指针
+//容量不足时保留帧并报告长度；错误帧消费后归还容量
+EthResult_t eth_ring_rx(
+	EthDmaRing_t *ring,
+	void *data,
+	size_t capacity,
+	size_t *length
+);
+
+//保留已有类型名，避免破坏现有 PHY 和收发调用接口
+typedef EthDmaDescriptor_t eth_descriptor;
+typedef EthDmaMemory_t eth_dma_memory;
+typedef EthDmaOps_t eth_dma_ops;
+typedef EthDmaRing_t eth_ring;
+
+#endif
