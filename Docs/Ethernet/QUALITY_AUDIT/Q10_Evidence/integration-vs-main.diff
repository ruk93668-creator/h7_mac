+}
+
+EthResult_t eth_mac_service(void)
+{
+	if (!s_link)
+	{
+		s_state = ETH_MAC_READY;
+		s_inflight = 0U;
+		return ETH_LINK_DOWN;
+	}
+	return ETH_OK;
+}
+
+EthResult_t eth_mac_tx_submit(const void *data, size_t length, uint32_t *ticket)
+{
+	if (s_tx_result != ETH_OK)
+		return s_tx_result;
+	if (s_inflight == 3U)
+		return ETH_BUSY;
+	assert(s_state == ETH_MAC_RUNNING && length <= sizeof(s_out));
+	assert(((uintptr_t)data & 31U) == 0U);
+	memcpy(s_out, data, length);
+#if LWIP_DHCP
+	ObserveDhcp(s_out, length);
+#endif
+	s_out_length = length;
+	++s_inflight;
+	*ticket = ++s_tx_count;
+	return ETH_OK;
+}
+
+EthResult_t eth_mac_tx_reclaim(uint32_t *ticket)
+{
+	EthResult_t result = s_reclaim_result;
+
+	if (s_inflight == 0U)
+		return ETH_EMPTY;
+	--s_inflight;
+	*ticket = s_tx_count - s_inflight;
+	s_reclaim_result = ETH_OK;
+	return result;
+}
+
+EthResult_t eth_mac_rx_poll(void *data, size_t capacity, size_t *length)
+{
+	EthResult_t result = s_rx_result;
+
+	assert(s_state == ETH_MAC_RUNNING);
+	assert(((uintptr_t)data & 31U) == 0U);
+	if (result != ETH_OK)
+	{
+		s_rx_result = ETH_OK;
+		return result;
+	}
+	if (s_pending_rx == 0U)
+		return ETH_EMPTY;
+	if (capacity < s_in_length)
+		return ETH_CAPACITY;
+	--s_pending_rx;
+	memcpy(data, s_in, s_in_length);
+	*length = s_in_length;
+	return ETH_OK;
+}
+
+static void Put16(uint8_t *data, uint16_t value)
+{
+	data[0] = (uint8_t)(value >> 8);
+	data[1] = (uint8_t)value;
+}
+
+static uint16_t Checksum(const uint8_t *data, size_t length)
+{
+	uint32_t sum = 0U;
+	size_t i;
+
+	for (i = 0U; i < length; i += 2U)
+	{
+		sum += (uint32_t)data[i] << 8;
+		if (i + 1U < length)
+			sum += data[i + 1U];
+	}
+	while (sum >> 16)
+		sum = (sum & 0xFFFFU) + (sum >> 16);
+	return (uint16_t)~sum;
+}
+
+static void BuildArp(void)
+{
+	memset(s_in, 0, sizeof(s_in));
+	memset(s_in, 0xFF, 6U);
+	memcpy(s_in + 6U, s_peer, 6U);
+	Put16(s_in + 12U, 0x0806U);
+	Put16(s_in + 14U, 1U);
+	Put16(s_in + 16U, 0x0800U);
+	s_in[18] = 6U;
+	s_in[19] = 4U;
+	Put16(s_in + 20U, 1U);
+	memcpy(s_in + 22U, s_peer, 6U);
+	memcpy(s_in + 28U, s_peer_ip, 4U);
+	memcpy(s_in + 38U, s_board_ip, 4U);
+	s_in_length = 60U;
+}
+
+static void BuildEcho(size_t frame_size)
+{
+	size_t i;
+
+	memset(s_in, 0, sizeof(s_in));
+	memcpy(s_in, s_mac, 6U);
+	memcpy(s_in + 6U, s_peer, 6U);
+	Put16(s_in + 12U, 0x0800U);
+	s_in[14] = 0x45U;
+	Put16(s_in + 16U, (uint16_t)(frame_size - 14U));
+	s_in[22] = 64U;
+	s_in[23] = 1U;
+	memcpy(s_in + 26U, s_peer_ip, 4U);
+	memcpy(s_in + 30U, s_board_ip, 4U);
+	Put16(s_in + 24U, Checksum(s_in + 14U, 20U));
+	s_in[34] = 8U;
+	Put16(s_in + 38U, 0x1234U);
+	Put16(s_in + 40U, 7U);
+	for (i = 42U; i < frame_size; ++i)
+		s_in[i] = (uint8_t)i;
+	Put16(s_in + 36U, Checksum(s_in + 34U, frame_size - 34U));
+	s_in_length = frame_size;
+}
+
+static void CheckEcho(size_t frame_size)
+{
+	BuildEcho(frame_size);
+	s_pending_rx = 1U;
+	eth_network_poll(&s_network);
+	assert(s_out_length == frame_size && s_out[34] == 0U);
+	assert(memcmp(s_out, s_peer, 6U) == 0 && memcmp(s_out + 6U, s_mac, 6U) == 0);
+	assert(memcmp(s_out + 26U, s_board_ip, 4U) == 0);
+	assert(memcmp(s_out + 30U, s_peer_ip, 4U) == 0);
+	assert(memcmp(s_out + 38U, s_in + 38U, frame_size - 38U) == 0);
+	assert(Checksum(s_out + 14U, 20U) == 0U);
+	assert(Checksum(s_out + 34U, frame_size - 34U) == 0U);
+}
+
+static err_t RejectRx(struct pbuf *packet, struct netif *netif)
+{
+	(void)netif;
+	assert(packet->next != NULL && packet->tot_len == 1514U);
+	return ERR_IF;
+}
+
+static void Timer(void *context)
+{
+	assert(context == &s_network);
+	++s_timer_calls;
+}
+
+#if LWIP_DHCP
+static const uint8_t s_mask[4] = {255, 255, 255, 0};
+static const uint8_t s_broadcast[4] = {255, 255, 255, 255};
+static const uint8_t s_zero[4] = {0};
+
+static void Advance(uint32_t milliseconds)
+{
+	while (milliseconds != 0U)
+	{
+		uint32_t step = milliseconds > 100U ? 100U : milliseconds;
+		s_tick += step;
+		milliseconds -= step;
+		eth_network_poll(&s_network);
+	}
+}
+
+static void Option(uint8_t **p, uint8_t code, const uint8_t *data, uint8_t length)
+{
+	*(*p)++ = code;
+	*(*p)++ = length;
+	memcpy(*p, data, length);
+	*p += length;
+}
+
+static void Reply(uint8_t type)
+{
+	static const uint8_t lease[] = {0, 0, 1, 104}; //360秒
+	static const uint8_t t1[] = {0, 0, 0, 120};
+	static const uint8_t t2[] = {0, 0, 0, 240};
+	uint8_t *msg = s_in + 42U;
+	uint8_t *opt = msg + 240U;
+
+	memset(s_in, 0, sizeof(s_in));
+	memset(s_in, 0xFF, 6U);
+	memcpy(s_in + 6U, s_peer, 6U);
+	Put16(s_in + 12U, 0x0800U);
+	s_in[14] = 0x45U;
+	s_in[22] = 64U;
+	s_in[23] = 17U;
+	memcpy(s_in + 26U, s_peer_ip, 4U);
+	memcpy(s_in + 30U, s_broadcast, 4U);
+	Put16(s_in + 34U, 67U);
+	Put16(s_in + 36U, 68U);
+	msg[0] = 2U;
+	msg[1] = 1U;
+	msg[2] = 6U;
+	memcpy(msg + 4U, s_xid, 4U);
+	if (type != DHCP_NAK)
+		memcpy(msg + 16U, s_board_ip, 4U);
+	memcpy(msg + 28U, s_mac, 6U);
+	memcpy(msg + 236U, "\x63\x82\x53\x63", 4U);
+	Option(&opt, DHCP_OPTION_MESSAGE_TYPE, &type, 1U);
+	Option(&opt, DHCP_OPTION_SERVER_ID, s_peer_ip, 4U);
+	if (type != DHCP_NAK)
+	{
+		Option(&opt, DHCP_OPTION_LEASE_TIME, lease, 4U);
+		Option(&opt, DHCP_OPTION_T1, t1, 4U);
+		Option(&opt, DHCP_OPTION_T2, t2, 4U);
+		Option(&opt, DHCP_OPTION_SUBNET_MASK, s_mask, 4U);
+		Option(&opt, DHCP_OPTION_ROUTER, s_peer_ip, 4U);
+	}
+	*opt++ = DHCP_OPTION_END;
+	s_in_length = (size_t)(opt - s_in);
+	Put16(s_in + 16U, (uint16_t)(s_in_length - 14U));
+	Put16(s_in + 38U, (uint16_t)(s_in_length - 34U));
+	Put16(s_in + 24U, Checksum(s_in + 14U, 20U));
+	s_pending_rx = 1U;
+	eth_network_poll(&s_network);
+}
+
+static void Bind(void)
+{
+	unsigned requests = s_dhcp_packets[DHCP_REQUEST];
+	Reply(DHCP_OFFER);
+	assert(s_dhcp_packets[DHCP_REQUEST] == requests + 1U);
+	assert(s_network.address.state == ETH_DHCP_REQUESTING);
+	assert(memcmp(s_request_offer, s_board_ip, 4U) == 0);
+	assert(memcmp(s_request_dest, s_broadcast, 4U) == 0);
+	assert(memcmp(s_request_ciaddr, s_zero, 4U) == 0);
+	assert(!s_network.address.lease_valid && ip4_addr_isany(&s_network.address.ip));
+	Reply(DHCP_ACK);
+	Advance(10000U); //让上游 ACD 完成对候选地址的探测
+	assert(s_network.address.state == ETH_DHCP_BOUND && s_network.address.lease_valid);
+	assert(memcmp(&s_network.address.ip.addr, s_board_ip, 4U) == 0);
+	assert(memcmp(&s_network.address.mask.addr, s_mask, 4U) == 0);
+	assert(memcmp(&s_network.address.gateway.addr, s_peer_ip, 4U) == 0);
+	assert(memcmp(&s_network.address.server.addr, s_peer_ip, 4U) == 0);
+	assert(s_network.address.lease_seconds == 360U &&
+		s_network.address.t1_seconds == 120U && s_network.address.t2_seconds == 240U);
+	assert(lwip_stats.memp[MEMP_UDP_PCB]->used == 1U);
+	BuildArp(); //使单播 T1 请求有已知服务器 MAC
+	s_pending_rx = 1U;
+	eth_network_poll(&s_network);
+}
+
+static void TestDhcp(const char *scenario)
+{
+	EthNetworkAddressConfig_t config = {0};
+	EthNetworkAddressStatus_t *status = &s_network.address;
+	struct udp_pcb *busy = NULL;
+	unsigned releases;
+	unsigned i;
+	void *reserved[2];
+	const int fallback = strcmp(scenario, "fallback") == 0;
+	const int resource = strcmp(scenario, "resources") == 0;
+
+	config.mode = fallback ? ETH_ADDRESS_DHCP_FALLBACK : ETH_ADDRESS_DHCP;
+	config.timeout_ms = strcmp(scenario, "lease") == 0 ? 30000U : (fallback ? 12000U : 3500U);
+	if (fallback)
+	{
+		assert(eth_network_init_address(&s_network, s_mac, &config) == ERR_ARG);
+		IP4_ADDR(&config.ip, 192, 168, 50, 2);
+		IP4_ADDR(&config.mask, 255, 255, 255, 0);
+	}
+	assert(eth_network_init_address(&s_network, s_mac, &config) == ERR_OK);
+	eth_network_poll(&s_network);
+	assert(status->state == ETH_DHCP_WAIT_LINK && status->starts == 0U);
+	if (resource)
+	{
+		busy = udp_new();
+		assert(busy && lwip_stats.memp[MEMP_UDP_PCB]->used == 1U);
+		for (i = 0U; i < 2U; ++i)
+		{
+			reserved[i] = memp_malloc(MEMP_SYS_TIMEOUT);
+			assert(reserved[i]);
+		}
+		assert(memp_malloc(MEMP_SYS_TIMEOUT) == NULL);
+		assert(lwip_stats.memp[MEMP_SYS_TIMEOUT]->err == 1U);
+		for (i = 0U; i < 2U; ++i)
+			memp_free(MEMP_SYS_TIMEOUT, reserved[i]);
+		sys_timeout(100U, Timer, &s_network);
+	}
+	s_link = 1U;
+	Advance(100U);
+	if (resource)
+	{
+		assert(status->state == ETH_DHCP_ERROR && status->start_result == ERR_MEM);
+		assert(s_timer_calls == 1U && status->starts == 1U);
+		udp_remove(busy);
+		Advance(900U);
+		assert(status->starts == 1U);
+		Advance(100U);
+		assert(status->starts == 2U && status->start_result == ERR_OK);
+		s_link = 0U;
+		Advance(100U);
+		assert(lwip_stats.memp[MEMP_UDP_PCB]->used == 0U);
+		assert(lwip_stats.mem.used == 0U && lwip_stats.memp[MEMP_PBUF_POOL]->used == 0U);
+		puts("PASS: exhausted UDP PCB and timeout pool, retry pacing and resource recovery");
+		return;
+	}
+	assert(status->state == ETH_DHCP_SELECTING && status->starts == 1U &&
+		s_dhcp_packets[DHCP_DISCOVER] == 1U && ip4_addr_isany(&status->ip));
+	if (strcmp(scenario, "lease") != 0)
+	{
+		Advance(config.timeout_ms);
+		assert(status->timeouts == 1U && status->starts == 1U);
+		if (fallback)
+		{
+			assert(status->state == ETH_DHCP_FALLBACK && status->fallbacks == 1U);
+			assert(ip4_addr_cmp(&status->ip, &config.ip) && !status->lease_valid);
+			assert(netif_dhcp_data(&s_network.interface) == NULL);
+			assert(lwip_stats.memp[MEMP_UDP_PCB]->used == 0U && lwip_stats.mem.used == 0U);
+			Reply(DHCP_ACK);
+			assert(ip4_addr_cmp(&status->ip, &config.ip) && !status->lease_valid);
+			s_link = 0U;
+			Advance(100U);
+			assert(ip4_addr_isany(&status->ip) && status->state == ETH_DHCP_WAIT_LINK);
+			s_link = 1U;
+			Advance(100U);
+			assert(status->state == ETH_DHCP_SELECTING && status->starts == 2U);
+			Bind();
+			assert(status->fallbacks == 1U);
+		}
+		else
+		{
+			Advance(15000U);
+			assert(status->state == ETH_DHCP_SELECTING && status->timeouts == 1U &&
+				status->fallbacks == 0U && ip4_addr_isany(&status->ip));
+			assert(s_dhcp_packets[DHCP_DISCOVER] > 1U);
+		}
+		assert(lwip_stats.memp[MEMP_PBUF_POOL]->used == 0U);
+		puts("PASS: no server, single timeout per acquisition, configured fallback/relink policy");
+		return;
+	}
+	Reply(DHCP_OFFER);
+	assert(status->state == ETH_DHCP_REQUESTING);
+	Reply(DHCP_NAK);
+	assert(status->state == ETH_DHCP_SELECTING && s_dhcp_packets[DHCP_DISCOVER] == 2U);
+	Bind();
+	Advance(120000U);
+	assert(status->state == ETH_DHCP_RENEWING && status->lease_valid);
+	assert(memcmp(s_request_dest, s_peer_ip, 4U) == 0);
+	assert(memcmp(s_request_ciaddr, s_board_ip, 4U) == 0);
+	Reply(DHCP_ACK);
+	assert(status->state == ETH_DHCP_BOUND && status->lease_valid);
+	Advance(120000U);
+	assert(status->state == ETH_DHCP_RENEWING);
+	Advance(120000U);
+	assert(status->state == ETH_DHCP_REBINDING && status->lease_valid);
+	assert(memcmp(s_request_dest, s_broadcast, 4U) == 0);
+	Reply(DHCP_ACK);
+	assert(status->state == ETH_DHCP_BOUND && status->lease_valid);
+	Advance(360000U);
+	assert(!status->lease_valid && ip4_addr_isany(&status->ip) &&
+		status->state == ETH_DHCP_SELECTING && status->starts == 1U);
+	Bind();
+	releases = s_dhcp_packets[DHCP_RELEASE];
+	s_link = 0U;
+	Advance(100U);
+	assert(status->state == ETH_DHCP_WAIT_LINK && !status->lease_valid &&
+		ip4_addr_isany(&status->ip) && ip4_addr_isany(&status->gateway));
+	assert(netif_is_up(&s_network.interface) && !netif_is_link_up(&s_network.interface));
+	assert(s_dhcp_packets[DHCP_RELEASE] == releases);
+	assert(lwip_stats.memp[MEMP_UDP_PCB]->used == 0U && lwip_stats.mem.used == 0U);
+	s_link = 1U;
+	Advance(100U);
+	assert(status->starts == 2U && status->state == ETH_DHCP_SELECTING);
+	Bind();
+	assert(status->starts == 2U && s_network.link_ups == 2U && s_network.link_downs == 1U);
+	assert(lwip_stats.memp[MEMP_PBUF_POOL]->used == 0U &&
+		lwip_stats.memp[MEMP_SYS_TIMEOUT]->err == 0U);
+	puts("PASS: actual DORA/NAK, ACD, T1 unicast/ACK, T2 broadcast/ACK, expiry, no offline RELEASE, new lease after link");
+}
+#endif
+
+int main(int argc, char **argv)
+{
+	ip4_addr_t ip;
+	ip4_addr_t mask;
+	ip4_addr_t gateway;
+	struct netif *interface = &s_network.interface;
+	EthNetifStatistics_t *stats = &s_network.port.statistics;
+	struct pbuf *packet;
+	struct pbuf *held[PBUF_POOL_SIZE];
+	netif_input_fn input;
+	unsigned i;
+	unsigned count;
+	uint32_t rx_rejected;
+	uint32_t tx_errors;
+	uint32_t completed;
+
+	(void)setvbuf(stdout, NULL, _IONBF, 0);
+#if LWIP_DHCP
+	if (argc > 1 && strcmp(argv[1], "static") != 0)
+	{
+		TestDhcp(argv[1]);
+		return 0;
+	}
+#else
+	(void)argc;
+	(void)argv;
+#endif
+
+	IP4_ADDR(&ip, 192, 168, 50, 2);
+	IP4_ADDR(&mask, 255, 255, 255, 0);
+	IP4_ADDR(&gateway, 0, 0, 0, 0);
+	assert(eth_network_init(&s_network, s_mac, &ip, &mask, &gateway) == ERR_OK);
+	assert(netif_is_up(interface) && !netif_is_link_up(interface));
+	assert(interface->mtu == 1500U && interface->hwaddr_len == 6U &&
+		memcmp(interface->hwaddr, s_mac, 6U) == 0);
+	eth_network_poll(&s_network);
+	assert(s_starts == 0U && s_network.last_driver_result == ETH_LINK_DOWN);
+	s_link = 1U;
+	s_negotiation = ETH_BUSY;
+	s_tick += 10U;
+	eth_network_poll(&s_network);
+	assert(s_starts == 0U && !netif_is_link_up(interface));
+	s_negotiation = ETH_OK;
+	s_start_result = ETH_IO;
+	s_tick += 10U;
+	eth_network_poll(&s_network);
+	assert(s_starts == 1U && !netif_is_link_up(interface));
+	s_start_result = ETH_OK;
+	s_tick += 10U;
+	eth_network_poll(&s_network);
+	assert(netif_is_link_up(interface) && s_network.link_ups == 1U);
+	sys_timeout(5U, Timer, &s_network);
+	s_tick += 4U;
+	eth_network_poll(&s_network);
+	assert(s_timer_calls == 0U);
+	++s_tick;
+	eth_network_poll(&s_network);
+	assert(s_timer_calls == 1U);
+
+	BuildArp();
+	s_pending_rx = 1U;
+	count = s_tx_count;
+	eth_network_poll(&s_network);
+	assert(s_tx_count == count + 1U && s_out_length == 42U && s_out[21] == 2U);
+	assert(memcmp(s_out, s_peer, 6U) == 0 && memcmp(s_out + 22U, s_mac, 6U) == 0);
+	assert(memcmp(s_out + 28U, s_board_ip, 4U) == 0 &&
+		memcmp(s_out + 38U, s_peer_ip, 4U) == 0);
+	CheckEcho(61U);
+	CheckEcho(1514U);
+	eth_network_poll(&s_network);
+	assert(lwip_stats.memp[MEMP_PBUF_POOL]->used == 0U);
+	puts("PASS: real lwIP static netif, ARP, ICMP (odd and max MTU), NO_SYS timer");
+
+	for (i = 0U; i < sizeof(s_in); ++i)
+		s_in[i] = (uint8_t)i;
+	packet = pbuf_alloc(PBUF_RAW, 1514U, PBUF_POOL);
+	assert(packet && packet->next && pbuf_take(packet, s_in, 1514U) == ERR_OK);
+	for (i = 0U; i < 3U; ++i)
+	{
+		assert(interface->linkoutput(interface, packet) == ERR_OK);
+		assert(memcmp(s_out, s_in, 1514U) == 0 && packet->ref == 1U);
+	}
+	assert(interface->linkoutput(interface, packet) == ERR_MEM && stats->tx_busy == 1U);
+	completed = stats->tx_completed;
+	tx_errors = stats->tx_errors;
+	s_reclaim_result = ETH_FRAME_ERROR;
+	eth_network_poll(&s_network);
+	assert(stats->tx_completed == completed + 2U && stats->tx_errors == tx_errors + 1U);
+	assert(interface->linkoutput(interface, packet) == ERR_OK);
+	s_tx_result = ETH_IO;
+	assert(interface->linkoutput(interface, packet) == ERR_IF && packet->ref == 1U);
+	s_tx_result = ETH_LINK_DOWN;
+	assert(interface->linkoutput(interface, packet) == ERR_RTE && packet->ref == 1U);
+	s_tx_result = ETH_OK;
+	assert(pbuf_free(packet) == 3U);
+	packet = pbuf_alloc(PBUF_RAW, 1515U, PBUF_POOL);
+	assert(packet && interface->linkoutput(interface, packet) == ERR_BUF);
+	pbuf_free(packet);
+	assert(stats->tx_rejected == 1U);
+
+	for (i = 0U; i < PBUF_POOL_SIZE; ++i)
+	{
+		held[i] = pbuf_alloc(PBUF_RAW, 60U, PBUF_POOL);
+		assert(held[i]);
+	}
+	BuildArp();
+	s_pending_rx = 1U;
+	count = s_tx_count;
+	eth_network_poll(&s_network);
+	assert(stats->rx_no_pbuf == 1U && s_tx_count == count);
+	for (i = 0U; i < PBUF_POOL_SIZE; ++i)
+		assert(pbuf_free(held[i]) == 1U);
+	input = interface->input;
+	interface->input = RejectRx;
+	rx_rejected = stats->rx_rejected;
+	BuildEcho(1514U);
+	s_pending_rx = ETH_NETIF_BUDGET + 1U;
+	s_rx_result = ETH_FRAME_ERROR;
+	eth_network_poll(&s_network);
+	assert(s_pending_rx == 2U && stats->rx_errors == 1U);
+	eth_network_poll(&s_network);
+	assert(stats->rx_rejected == rx_rejected + ETH_NETIF_BUDGET + 1U);
+	s_in_length = 1522U;
+	s_pending_rx = 1U;
+	eth_network_poll(&s_network);
+	assert(s_pending_rx == 0U && stats->rx_rejected == rx_rejected + ETH_NETIF_BUDGET + 2U);
+	assert(lwip_stats.memp[MEMP_PBUF_POOL]->used == 0U);
+	interface->input = input;
+	puts("PASS: chained TX, frame boundaries, ring BUSY/reclaim, input rejection, pool exhaustion, RX budget");
+
+	s_link = 0U;
+	s_tick += 10U;
+	eth_network_poll(&s_network);
+	assert(netif_is_up(interface) && !netif_is_link_up(interface) && s_network.link_downs == 1U);
+	packet = pbuf_alloc(PBUF_RAW, 60U, PBUF_POOL);
+	assert(packet && interface->linkoutput(interface, packet) == ERR_RTE && packet->ref == 1U);
+	pbuf_free(packet);
+	s_link = 1U;
+	s_tick += 10U;
+	eth_network_poll(&s_network);
+	assert(netif_is_link_up(interface) && s_network.link_ups == 2U);
+	BuildArp();
+	s_pending_rx = 1U;
+	eth_network_poll(&s_network);
+	CheckEcho(61U);
+	assert(lwip_stats.memp[MEMP_PBUF_POOL]->used == 0U);
+#if LWIP_DHCP
+	assert(s_network.address.state == ETH_DHCP_DISABLED &&
+		s_network.address.starts == 0U && s_dhcp_packets[DHCP_DISCOVER] == 0U &&
+		netif_dhcp_data(interface) == NULL && lwip_stats.memp[MEMP_UDP_PCB]->used == 0U);
+#endif
+	puts("PASS: netif stays administratively up, renegotiation and IPv4 recovery");
+	return 0;
+}
diff --git a/main-after/Tests/Ethernet/test_e5_lease_peer.py b/main-after/Tests/Ethernet/test_e5_lease_peer.py
new file mode 100644
index 0000000..c8f025f
--- /dev/null
+++ b/main-after/Tests/Ethernet/test_e5_lease_peer.py
@@ -0,0 +1,25 @@
+import unittest
+
+from e42_lease_peer import CLIENT, SERVER, LEASE, T1, T2, decode, options
+from e5_lease_peer import ContinuousLease
+from test_e42_lease_peer import request
+
+
+class TestContinuousLease(unittest.TestCase):
+    def test_repeated_renewals_keep_advertised_timers(self):
+        machine = ContinuousLease()
+        xid = b'E5T1'
+        self.assertEqual(machine.handle(decode(request(1, xid)), 0)[0], 'discover')
+        self.assertEqual(machine.handle(decode(request(3, xid, select=True)), 1)[0], 'initial_ack')
+        for elapsed in range(T1, 660, T1):
+            action, response = machine.handle(decode(request(3, xid, CLIENT, SERVER)), elapsed)
+            self.assertEqual(action, 't1_ack')
+            self.assertEqual(response[30:34], CLIENT)
+            fields = options(response[282:])
+            self.assertEqual(fields[53], b'\x05')
+            self.assertEqual([int.from_bytes(fields[key], 'big') for key in (51, 58, 59)], [LEASE, T1, T2])
+        self.assertEqual(machine.phase, 'renew')
+
+
+if __name__ == '__main__':
+    unittest.main()
diff --git a/main-after/Tests/Ethernet/test_e5_network.c b/main-after/Tests/Ethernet/test_e5_network.c
new file mode 100644
index 0000000..1b3ce51
--- /dev/null
+++ b/main-after/Tests/Ethernet/test_e5_network.c
@@ -0,0 +1,367 @@
+#include "eth_host_wire.h"
+
+#include "e5_bench.h"
+#include "e5_protocol.h"
+#include "lwip/mem.h"
+#include "lwip/tcp.h"
+#include "lwip/priv/tcp_priv.h"
+#include "netif/ppp/ppp_opts.h"
+
+static uint8_t s_payload[ETH_TCP_QUEUE_BYTES];
+
+static void Udp(const void *data, uint16_t bytes, int broadcast)
+{
+	uint8_t *p = s_in + 34U;
+	Put16(p, 5002U);
+	Put16(p + 2U, 5001U);
+	Put16(p + 4U, (uint16_t)(8U + bytes));
+	Put16(p + 6U, 0U);
+	memcpy(p + 8U, data, bytes);
+	Inbound(17U, (uint16_t)(8U + bytes), broadcast);
+}
+
+static Peer_t Syn(uint16_t port, uint32_t seq)
+{
+	return WireSyn(5003U, port, seq);
+}
+
+static Peer_t ConnectOutbound(unsigned start_wire)
+{
+	const Wire_t *syn = Last(start_wire, 5004U, SYN, 0);
+	Peer_t p;
+	assert(syn && !(syn->flags & ACK));
+	p.board_port = syn->source;
+	p.pc_port = 5004U;
+	p.pc_seq = 20000U;
+	p.board_ack = syn->seq + 1U;
+	start_wire = s_wire_count;
+	Tcp(&p, SYN | ACK, 4096U, NULL, 0U);
+	assert(Last(start_wire, 5004U, ACK, 0));
+	assert(eth_tcp_get_state(eth_tcp_handle(ETH_TCP_CLIENT)) == ETH_TCP_OPEN);
+	return p;
+}
+
+static void ShortEcho(Peer_t *peer)
+{
+	unsigned mark;
+	uint8_t frames[160];
+	uint16_t a = e5_frame_build(frames, E5_REQUEST, 1U, 32U);
+	uint16_t b = e5_frame_build(frames + a, E5_REQUEST, 2U, 16U);
+	const Wire_t *w;
+	Tcp(peer, PSH | ACK, 4096U, frames, 5U);
+	e5_bench_poll(s_tick, 0U);
+	mark = s_wire_count;
+	Tcp(peer, PSH | ACK, 4096U, frames + 5U, (uint16_t)(a + b - 5U));
+	e5_bench_poll(s_tick, 0U);
+	Pump(60U);
+	w = Last(mark, peer->pc_port, ACK, 1);
+	assert(w && w->length == a + b && w->data[5] == E5_REPLY && w->data[a + 5U] == E5_REPLY);
+	assert(e5_frame_valid(w->data, a) && e5_frame_valid(w->data + a, b));
+	assert(memcmp(w->data + E5_HEADER, frames + E5_HEADER, a - E5_HEADER) == 0);
+	peer->board_ack = w->seq + w->length;
+	Tcp(peer, ACK, 4096U, NULL, 0U);
+}
+
+int main(void)
+{
+	setvbuf(stdout, NULL, _IONBF, 0);
+	EthNetworkAddressConfig_t config = {.mode = ETH_ADDRESS_DHCP};
+	ip4_addr_t ip;
+	ip4_addr_t broadcast;
+	EthTransportStats_t stats;
+	EthTcpHandle_t server_handle;
+	Peer_t passive, active, rejected;
+	const Wire_t *w;
+	void *segments[MEMP_NUM_TCP_SEG];
+	void *heap[64];
+	struct pbuf *held[PBUF_POOL_SIZE];
+	struct tcp_pcb *pcbs[MEMP_NUM_TCP_PCB];
+	void *timers[MEMP_NUM_SYS_TIMEOUT];
+	unsigned n, i, count, mark;
+	uint32_t seq;
+	uint16_t len;
+
+	config.timeout_ms = 30000U;
+	assert(eth_network_init_address(&s_network, s_mac, &config) == ERR_OK);
+	s_link = 1U;
+	Advance(100U);
+	Bind(); //真实 DHCP DORA 和 ACD，确认 DHCP UDP PCB 持有
+	IP4_ADDR(&ip, 192, 168, 50, 1);
+	IP4_ADDR(&broadcast, 255, 255, 255, 255);
+	assert(e5_bench_init(&s_network, &ip, 5004U, 2000U) == ERR_OK);
+	assert(e5_bench_init(&s_network, &ip, 5004U, 2000U) == ERR_USE);
+	mark = s_wire_count;
+	Pump(20U);
+	active = ConnectOutbound(mark);
+	passive = Syn(51000U, 30000U);
+	Tcp(&passive, ACK, 4096U, NULL, 0U);
+	server_handle = eth_tcp_handle(ETH_TCP_SERVER);
+	assert(eth_tcp_get_state(server_handle) == ETH_TCP_OPEN);
+	assert(eth_tcp_client_connect(&s_network.interface, &ip, 5004U) == ERR_ISCONN);
+	rejected = Syn(51001U, 31000U);
+	mark = s_wire_count;
+	Tcp(&rejected, ACK, 4096U, NULL, 0U);
+	assert(Last(mark, 51001U, RST, 0));
+	assert(eth_tcp_get_state(server_handle) == ETH_TCP_OPEN);
+	ShortEcho(&passive);
+	ShortEcho(&active);
+	eth_transport_get_statistics(&stats);
+	assert(stats.connections == 2U && stats.listening && stats.tcp[0].acked &&
+		stats.tcp[1].acked && stats.tcp[0].rejected == 1U);
+	assert(lwip_stats.memp[MEMP_UDP_PCB]->used == 2U && udp_new() == NULL);
+
+	//双连接活动期间，真实 UDP 双向、发送边界与广播。
+	{
+		static const uint16_t lengths[] = {1, 16, 64, 256, 512, 1200, 1472};
+		memset(s_payload, 0x5A, sizeof(s_payload));
+		for (i = 0U; i < sizeof(lengths) / sizeof(lengths[0]); ++i)
+		{
+			mark = s_wire_count;
+			assert(eth_udp_send(&ip, 5002U, s_payload, lengths[i]) == ERR_OK);
+			w = Last(mark, 5002U, 0U, 1);
+			assert(w && w->protocol == 17U && w->length == lengths[i]);
+			assert(memcmp(w->data, s_payload, lengths[i]) == 0);
+			Pump(20U);
+		}
+	}
+	assert(eth_udp_send(&ip, 5002U, s_payload, 1473U) == ERR_ARG);
+	assert(eth_udp_send(&broadcast, 5002U, s_payload, 16U) == ERR_OK);
+	Pump(20U);
+	len = e5_frame_build(s_payload, E5_REQUEST, 1U, E5_LIMIT - E5_HEADER);
+	mark = s_wire_count;
+	Udp(s_payload, len, 0);
+	w = Last(mark, 5002U, 0U, 1);
+	assert(w && w->length == E5_LIMIT && w->data[5] == E5_REPLY && e5_frame_valid(w->data, w->length));
+	len = e5_frame_build(s_payload, E5_REQUEST, 2U, 64U);
+	mark = s_wire_count;
+	Udp(s_payload, len, 1);
+	assert(Last(mark, 5002U, 0U, 1));
+	puts("PASS: DHCP + 2 TCP roles + UDP; SYN/SYN-ACK/ACK, second accept rejected, fragmented/coalesced echo, MTU/UDP broadcast");
+
+	//接收大帧跨 pbuf，应用暂不读则窗口归零；读后重新通告窗口。
+	memset(s_payload, 0xA7, sizeof(s_payload));
+	Tcp(&passive, PSH | ACK, 4096U, s_payload, 1460U);
+	Tcp(&passive, PSH | ACK, 4096U, s_payload + 1460U, 1460U);
+	Pump(300U);
+	eth_transport_get_statistics(&stats);
+	assert(stats.tcp[0].rx_pending == ETH_TCP_QUEUE_BYTES && stats.tcp[0].rx_peak == ETH_TCP_QUEUE_BYTES);
+	w = Last(s_wire_count > 8U ? s_wire_count - 8U : 0U, passive.pc_port, ACK, 0);
+	assert(w && w->window == 0U);
+	memset(s_payload, 0, sizeof(s_payload));
+	assert(eth_tcp_read(server_handle, s_payload, sizeof(s_payload)) == sizeof(s_payload));
+	for (i = 0; i < sizeof(s_payload); ++i)
+		assert(s_payload[i] == 0xA7);
+	Pump(300U);
+	w = Last(s_wire_count > 8U ? s_wire_count - 8U : 0U, passive.pc_port, ACK, 0);
+	assert(w && w->window != 0U);
+
+	//耗尽真实 TCP_SEG 池；APP 环保持不变，释放后只提交一次。
+	for (n = 0U; n < MEMP_NUM_TCP_SEG; ++n)
+	{
+		segments[n] = memp_malloc(MEMP_TCP_SEG);
+		if (!segments[n])
+			break;
+	}
+	assert(n && memp_malloc(MEMP_TCP_SEG) == NULL);
+	assert(eth_tcp_send(server_handle, s_payload, sizeof(s_payload)) == ERR_OK);
+	assert(eth_tcp_send(server_handle, s_payload, 1U) == ERR_MEM);
+	Pump(100U);
+	eth_transport_get_statistics(&stats);
+	assert(stats.tcp[0].write_mem && stats.tcp[0].tx_pending == sizeof(s_payload));
+	for (i = 0U; i < n; ++i)
+		memp_free(MEMP_TCP_SEG, segments[i]);
+	mark = s_wire_count;
+	Pump(100U);
+	w = Last(mark, passive.pc_port, ACK, 1);
+	assert(w);
+	seq = w->seq;
+	count = w->length;
+	//不给 ACK，先观察相同序号重传；计数仍未完成。
+	mark = s_wire_count;
+	Pump(5000U);
+	w = Last(mark, passive.pc_port, ACK, 1);
+	assert(w && w->seq <= seq && w->length);
+	eth_transport_get_statistics(&stats);
+	assert(stats.tcp[0].unacked == sizeof(s_payload));
+	passive.board_ack = seq + count;
+	Tcp(&passive, ACK, 4096U, NULL, 0U);
+	//累积 ACK 可能尚未覆盖两段，确认到发送尾后才完成应用 ACK。
+	eth_transport_get_statistics(&stats);
+	passive.board_ack += stats.tcp[0].unacked;
+	Tcp(&passive, ACK, 4096U, NULL, 0U);
+	eth_transport_get_statistics(&stats);
+	assert(stats.tcp[0].unacked == 0U && stats.tcp[0].submitted == stats.tcp[0].acked);
+	for (n = 0; n < 64U; ++n)
+	{
+		heap[n] = mem_malloc(256U);
+		if (!heap[n])
+			break;
+	}
+	assert(n < 64U && eth_udp_send(&ip, 5002U, s_payload, 1472U) == ERR_MEM);
+	for (i = 0; i < n; ++i)
+		mem_free(heap[i]);
+	assert(eth_udp_send(&ip, 5002U, s_payload, 16U) == ERR_OK);
+	Pump(20U);
+	puts("PASS: chained RX/window zero and reopen, app queue full, actual TCP segment/heap exhaustion, delayed ACK and retransmission recovery");
+
+	//对端仍连接但通告零窗口，模拟暂不读取；有界排队直到窗口重新开放。
+	Tcp(&passive, ACK, 4096U, s_payload, 1U);
+	Tcp(&passive, ACK, 0U, NULL, 0U); //不同的 SEG.SEQ 让缩窗公告生效
+	assert(eth_tcp_read(server_handle, s_payload, 1U) == 1U);
+	mark = s_wire_count;
+	assert(eth_tcp_send(server_handle, s_payload, sizeof(s_payload)) == ERR_OK);
+	Pump(100U);
+	assert(!Last(mark, passive.pc_port, ACK, 1));
+	assert(eth_tcp_send(server_handle, s_payload, sizeof(s_payload)) == ERR_OK);
+	assert(eth_tcp_send(server_handle, s_payload, 1U) == ERR_MEM);
+	eth_transport_get_statistics(&stats);
+	assert(stats.tcp[0].unacked == sizeof(s_payload) && stats.tcp[0].tx_pending == sizeof(s_payload));
+	seq = passive.board_ack;
+	for (i = 0; i < 8U && passive.board_ack - seq < 2U * sizeof(s_payload); ++i)
+	{
+		mark = s_wire_count;
+		Tcp(&passive, ACK, 4096U, NULL, 0U);
+		Pump(100U);
+		w = Last(mark, passive.pc_port, ACK, 1);
+		if (!w || w->seq + w->length <= passive.board_ack ||
+			w->seq + w->length - seq > 2U * sizeof(s_payload))
+			fprintf(stderr, "window recovery: iteration=%u wire=%u frame=%u ack=%u end=%u snd_wnd=%u cwnd=%u\n",
+				i, s_wire_count - mark, w != NULL, passive.board_ack, w ? w->seq + w->length : 0U,
+				(unsigned)tcp_active_pcbs->snd_wnd, (unsigned)tcp_active_pcbs->cwnd);
+		assert(w && w->seq + w->length > passive.board_ack &&
+			w->seq + w->length - seq <= 2U * sizeof(s_payload));
+		passive.board_ack = w->seq + w->length;
+	}
+	assert(passive.board_ack - seq == 2U * sizeof(s_payload));
+	Tcp(&passive, ACK, 4096U, NULL, 0U);
+	eth_transport_get_statistics(&stats);
+	assert(!stats.tcp[0].unacked && !stats.tcp[0].tx_pending && stats.tcp[0].acked == stats.tcp[0].submitted);
+	for (i = 0; i < PBUF_POOL_SIZE; ++i)
+	{
+		held[i] = pbuf_alloc(PBUF_RAW, 1U, PBUF_POOL);
+		assert(held[i]);
+	}
+	assert(pbuf_alloc(PBUF_RAW, 1U, PBUF_POOL) == NULL);
+	len = e5_frame_build(s_payload, E5_REQUEST, 3U, 16U);
+	n = s_network.port.statistics.rx_no_pbuf;
+	Udp(s_payload, len, 0);
+	assert(s_network.port.statistics.rx_no_pbuf == n + 1U);
+	for (i = 0; i < PBUF_POOL_SIZE; ++i)
+		pbuf_free(held[i]);
+	mark = s_wire_count;
+	Udp(s_payload, len, 0);
+	assert(Last(mark, 5002U, 0U, 1));
+	puts("PASS: peer zero-window backpressure and recovery; PBUF_POOL exhaustion/drop/recovery");
+
+	//正常对端 FIN 后由本端发送 FIN；另一角色 RST 清掉无效 PCB。
+	mark = s_wire_count;
+	Tcp(&passive, FIN | ACK, 4096U, NULL, 0U);
+	Pump(100U);
+	w = Last(mark, passive.pc_port, FIN, 0);
+	assert(w && eth_tcp_get_state(server_handle) == ETH_TCP_IDLE);
+	passive.board_ack = w->seq + 1U;
+	Tcp(&passive, ACK, 4096U, NULL, 0U);
+	Tcp(&active, RST | ACK, 4096U, NULL, 0U);
+	assert(eth_tcp_get_state(eth_tcp_handle(ETH_TCP_CLIENT)) == ETH_TCP_IDLE);
+	passive = Syn(51002U, 32000U);
+	Tcp(&passive, ACK, 4096U, NULL, 0U);
+	assert(eth_tcp_send(server_handle, s_payload, 1U) == ERR_CONN);
+	server_handle = eth_tcp_handle(ETH_TCP_SERVER);
+	assert(eth_tcp_get_state(server_handle) == ETH_TCP_OPEN);
+	//lwIP 2.2.1 的 FIN 分配失败内部设 CLOSEPEND，并返回 OK 移交所有权。
+	for (n = 0U; n < MEMP_NUM_TCP_SEG; ++n)
+	{
+		segments[n] = memp_malloc(MEMP_TCP_SEG);
+		if (!segments[n])
+			break;
+	}
+	assert(eth_tcp_close(server_handle) == ERR_OK);
+	assert(eth_tcp_close(server_handle) == ERR_ALREADY);
+	mark = s_wire_count;
+	Pump(100U);
+	assert(!Last(mark, passive.pc_port, FIN, 0) && eth_tcp_get_state(server_handle) == ETH_TCP_IDLE);
+	assert(tcp_active_pcbs && (tcp_active_pcbs->flags & TF_CLOSEPEND));
+	for (i = 0U; i < n; ++i)
+		memp_free(MEMP_TCP_SEG, segments[i]);
+	Pump(400U);
+	w = Last(mark, passive.pc_port, FIN, 0);
+	assert(w);
+	passive.board_ack = w->seq + 1U;
+	Tcp(&passive, FIN | ACK, 4096U, NULL, 0U);
+	assert(tcp_tw_pcbs != NULL && tcp_tw_pcbs->state == TIME_WAIT);
+	//超过 PCB 容量的正常连接轮换；允许 lwIP 自行回收老 TIME_WAIT。
+	for (i = 0U; i < MEMP_NUM_TCP_PCB + 2U; ++i)
+	{
+		passive = Syn((uint16_t)(51100U + i), 33000U + 100U * i);
+		Tcp(&passive, ACK, 4096U, NULL, 0U);
+		server_handle = eth_tcp_handle(ETH_TCP_SERVER);
+		assert(eth_tcp_close(server_handle) == ERR_OK);
+		mark = s_wire_count;
+		Pump(60U);
+		w = Last(mark, passive.pc_port, FIN, 0);
+		assert(w);
+		passive.board_ack = w->seq + 1U;
+		Tcp(&passive, FIN | ACK, 4096U, NULL, 0U);
+		assert(lwip_stats.memp[MEMP_TCP_PCB]->used <= MEMP_NUM_TCP_PCB);
+	}
+	mark = s_wire_count;
+	Pump(2100U);
+	w = Last(mark, 5004U, SYN, 0);
+	if (!w)
+	{ //允许上一段已进入 SYN_SENT
+		assert(eth_tcp_get_state(eth_tcp_handle(ETH_TCP_CLIENT)) == ETH_TCP_CONNECTING);
+		w = Last(s_wire_count > 25U ? s_wire_count - 25U : 0U, 5004U, SYN, 0);
+	}
+	assert(w);
+	active.board_port = w->source;
+	active.board_ack = w->seq + 1U;
+	Tcp(&active, RST | ACK, 4096U, NULL, 0U);
+	assert(eth_tcp_get_state(eth_tcp_handle(ETH_TCP_CLIENT)) == ETH_TCP_IDLE);
+	Pump(2100U);
+	Pump(10100U); //无 SYN-ACK，应用连接截止时间到
+	eth_transport_get_statistics(&stats);
+	assert(stats.tcp[ETH_TCP_CLIENT].timeouts >= 1U);
+	s_link = 0U;
+	Pump(100U);
+	eth_transport_get_statistics(&stats);
+	assert(!stats.ready && !stats.listening && !stats.connections && stats.link_lost == 1U);
+	assert(lwip_stats.memp[MEMP_UDP_PCB]->used == 0U && lwip_stats.memp[MEMP_PBUF_POOL]->used == 0U);
+	for (i = 0U; i < MEMP_NUM_TCP_PCB; ++i)
+	{
+		pcbs[i] = tcp_new();
+		assert(pcbs[i]);
+	}
+	assert(tcp_new() == NULL);
+	for (i = 0U; i < MEMP_NUM_TCP_PCB; ++i)
+		tcp_abort(pcbs[i]);
+	assert(lwip_stats.memp[MEMP_TCP_PCB]->used == 0U);
+	//实际回收 TIME_WAIT 后，检查定时器池耗尽和恢复，不把断言接口当探测。
+	for (n = 0U; n < MEMP_NUM_SYS_TIMEOUT; ++n)
+	{
+		timers[n] = memp_malloc(MEMP_SYS_TIMEOUT);
+		if (!timers[n])
+			break;
+	}
+	assert(n >= 2U && n < MEMP_NUM_SYS_TIMEOUT);
+	assert(memp_malloc(MEMP_SYS_TIMEOUT) == NULL);
+	for (i = 0U; i < n; ++i)
+		memp_free(MEMP_SYS_TIMEOUT, timers[i]);
+	sys_timeout(100U, Timer, &s_network);
+	Pump(100U);
+	assert(s_timer_calls == 1U);
+	s_link = 1U;
+	Pump(100U);
+	Bind();
+	Pump(20U);
+	eth_transport_get_statistics(&stats);
+	assert(stats.ready && stats.listening && stats.link_ready == 2U &&
+		lwip_stats.memp[MEMP_UDP_PCB]->used == 2U);
+	assert(lwip_stats.memp[MEMP_SYS_TIMEOUT]->err == 2U);
+	puts("PASS: peer FIN/RST, CLOSEPEND retry, TIME_WAIT churn, PCB/timer exhaustion, connect refusal/timeout, DHCP relink");
+	printf("Host injection peaks: heap=%u bytes; timeout=%u; TCP PCB=%u; TCP listen=%u; TCP segment=%u; UDP PCB=%u; PBUF_POOL=%u\n",
+		(unsigned)lwip_stats.mem.max, (unsigned)lwip_stats.memp[MEMP_SYS_TIMEOUT]->max,
+		(unsigned)lwip_stats.memp[MEMP_TCP_PCB]->max, (unsigned)lwip_stats.memp[MEMP_TCP_PCB_LISTEN]->max,
+		(unsigned)lwip_stats.memp[MEMP_TCP_SEG]->max, (unsigned)lwip_stats.memp[MEMP_UDP_PCB]->max,
+		(unsigned)lwip_stats.memp[MEMP_PBUF_POOL]->max);
+	return 0;
+}
diff --git a/main-after/Tests/Ethernet/test_e5_peer.py b/main-after/Tests/Ethernet/test_e5_peer.py
new file mode 100644
index 0000000..1d9d40d
--- /dev/null
+++ b/main-after/Tests/Ethernet/test_e5_peer.py
@@ -0,0 +1,136 @@
+import asyncio
+import contextlib
+import socket
+from types import SimpleNamespace
+import unittest
+
+import e5_peer as peer
+
+
+class TestProtocol(unittest.IsolatedAsyncioTestCase):
+    async def test_fragmentation_and_coalescence(self):
+        reader = asyncio.StreamReader()
+        a = peer.encode(peer.REQUEST, 1, b'one')
+        b = peer.encode(peer.REPLY, 2, bytes(range(256)) * 5)
+        task = asyncio.create_task(peer.read_frame(reader))
+        reader.feed_data(a[:5])
+        await asyncio.sleep(0)
+        self.assertFalse(task.done())
+        reader.feed_data(a[5:] + b)
+        self.assertEqual(await task, (peer.REQUEST, 1, b'one'))
+        self.assertEqual(await peer.read_frame(reader), (peer.REPLY, 2, bytes(range(256)) * 5))
+        damaged = a[:-1] + bytes([a[-1] ^ 1])
+        with self.assertRaises(ValueError):
+            peer.decode(damaged)
+        with self.assertRaises(ValueError):
+            peer.encode(peer.REQUEST, 3, bytes(1457))
+
+    async def test_sequence_and_accounting(self):
+        m = peer.Metrics()
+        x = peer.Exchange(m, 7)
+        _, seq, body = peer.decode(x.request())
+        x.receive(peer.REPLY, seq, body)
+        x.receive(peer.REPLY, seq, body)
+        self.assertEqual(m.verified_replies, 1)
+        self.assertEqual(m.duplicates, 1)
+        self.assertIsNotNone(m.rtt_min)
+        self.assertIsNotNone(x.receive(peer.REQUEST, 5, b'5'))
+        x.receive(peer.REQUEST, 4, b'4')
+        self.assertEqual(m.reordered, 1)
+        x.request()
+        x.finish()
+        self.assertEqual(m.lost_or_unconfirmed, 1)
+
+    async def test_concurrent_loopback_tool(self):
+        await self.check_concurrent_loopback_tool()
+
+    async def test_wait_for_both_tcp_roles_and_drain(self):
+        await self.check_concurrent_loopback_tool(wait_concurrent=3, drain_seconds=.1)
+
+    async def check_concurrent_loopback_tool(self, wait_concurrent=0, drain_seconds=0):
+        asyncio.get_running_loop().set_debug(False)
+        ip = '127.0.0.1'
+        tasks = set()
+        with socket.socket() as reserve:
+            reserve.bind((ip, 0))
+            pc_tcp_port = reserve.getsockname()[1]
+
+        async def board_stream(reader, writer):
+            writer.write(peer.encode(peer.REQUEST, 1, b'board'))
+            await writer.drain()
+            try:
+                while True:
+                    kind, seq, data = await peer.read_frame(reader)
+                    if kind == peer.REQUEST:
+                        writer.write(peer.encode(peer.REPLY, seq, data))
+                        await writer.drain()
+            except (asyncio.IncompleteReadError, OSError):
+                pass
+            finally:
+                writer.close()
+                with contextlib.suppress(OSError, asyncio.TimeoutError):
+                    await asyncio.wait_for(writer.wait_closed(), 1)
+
+        def incoming(reader, writer):
+            task = asyncio.create_task(board_stream(reader, writer))
+            tasks.add(task)
+            task.add_done_callback(tasks.discard)
+
+        async def board_client():
+            while True:
+                try:
+                    reader, writer = await asyncio.open_connection(ip, pc_tcp_port)
+                    break
+                except OSError:
+                    await asyncio.sleep(.01)
+            await board_stream(reader, writer)
+
+        class BoardUdp(asyncio.DatagramProtocol):
+            sent = False
+
+            def connection_made(self, transport):
+                self.transport = transport
+
+            def datagram_received(self, data, addr):
+                kind, seq, body = peer.decode(data)
+                if kind == peer.REQUEST:
+                    self.transport.sendto(peer.encode(peer.REPLY, seq, body), addr)
+                    if not self.sent:
+                        self.sent = True
+                        self.transport.sendto(peer.encode(peer.REQUEST, 1, b'board UDP'), addr)
+
+        listener = await asyncio.start_server(incoming, ip, 0)
+        board_tcp_port = listener.sockets[0].getsockname()[1]
+        udp, _ = await asyncio.get_running_loop().create_datagram_endpoint(
+            BoardUdp, local_addr=(ip, 0))
+        board_udp_port = udp.get_extra_info('sockname')[1]
+        client = asyncio.create_task(board_client())
+        try:
+            cfg = SimpleNamespace(local_ip=ip, board_ip=ip, seed=10, seconds=5, interval=.10,
+                                  count=20, burst=1, reply_timeout=2, broadcast=None, fragment=True,
+                                  reconnect_every=0, rst=False, stall_seconds=0,
+                                  wait_concurrent=wait_concurrent, drain_seconds=drain_seconds,
+                                  board_udp_port=board_udp_port, local_udp_port=0,
+                                  board_tcp_port=board_tcp_port, local_tcp_port=pc_tcp_port)
+            result = await peer.run(cfg)
+        finally:
+            udp.close()
+            listener.close()
+            await listener.wait_closed()
+            pending = [client, *tasks]
+            for task in pending:
+                task.cancel()
+            await asyncio.gather(*pending, return_exceptions=True)
+        self.assertFalse(result['hardware_pass'])
+        self.assertIsNotNone(result['traffic_started_epoch'])
+        self.assertGreaterEqual(result['drain_started_epoch'] - result['traffic_started_epoch'], 4.9)
+        for role, stats in result['channels'].items():
+            self.assertEqual(stats['verified_replies'], 20, (role, stats))
+            self.assertEqual(stats['board_requests'], 1)
+            self.assertEqual(stats['lost_or_unconfirmed'], 0)
+            self.assertEqual(stats['invalid'], 0)
+        self.assertGreater(result['concurrent_activity_seconds'], 0)
+
+
+if __name__ == '__main__':
+    unittest.main()
diff --git a/main-after/Tests/Ethernet/test_e6_network.c b/main-after/Tests/Ethernet/test_e6_network.c
new file mode 100644
index 0000000..2ac2810
--- /dev/null
+++ b/main-after/Tests/Ethernet/test_e6_network.c
@@ -0,0 +1,347 @@
+#include "eth_http.h"
+#define ETH_HOST_APP_POLL eth_http_poll
+#define ETH_HOST_STEP_MS 1U
+#include "eth_host_wire.h"
+#include "e6_jpeg_fixtures/e6_jpeg_fixtures.h"
+#include "lwip/priv/tcp_priv.h"
+#include <stdbool.h>
+
+static char s_body[100000];
+static size_t s_length;
+static unsigned s_cursor;
+static unsigned s_fin;
+static unsigned s_fixture_start;
+
+static Peer_t Open(unsigned port)
+{
+	Peer_t peer = WireSyn(80U, (uint16_t)port, 1000U + port);
+	Tcp(&peer, ACK, 4096U, NULL, 0U);
+	assert(eth_tcp_get_state(eth_tcp_handle(ETH_TCP_SERVER)) == ETH_TCP_OPEN);
+	s_length = 0U;
+	s_fin = 0U;
+	s_cursor = s_wire_count;
+	s_body[0] = '\0';
+	return peer;
+}
+
+static void Send(Peer_t *peer, uint16_t window, const char *request)
+{
+	Tcp(peer, PSH | ACK, window, request, (uint16_t)strlen(request));
+}
+
+static void Collect(Peer_t *peer, unsigned ms)
+{
+	uint32_t started = s_tick;
+	while ((uint32_t)(s_tick - started) < ms)
+	{
+		uint32_t prior = peer->board_ack;
+		unsigned end;
+		Pump(ETH_HOST_STEP_MS);
+		end = s_wire_count;
+		assert(end - s_cursor <= 128U);
+		for (; s_cursor < end; ++s_cursor)
+		{
+			const Wire_t *w = &s_wire[s_cursor % 128U];
+			if (w->dest != peer->pc_port || w->seq != peer->board_ack || w->protocol != 6U)
+				continue;
+			assert(s_length + w->length < sizeof(s_body));
+			memcpy(s_body + s_length, w->data, w->length);
+			s_length += w->length;
+			s_body[s_length] = '\0';
+			peer->board_ack += w->length;
+			if (w->flags & FIN)
+			{
+				++peer->board_ack;
+				++s_fin;
+			}
+		}
+		if (prior != peer->board_ack)
+			Tcp(peer, ACK, 4096U, NULL, 0U);
+	}
+}
+
+static void CheckResponse(Peer_t *peer, const char *status, const char *body)
+{
+	const char *header_end;
+	Collect(peer, 360U);
+	assert(strncmp(s_body, status, strlen(status)) == 0);
+	assert(s_fin == 1U);
+	header_end = strstr(s_body, "\r\n\r\n");
+	assert(header_end);
+	if (body)
+		assert(strstr(header_end + 4, body));
+	Tcp(peer, FIN | ACK, 4096U, NULL, 0U);
+	Pump(100U);
+	assert(eth_tcp_get_state(eth_tcp_handle(ETH_TCP_SERVER)) == ETH_TCP_IDLE);
+}
+
+static uint32_t Crc(const uint8_t *data, uint16_t length)
+{
+	uint32_t crc = UINT32_MAX;
+	while (length--)
+	{
+		unsigned bit;
+		crc ^= *data++;
+		for (bit = 0U; bit < 8U; ++bit)
+			crc = (crc >> 1U) ^ ((crc & 1U) ? UINT32_C(0xEDB88320) : 0U);
+	}
+	return ~crc;
+}
+
+static void CheckParts(unsigned count, unsigned first)
+{
+	const char *part = strstr(s_body, "\r\n\r\n");
+	unsigned i;
+	assert(strncmp(s_body, "HTTP/1.1 200 OK", 15U) == 0);
+	assert(strstr(s_body, "multipart/x-mixed-replace; boundary=h7frame") && part);
+	part += 4;
+	for (i = 0; i < count; ++i)
+	{
+		const EthMjpegFrame_t *image = &e6_jpeg_frames[(first + i) % E6_FRAME_COUNT];
+		char expected[128];
+		int header_size = snprintf(expected, sizeof(expected), "--h7frame\r\nContent-Type: image/jpeg\r\n"
+			"Content-Length: %u\r\nX-Frame-Sequence: %u\r\nX-Frame-CRC32: %08lX\r\n\r\n",
+			image->length, i + 1U, (unsigned long)image->crc32);
+		assert(header_size > 0 && (size_t)(part - s_body) + (size_t)header_size + image->length + 2U <= s_length);
+		assert(memcmp(part, expected, (size_t)header_size) == 0);
+		part += header_size;
+		assert(memcmp(part, image->data, image->length) == 0 && Crc((const uint8_t *)part, image->length) == image->crc32);
+		assert((uint8_t)part[0] == 255U && (uint8_t)part[1] == 216U &&
+			(uint8_t)part[image->length - 2U] == 255U && (uint8_t)part[image->length - 1U] == 217U);
+		part += image->length;
+		assert(memcmp(part, "\r\n", 2U) == 0);
+		part += 2U;
+	}
+}
+
+static struct
+{
+	uint32_t generation, index, acquisitions, releases;
+	bool pinned;
+} s_dynamic;
+
+static EthMjpegAcquire_t Acquire(void *context, EthMjpegFrame_t *frame, uint32_t *lease)
+{
+	uint32_t generation = eth_tcp_handle(ETH_TCP_SERVER).generation;
+	(void)context;
+	assert(!s_dynamic.pinned);
+	if (generation != s_dynamic.generation)
+	{
+		s_dynamic.generation = generation;
+		s_dynamic.index = s_fixture_start;
+	}
+	*frame = e6_jpeg_frames[s_dynamic.index++ % E6_FRAME_COUNT];
+	*lease = ++s_dynamic.acquisitions;
+	s_dynamic.pinned = true;
+	return ETH_MJPEG_ACQUIRED;
+}
+
+static void Release(void *context, uint32_t lease)
+{
+	(void)context;
+	assert(s_dynamic.pinned && lease == s_dynamic.acquisitions);
+	++s_dynamic.releases;
+	s_dynamic.pinned = false;
+}
+
+int main(int argc, char **argv)
+{
+	static const char stream[] = "GET /stream.mjpg HTTP/1.1\r\nHost: test\r\n\r\n";
+	static const struct { const char *request, *status, *body; } cases[] = {
+		{"GET /health HTTP/1.1\r\n\r\nGET /missing HTTP/1.0\r\n\r\n", "HTTP/1.1 200", "ok\n"},
+		{"GET /missing HTTP/1.1\r\n\r\n", "HTTP/1.1 404", NULL},
+		{"GET /favicon.ico HTTP/1.1\r\n\r\n", "HTTP/1.1 204", NULL},
+		{"POST / HTTP/1.1\r\n\r\n", "HTTP/1.1 405", NULL},
+		{"G?T / HTTP/1.1\r\n\r\n", "HTTP/1.1 400", NULL},
+		{"GET /%2f HTTP/1.1\r\n\r\n", "HTTP/1.1 400", NULL},
+		{"GET / HTTP/1.1\r\nBad Header: test\r\n\r\n", "HTTP/1.1 400", NULL},
+	};
+	EthNetworkAddressConfig_t address = {.mode = ETH_ADDRESS_DHCP, .timeout_ms = 30000U};
+	EthTransportConfig_t invalid = {0};
+	EthHttpStats_t result, before;
+	EthTcpHandle_t stale;
+	ip4_addr_t other, original;
+	Peer_t peer, old;
+	char oversized[540];
+	unsigned i;
+	const EthMjpegSource_t source = {NULL, Acquire, Release};
+	bool fast_send = argc == 2 && strcmp(argv[1], "dynamic-fast") == 0;
+	bool dynamic = fast_send || (argc == 2 && strcmp(argv[1], "dynamic") == 0);
+	(void)setvbuf(stdout, NULL, _IONBF, 0);
+	assert(eth_network_init_address(&s_network, s_mac, &address) == ERR_OK);
+	invalid.udp_port = 5001U;
+	assert(eth_transport_init(&s_network, &invalid) == ERR_ARG);
+	if (dynamic)
+		assert(eth_http_init_source(&s_network, &source, 200U) == ERR_OK);
+	else
+		assert(eth_http_init(&s_network, e6_jpeg_frames, E6_FRAME_COUNT, 200U) == ERR_OK);
+	eth_http_set_stream_fast_send(fast_send);
+	s_link = 1U;
+	Advance(100U);
+	Bind();
+	Pump(80U);
+	assert(eth_tcp_listening() && lwip_stats.memp[MEMP_UDP_PCB]->used == 1U);
+	peer = Open(51000U);
+	Send(&peer, 4096U, "GE");
+	Collect(&peer, 60U);
+	assert(!s_length);
+	Send(&peer, 4096U, "T / HTTP/1.1\r\nHost: test\r\nOther:");
+	Collect(&peer, 60U);
+	assert(!s_length);
+	Send(&peer, 4096U, " ok\r\n\r");
+	Send(&peer, 4096U, "\n");
+	CheckResponse(&peer, "HTTP/1.1 200", "STM32H747 Ethernet Camera");
+	assert(strstr(s_body, "src=\"/stream.mjpg\"") && strstr(s_body, "192.168.50.2"));
+	for (i = 0U; i < sizeof(cases) / sizeof(cases[0]); ++i)
+	{
+		peer = Open(51001U + i);
+		Send(&peer, 4096U, cases[i].request);
+		CheckResponse(&peer, cases[i].status, cases[i].body);
+	}
+	peer = Open(51012U);
+	memset(oversized, 'a', sizeof(oversized) - 1U);
+	oversized[sizeof(oversized) - 1U] = '\0';
+	Send(&peer, 4096U, oversized);
+	CheckResponse(&peer, "HTTP/1.1 431", NULL);
+	peer = Open(51013U);
+	Send(&peer, 4096U, "GET / HTTP/1.1\r\n");
+	Pump(5100U);
+	CheckResponse(&peer, "HTTP/1.1 408", NULL);
+	puts("PASS: HTTP complete, fragmented, pipelined, malformed, 404/405/431, favicon and timeout");
+	peer = Open(51014U);
+	Send(&peer, 4096U, stream);
+	Collect(&peer, 2100U);
+	CheckParts(8U, 0U);
+	eth_http_get_statistics(&result);
+	printf("ACKed frames=%lu; FPS(milli)=%lu\n", (unsigned long)result.stream.frames_completed,
+		(unsigned long)result.stream.current_fps_milli);
+	assert(result.stream.frames_completed >= 8U && result.stream.current_fps_milli >= 4500U &&
+		result.stream.current_fps_milli <= 5500U);
+	stale = eth_tcp_handle(ETH_TCP_SERVER);
+	Tcp(&peer, FIN | ACK, 4096U, NULL, 0U);
+	eth_http_get_statistics(&before);
