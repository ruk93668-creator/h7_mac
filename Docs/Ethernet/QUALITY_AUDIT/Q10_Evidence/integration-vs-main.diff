++        # Existing Camera headers contain legacy-encoded comments.
++        camera_flags = ['/DETH_E7_CAMERA_QVGA'] if qvga else []
++        subprocess.run(['cl', *flags, *camera_flags, '/wd4828', '/ICM7/Media/Inc', '/ICommon/Inc',
