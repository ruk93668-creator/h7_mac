+//ͨ��Ӳ��I2C��ȡһ��16λ��ַ�Ĵ���
+SysResult_t BSP_Camera_ReadReg(uint16_t reg, uint8_t *value)
+{
+	uint8_t address[2];
+	SysResult_t result;
+
+	//δ����ϵ��I2C����ʱ��ֹ���ʣ����ı�����ߵ�����
