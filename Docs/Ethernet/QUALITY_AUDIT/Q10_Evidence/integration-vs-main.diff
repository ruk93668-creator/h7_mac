++#define TCP_SEQ_GT(a,b)     TCP_SEQ_LT(b,a)
++#define TCP_SEQ_GEQ(a,b)    TCP_SEQ_LEQ(b,a)
++/* is b<=a<=c? */
++#define TCP_SEQ_BETWEEN(a,b,c) (TCP_SEQ_GEQ(a,b) && TCP_SEQ_LEQ(a,c))
