++void EthTestRx_Inspect(
++	const uint8_t *data,
++	size_t length
++)
++{
++	uint32_t sequence;
++	uint32_t index;
++	uint8_t mask;
++	size_t i;
++
++	if (!g_eth_test_rx_check.active)
++		return;
++	if (!data || length < 14U || memcmp(data, s_destination, 6U) != 0 ||
++		memcmp(data + 6, s_source, 6U) != 0 || data[12] != 0x88U || data[13] != 0xB5U)
++	{
++		++g_eth_test_rx_check.ignored;
