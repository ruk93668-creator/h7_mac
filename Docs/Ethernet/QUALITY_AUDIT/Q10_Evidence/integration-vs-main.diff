+-    //从选帧到整帧确认的最大耗时，单位ms
+-    uint32_t max_send_latency_ms;
+-} EthMjpegStats_t;
+-
+-typedef struct
+-{
+-    EthMjpegState_t state;
+-    EthMjpegStats_t stats;
+-    const EthMjpegFrame_t *frames;
+-    const EthMjpegSource_t *source;
+-    EthMjpegFrame_t current;
+-    uint32_t lease;
+-    uint32_t ack_base;
+-    uint32_t submitted;
+-    uint32_t frame_end;
+-    uint32_t frame_started;
+-    uint32_t next_frame;
+-    uint32_t fps_started;
+-    uint32_t fps_frames;
+-    uint32_t last_progress;
+-    uint32_t last_ack;
+-    uint32_t sequence;
+-    uint32_t retry_due;
+-    uint16_t count;
+-    uint16_t period_ms;
+-    uint16_t offset;
+-    uint16_t header_length;
+-    //已提交整帧，等待帧尾字节确认
+-    uint8_t waiting_ack;
+-    //当前仍持有私有帧租约
+-    uint8_t borrowed;
+-    char header[128];
+-} EthMjpeg_t;
+-
+-//启动本轮视频响应，记录当前TCP确认字节数作为基准
