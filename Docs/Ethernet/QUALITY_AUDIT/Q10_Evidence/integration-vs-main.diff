+EthResult_t eth_mac_get_address(uint8_t mac[6])
+{
+	memcpy(mac, s_mac, 6U);
+	return ETH_OK;
+}
+
+EthResult_t eth_mac_get_statistics(EthStatistics_t *statistics)
+{
