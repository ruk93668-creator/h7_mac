diff --git a/main-after/Tests/Ethernet/e7_camera_provider.c b/main-after/Tests/Ethernet/e7_camera_provider.c
new file mode 100644
index 0000000..73dcf4c
--- /dev/null
+++ b/main-after/Tests/Ethernet/e7_camera_provider.c
@@ -0,0 +1,182 @@
+#include "e7_camera_provider.h"
+#include <string.h>
+
+//内部功能函数声明
+static bool E7Camera_Copy(
+    E7CameraProvider_t *provider,
+    const CameraFrame_t *frame,
+    uint32_t *crc
+);
+
+//对外接口实现
+EthMjpegAcquire_t E7Camera_Acquire(void *context, EthMjpegFrame_t *out, uint32_t *lease)
+{
+    E7CameraProvider_t *provider = context;
+    CameraFrame_t frame;
+    uint32_t crc = 0U;
+    bool valid;
+    if (!provider->running || provider->original_loan || provider->pinned || provider->lease == UINT32_MAX ||
+        !CameraCapture_StreamGetFrame(&frame))
+    {
+        ++provider->no_frame;
+        return ETH_MJPEG_UNAVAILABLE;
+    }
+    provider->original_loan = true;
+    valid = E7Camera_Copy(provider, &frame, &crc);
+    provider->media_result = CameraCapture_StreamReleaseFrame();
+    if (provider->media_result != SYS_OK)
+    {
+        ++provider->release_errors;
+        provider->running = false;
+        return ETH_MJPEG_INVALID;
+    }
+    provider->original_loan = false;
+    if (!valid)
+    {
+        ++provider->invalid;
+        return ETH_MJPEG_INVALID;
+    }
+    provider->pinned = true;
+    *lease = ++provider->lease;
+    out->data = provider->buffer;
+    out->length = (uint16_t)frame.size_bytes;
+    out->crc32 = crc;
+    ++provider->copies;
+    return ETH_MJPEG_ACQUIRED;
+}
+
+void E7Camera_Release(void *context, uint32_t lease)
+{
+    E7CameraProvider_t *provider = context;
+    if (!provider->pinned || lease != provider->lease)
+    {
+        ++provider->stale_releases;
+        return;
+    }
+    provider->pinned = false;
+}
+
+SysResult_t E7Camera_Start(E7CameraProvider_t *provider)
+{
+    if (provider->running || provider->pinned || provider->original_loan || !CameraCapture_IsStopped())
+        return SYS_ERR_BUSY;
+    provider->media_result = CameraCapture_StartStream();
+    provider->running = provider->media_result == SYS_OK;
+    provider->last_sample = 0U;
+    return provider->media_result;
+}
+
+SysResult_t E7Camera_Stop(E7CameraProvider_t *provider)
+{
+    provider->running = false;
+    if (provider->original_loan)
+        return provider->stop_result = SYS_ERR_BUSY;
+    provider->stop_result = CameraCapture_Stop();
+    (void)CameraCapture_GetStopFacts(&provider->stop_facts);
+    if (provider->stop_result == SYS_OK &&
+        (!CameraCapture_IsStopped() || provider->stop_facts.hardware_result != SYS_OK))
+        provider->stop_result = SYS_ERR_INVALID_STATE;
+    return provider->stop_result;
+}
+
+void E7Camera_Poll(E7CameraProvider_t *provider, uint32_t now)
+{
+    uint32_t elapsed = now - provider->last_sample;
+    if (provider->running)
+    {
+        CameraCapture_Process();
+        provider->media_result = CameraCapture_GetLastResult();
+        if (provider->media_result != SYS_OK || CameraCapture_IsStopped())
+        {
+            ++provider->capture_errors;
+            provider->running = false;
+            (void)CameraCapture_GetStopFacts(&provider->stop_facts);
+        }
+    }
+    if (elapsed >= 1000U && CameraCapture_GetStats(&provider->capture) == SYS_OK)
+    {
+        provider->capture_fps_milli = provider->running && provider->last_sample &&
+            provider->capture.completed_frames >= provider->last_completed ?
+            (provider->capture.completed_frames - provider->last_completed) * 1000000U / elapsed : 0U;
+        provider->copy_fps_milli = provider->running && provider->last_sample ?
+            (provider->copies - provider->last_copies) * 1000000U / elapsed : 0U;
+        provider->last_completed = provider->capture.completed_frames;
+        provider->last_copies = provider->copies;
+        provider->last_sample = now;
+    }
+}
+
+//内部功能函数实现
+
+//对私有副本计算CRC32，避免发送阶段再读取原始FIFO
+static uint32_t E7Camera_Crc(const uint8_t *data, uint32_t length)
+{
+    static const uint32_t table[16] = {
+        0x00000000U, 0x1db71064U, 0x3b6e20c8U, 0x26d930acU,
+        0x76dc4190U, 0x6b6b51f4U, 0x4db26158U, 0x5005713cU,
+        0xedb88320U, 0xf00f9344U, 0xd6d6a3e8U, 0xcb61b38cU,
+        0x9b64c2b0U, 0x86d3d2d4U, 0xa00ae278U, 0xbdbdf21cU
+    };
+    uint32_t crc = UINT32_MAX;
+    while (length--)
+    {
+        crc ^= *data++;
+        crc = table[crc & 15U] ^ (crc >> 4U);
+        crc = table[crc & 15U] ^ (crc >> 4U);
+    }
+    return ~crc;
+}
+
+//对照模式限制单次SDRAM复制长度，原始帧的所有权贯穿整次复制
+static void E7Camera_CopySpan(uint8_t *dst, const uint8_t *src, uint32_t length,
+    void (*barrier)(void))
+{
+    if (barrier == NULL)
+    {
+        memcpy(dst, src, length);
+        return;
+    }
+    while (length != 0U)
+    {
+        uint32_t amount = length;
+        if (amount > E7_JPEG_COPY_SEGMENT_BYTES)
+            amount = E7_JPEG_COPY_SEGMENT_BYTES;
+        memcpy(dst, src, amount);
+        barrier();
+        dst += amount;
+        src += amount;
+        length -= amount;
+    }
+}
+
+//校验两段范围，复制完整JPEG后检查帧首尾
+static bool E7Camera_Copy(E7CameraProvider_t *provider, const CameraFrame_t *frame, uint32_t *crc)
+{
+    uint32_t first;
+    uint32_t tail = frame->size_bytes2;
+    uint32_t total = frame->size_bytes;
+    uintptr_t base = (uintptr_t)provider->fifo;
+    uintptr_t start = (uintptr_t)frame->data;
+    if (total > E7_JPEG_CAPACITY || total > UINT16_MAX)
+    {
+        ++provider->oversize;
+        return false;
+    }
+    if (frame->format != CAMERA_PIXEL_FORMAT_JPEG || frame->width != E7_CAMERA_WIDTH || frame->height != E7_CAMERA_HEIGHT ||
+        total < 4U || tail >= total || start < base || start - base >= provider->fifo_size)
+        return false;
+    first = total - tail;
+    if (first > provider->fifo_size - (start - base) ||
+        (tail && (first != provider->fifo_size - (start - base) ||
+         frame->data2 != provider->fifo || tail > start - base)) ||
+        (!tail && frame->data2))
+        return false;
+    E7Camera_CopySpan(provider->buffer, frame->data, first, provider->copy_barrier);
+    if (tail)
+        E7Camera_CopySpan(provider->buffer + first, frame->data2, tail, provider->copy_barrier);
+    if (provider->buffer[0] != 0xffU || provider->buffer[1] != 0xd8U ||
+        provider->buffer[total - 2U] != 0xffU || provider->buffer[total - 1U] != 0xd9U)
+        return false;
+    *crc = E7Camera_Crc(provider->buffer, total);
+    return true;
+}
diff --git a/main-after/Tests/Ethernet/e7_camera_provider.h b/main-after/Tests/Ethernet/e7_camera_provider.h
new file mode 100644
index 0000000..f2a39d6
--- /dev/null
+++ b/main-after/Tests/Ethernet/e7_camera_provider.h
@@ -0,0 +1,70 @@
+#ifndef E7_CAMERA_PROVIDER_H
+#define E7_CAMERA_PROVIDER_H
+
+#include "camera_capture.h"
+#include "eth_mjpeg.h"
+
+#define E7_JPEG_CAPACITY (60U * 1024U)
+#define E7_JPEG_COPY_SEGMENT_BYTES 8U
+
+//统一传感器与帧提供器使用的JPEG尺寸
+#ifdef ETH_E7_CAMERA_QVGA
+#define E7_CAMERA_WIDTH 320U
+#define E7_CAMERA_HEIGHT 240U
+#else
+#define E7_CAMERA_WIDTH 160U
+#define E7_CAMERA_HEIGHT 120U
+#endif
+
+typedef struct
+{
+    //CPU私有JPEG副本，发送层持有租约期间不得覆盖
+    uint8_t *buffer;
+    //相机DMA使用的原始JPEG FIFO
+    const uint8_t *fifo;
+    //分段对照时等待上一小段访存完成
+    void (*copy_barrier)(void);
+    uint32_t fifo_size;
+    //私有帧租约序号
+    uint32_t lease;
+    //已校验并发布的私有JPEG帧数
+    uint32_t copies;
+    uint32_t invalid;
+    uint32_t oversize;
+    uint32_t no_frame;
+    uint32_t release_errors;
+    uint32_t stale_releases;
+    uint32_t capture_errors;
+    //相机采集帧率乘以1000
+    uint32_t capture_fps_milli;
+    //私有副本发布帧率乘以1000
+    uint32_t copy_fps_milli;
+    uint32_t last_sample;
+    uint32_t last_completed;
+    uint32_t last_copies;
+    CameraCaptureStats_t capture;
+    CameraCaptureStopFacts_t stop_facts;
+    SysResult_t media_result;
+    SysResult_t stop_result;
+    bool running;
+    bool pinned;
+    //持有原始帧时禁止复用该FIFO区域
+    bool original_loan;
+} E7CameraProvider_t;
+
+//借用原始JPEG，完成复制和CRC后归还原帧，再发布私有帧租约
+EthMjpegAcquire_t E7Camera_Acquire(void *context, EthMjpegFrame_t *frame, uint32_t *lease);
+
+//按租约归还私有帧，过期或重复租约只计数
+void E7Camera_Release(void *context, uint32_t lease);
+
+//确认硬件已停止、帧租约已归还后启动采集
+SysResult_t E7Camera_Start(E7CameraProvider_t *provider);
+
+//请求停止采集，并检查实际硬件停止结果
+SysResult_t E7Camera_Stop(E7CameraProvider_t *provider);
+
+//处理采集事件和错误，周期更新计数快照
+void E7Camera_Poll(E7CameraProvider_t *provider, uint32_t now);
+
+#endif
diff --git a/main-after/Tests/Ethernet/e7_main.c b/main-after/Tests/Ethernet/e7_main.c
new file mode 100644
index 0000000..8ca320a
--- /dev/null
+++ b/main-after/Tests/Ethernet/e7_main.c
@@ -0,0 +1,288 @@
+#include "stm32h7xx_hal.h"
+#include "eth_test_board.h"
+#include "eth_memory.h"
+#include "eth_http.h"
+#include "e7_camera_provider.h"
+#include "bsp_sdram.h"
+#include "bsp_dcmi.h"
+#include "camera_mjpeg_fifo.h"
+#include "ov5640_device.h"
+
+#ifdef ETH_E7_JPEG_AXI
+#define E7_NETWORK_START 0x24020000UL
+#if E7_NETWORK_START + E7_JPEG_CAPACITY > 0x24030000UL
+#error E7 private JPEG must fit in the 64 KiB AXI window
+#endif
+#else
+#define E7_NETWORK_START 0xD07F0000UL
+#define E7_AVI_END 0xD05A0000UL
+#if E7_NETWORK_START < CAMERA_MJPEG_REGION_END || E7_NETWORK_START < E7_AVI_END || \
+    E7_NETWORK_START + E7_JPEG_CAPACITY > BSP_SDRAM_END
+#error E7 network window must be outside all existing SDRAM users
+#endif
+#endif
+
+//帧间隔单位为ms，QVGA版调试时可在初始化前修改
+#ifdef ETH_E7_CAMERA_QVGA
+#define E7_FRAME_PERIOD_MS 50U
+#else
+#define E7_FRAME_PERIOD_MS 200U
+#endif
+
+static uint8_t g_e7_jpeg[E7_JPEG_CAPACITY] __attribute__((section(".e7_jpeg"), zero_init, aligned(32), used));
+static EthNetwork_t s_network;
+static Device_t *s_sensor;
+static E7CameraProvider_t s_provider;
+static bool s_camera_initialized;
+static const uint8_t s_mac[6] = {2U, 0x47U, 0x47U, 0U, 0U, 1U};
+
+volatile SysResult_t g_e7_sdram_result;
+volatile SysResult_t g_e7_camera_init;
+volatile SysResult_t g_e7_command_result;
+volatile int32_t g_e7_result;
+volatile uint32_t g_e7_mode = ETH_ADDRESS_DHCP;
+volatile uint16_t g_e7_period_ms = E7_FRAME_PERIOD_MS;
+//初始化前设为1时，只复制校验JPEG并归还缓冲，不启动HTTP
+volatile uint32_t g_e7_copy_only;
+//初始化前设为1时启用8字节分段，每段完成后再读下一段
+volatile uint32_t g_e7_copy_segmented;
+//初始化前设为1时，MJPEG连接启用连续提交
+volatile uint32_t g_e7_tcp_fast_send;
+volatile uint32_t g_e7_copy_attempts;
+//1停止采集，2重新启动采集
+volatile uint32_t g_e7_command;
+volatile uint16_t g_e7_sensor_id;
+volatile uint32_t g_e7_heartbeat;
+volatile uint32_t g_e7_ccr;
+volatile uint32_t g_e7_dcmi_cr;
+volatile uint32_t g_e7_dma_cr;
+volatile uint32_t g_e7_dcmi_risr;
+volatile uint32_t g_e7_dma_lisr;
+volatile uint32_t g_e7_submission_fps_milli;
+volatile E7CameraProvider_t g_e7_camera;
+volatile EthHttpStats_t g_e7_http;
+volatile EthTransportStats_t g_e7_transport;
+volatile EthNetworkAddressStatus_t g_e7_address;
+volatile EthStatistics_t g_e7_ethernet;
+const char *volatile g_e7_assert_message;
+
+void eth_lwip_assert(const char *message, const char *file, unsigned line)
+{
+    (void)file;
+    (void)line;
+    g_e7_assert_message = message;
+    g_e7_result = -100;
+    for (;;) { }
+}
+
+//配置相机SDRAM和私有帧所在的MPU区域
+static void E7Mpu(void)
+{
+    MPU_Region_InitTypeDef region = {0};
+    region.Enable = MPU_REGION_ENABLE;
+    region.Number = MPU_REGION_NUMBER2;
+    region.BaseAddress = BSP_SDRAM_BASE;
+    region.Size = MPU_REGION_SIZE_8MB;
+    region.TypeExtField = MPU_TEX_LEVEL1;
+    region.AccessPermission = MPU_REGION_FULL_ACCESS;
+    region.DisableExec = MPU_INSTRUCTION_ACCESS_DISABLE;
+    region.IsShareable = MPU_ACCESS_SHAREABLE;
+    region.IsCacheable = MPU_ACCESS_NOT_CACHEABLE;
+    region.IsBufferable = MPU_ACCESS_NOT_BUFFERABLE;
+    HAL_MPU_ConfigRegion(&region);
+#ifdef ETH_E7_JPEG_AXI
+    //仅CPU访问JPEG副本，相机和网口DMA继续使用各自的缓冲区
+    region.Number = MPU_REGION_NUMBER6;
+    region.BaseAddress = E7_NETWORK_START;
+    region.Size = MPU_REGION_SIZE_64KB;
+    region.IsShareable = MPU_ACCESS_NOT_SHAREABLE;
+    region.IsCacheable = MPU_ACCESS_CACHEABLE;
+    region.IsBufferable = MPU_ACCESS_BUFFERABLE;
+    HAL_MPU_ConfigRegion(&region);
+#endif
+}
+
+//先等待采集停止，再停止OV5640
+static SysResult_t E7Stop(void)
+{
+    SysResult_t result = E7Camera_Stop(&s_provider);
+    if (result != SYS_OK)
+        return result;
+    return s_sensor->state == DEVICE_STATE_RUNNING ? Device_Stop(s_sensor) :
+        (s_sensor->state == DEVICE_STATE_READY ? SYS_OK : SYS_ERR_INVALID_STATE);
+}
+
+//先启动OV5640，连续采集启动失败时走停止清理
+static SysResult_t E7Start(void)
+{
+    SysResult_t result;
+    if (!s_camera_initialized || s_provider.original_loan || s_provider.pinned ||
+        s_sensor->state != DEVICE_STATE_READY || !CameraCapture_IsStopped())
+        return SYS_ERR_BUSY;
+    result = Device_Start(s_sensor);
+    if (result != SYS_OK)
+        return result;
+    result = E7Camera_Start(&s_provider);
+    if (result != SYS_OK)
+    {
+        SysResult_t stop = E7Stop();
+        return stop == SYS_OK ? result : stop;
+    }
+    return SYS_OK;
+}
+
+//依次准备SDRAM、DCMI、传感器和采集上下文
+static SysResult_t E7CameraInit(void)
+{
+    const CameraConfig_t config = {
+        .width = E7_CAMERA_WIDTH,
+        .height = E7_CAMERA_HEIGHT,
+        .format = CAMERA_PIXEL_FORMAT_JPEG
+    };
+    Ov5640Device_t *camera;
+    SysResult_t result;
+    uint16_t id = 0U;
+    g_e7_sdram_result = BSP_SDRAM_Init();
+    if (g_e7_sdram_result != SYS_OK || !BSP_SDRAM_IsReady())
+        return SYS_ERR_IO;
+    result = BSP_DCMI_Init();
+    if (result != SYS_OK)
+        return result;
+    //设备导出区只注册OV5640
+    result = Device_RegisterAll();
+    if (result != SYS_OK)
+        return result;
+    s_sensor = Device_Find("ov5640");
+    if (!s_sensor)
+        return SYS_ERR_NOT_FOUND;
+    result = Device_Init(s_sensor);
+    if (result != SYS_OK)
+        return result;
+    camera = FRAMEWORK_CONTAINER_OF(s_sensor, Ov5640Device_t, base);
+    result = camera->ops->read_id(camera, &id);
+    g_e7_sensor_id = id;
+    if (result != SYS_OK || id != OV5640_CHIP_ID)
+        return SYS_ERR_IO;
+    result = camera->ops->configure(camera, &config);
+    if (result != SYS_OK)
+        return result;
+    result = CameraCapture_Init(&config);
+    if (result != SYS_OK)
+        return result;
+    s_provider.buffer = g_e7_jpeg;
+    s_provider.fifo = (const uint8_t *)CAMERA_MJPEG_FIFO_BASE;
+    s_provider.fifo_size = CAMERA_MJPEG_FIFO_BYTES;
+    s_camera_initialized = true;
+    return E7Start();
+}
+
+//等待CPU完成本段访存，再发起下一段SDRAM读取
+static void E7CopyBarrier(void)
+{
+    __DSB();
+}
+
+//复用网页发送前的取帧、复制、校验及归还路径
+static void E7CopyOnce(void)
+{
+    EthMjpegFrame_t frame;
+    uint32_t lease;
+
+    ++g_e7_copy_attempts;
+    if (E7Camera_Acquire(&s_provider, &frame, &lease) == ETH_MJPEG_ACQUIRED)
+        E7Camera_Release(&s_provider, lease);
+}
+
+//同一主循环推进采集、协议栈和独立测试统计
+int main(void)
+{
+    EthNetworkAddressConfig_t config = {.mode = ETH_ADDRESS_DHCP};
+    const EthMjpegSource_t source = {&s_provider, E7Camera_Acquire, E7Camera_Release};
+    bool tcp_fast_send;
+    uint32_t last = 0U;
+    uint32_t fps_tick = 0U;
+    uint32_t prior_submitted = 0U;
+    uint32_t last_copy_tick = 0U;
+    uint16_t period_ms;
+    bool copy_only;
+    if (!eth_test_board_init_with_mpu(E7Mpu) || !eth_memory_valid() ||
+        (uintptr_t)g_e7_jpeg != E7_NETWORK_START || g_e7_mode > ETH_ADDRESS_DHCP)
+        eth_lwip_assert("E7 setup", __FILE__, __LINE__);
+    config.mode = (EthNetworkAddressMode_t)g_e7_mode;
+    copy_only = g_e7_copy_only != 0U;
+    tcp_fast_send = g_e7_tcp_fast_send != 0U;
+    if (g_e7_copy_segmented != 0U)
+        s_provider.copy_barrier = E7CopyBarrier;
+    period_ms = g_e7_period_ms;
+    if (copy_only && period_ms == 0U)
+        eth_lwip_assert("E7 copy period", __FILE__, __LINE__);
+    config.timeout_ms = 30000U;
+    IP4_ADDR(&config.ip, 192, 168, 50, 2);
+    IP4_ADDR(&config.mask, 255, 255, 255, 0);
+    g_e7_camera_init = E7CameraInit();
+    g_e7_result = eth_network_init_address(&s_network, s_mac, &config);
+    if (g_e7_result == ERR_OK && !copy_only)
+    {
+        g_e7_result = eth_http_init_source(&s_network, &source, period_ms);
+        if (g_e7_result == ERR_OK)
+            eth_http_set_stream_fast_send(tcp_fast_send);
+    }
+    if (g_e7_result != ERR_OK)
+    {
+        if (s_camera_initialized)
+            g_e7_command_result = E7Stop();
+        for (;;) { }
+    }
+    for (;;)
+    {
+        uint32_t now = HAL_GetTick();
+        uint32_t command = g_e7_command;
+        ++g_e7_heartbeat;
+        if (command)
+        {
+            g_e7_command = 0U;
+            g_e7_command_result = !s_camera_initialized ? SYS_ERR_INVALID_STATE :
+                command == 1U ? E7Stop() : command == 2U ? E7Start() : SYS_ERR_INVALID_ARG;
+        }
+        if (s_camera_initialized)
+            E7Camera_Poll(&s_provider, now);
+        eth_network_poll(&s_network);
+        if (!copy_only)
+        {
+            eth_transport_poll();
+            eth_http_poll();
+        }
+        else if (s_provider.running && now - last_copy_tick >= period_ms)
+        {
+            last_copy_tick = now;
+            E7CopyOnce();
+        }
+        if (now - last >= 100U)
+        {
+            EthHttpStats_t http;
+            EthTransportStats_t transport;
+            EthStatistics_t eth;
+            last = now;
+            g_e7_ccr = SCB->CCR;
+            g_e7_dcmi_cr = DCMI->CR;
+            g_e7_dma_cr = DMA1_Stream0->CR;
+            g_e7_dcmi_risr = DCMI->RISR;
+            g_e7_dma_lisr = DMA1->LISR;
+            g_e7_camera = s_provider;
+            g_e7_address = s_network.address;
+            eth_http_get_statistics(&http);
+            if (now - fps_tick >= 1000U)
+            {
+                g_e7_submission_fps_milli = (http.stream.frames_submitted - prior_submitted) * 1000000U /
+                    (now - fps_tick);
+                prior_submitted = http.stream.frames_submitted;
+                fps_tick = now;
+            }
+            g_e7_http = http;
+            eth_transport_get_statistics(&transport);
+            g_e7_transport = transport;
+            if (eth_mac_get_statistics(&eth) == ETH_OK)
+                g_e7_ethernet = eth;
+        }
+    }
+}
diff --git a/main-after/Tests/Ethernet/eth_host_wire.h b/main-after/Tests/Ethernet/eth_host_wire.h
new file mode 100644
index 0000000..9c6a566
--- /dev/null
+++ b/main-after/Tests/Ethernet/eth_host_wire.h
@@ -0,0 +1,179 @@
+#ifndef ETH_HOST_WIRE_H
+#define ETH_HOST_WIRE_H
+
+//复用不改动的 E4 模拟 MAC/时钟，截取实际 lwIP 输出的线帧
+#define main E4FixtureMain
+#define eth_mac_tx_submit E4FixtureSubmit
+#include "test_e4_network.c"
+#undef eth_mac_tx_submit
+#undef main
+
+#include "lwip/tcp.h"
+#include "eth_transport.h"
+
+#ifndef ETH_HOST_STEP_MS
+#define ETH_HOST_STEP_MS 20U
+#endif
+
+enum { FIN = 1, SYN = 2, RST = 4, PSH = 8, ACK = 16 };
+typedef struct
+{
+	uint16_t source, dest, length, window;
+	uint32_t seq, ack;
+	uint8_t flags, protocol;
+	uint8_t data[1472];
+} Wire_t;
+typedef struct { uint16_t board_port, pc_port; uint32_t pc_seq, board_ack; } Peer_t;
+
+static Wire_t s_wire[128];
+static unsigned s_wire_count;
+static uint8_t s_checksum[1536];
+
+static uint16_t Get16(const uint8_t *data)
+{
+	return (uint16_t)(((uint16_t)data[0] << 8) | data[1]);
+}
+
+static uint32_t Get32(const uint8_t *data)
+{
+	return ((uint32_t)Get16(data) << 16) | Get16(data + 2U);
+}
+
+static void Put32(uint8_t *data, uint32_t value)
+{
+	Put16(data, (uint16_t)(value >> 16));
+	Put16(data + 2U, (uint16_t)value);
+}
+
+EthResult_t eth_mac_tx_submit(const void *data, size_t length, uint32_t *ticket)
+{
+	EthResult_t result = E4FixtureSubmit(data, length, ticket);
+	const uint8_t *p = data;
+	Wire_t *w;
+	uint16_t bytes;
+	if (result != ETH_OK || length < 42U || p[12] != 8U || p[13] != 0U ||
+		(p[23] != 6U && p[23] != 17U) || p[14] != 0x45U)
+		return result;
+	w = &s_wire[s_wire_count++ % 128U];
+	memset(w, 0, sizeof(*w));
+	w->protocol = p[23];
+	w->source = Get16(p + 34U);
+	w->dest = Get16(p + 36U);
+	if (w->protocol == 6U)
+	{
+		uint16_t header = (uint16_t)((p[46] >> 4) * 4U);
+		bytes = (uint16_t)(Get16(p + 16U) - 20U - header);
+		w->seq = Get32(p + 38U);
+		w->ack = Get32(p + 42U);
+		w->flags = p[47];
+		w->window = Get16(p + 48U);
+		assert(bytes <= sizeof(w->data) && (size_t)(34U + header + bytes) <= length);
+		memcpy(w->data, p + 34U + header, bytes);
+	}
+	else
+	{
+		bytes = (uint16_t)(Get16(p + 38U) - 8U);
+		assert(bytes <= sizeof(w->data) && (size_t)(42U + bytes) <= length);
+		memcpy(w->data, p + 42U, bytes);
+	}
+	w->length = bytes;
+	return result;
+}
+
+static void Pump(uint32_t ms)
+{
+	do
+	{
+		uint32_t step = ms > ETH_HOST_STEP_MS ? ETH_HOST_STEP_MS : ms;
+		s_tick += step;
+		ms -= step;
+		eth_network_poll(&s_network);
+		eth_transport_poll();
+#ifdef ETH_HOST_APP_POLL
+		ETH_HOST_APP_POLL();
+#endif
+	} while (ms != 0U);
+}
+
+static void Inbound(uint8_t protocol, uint16_t transport_length, int broadcast)
+{
+	memset(s_in, 0, 34U);
+	if (broadcast)
+		memset(s_in, 0xFF, 6U);
+	else
+		memcpy(s_in, s_mac, 6U);
+	memcpy(s_in + 6U, s_peer, 6U);
+	Put16(s_in + 12U, 0x0800U);
+	s_in[14] = 0x45U;
+	s_in[22] = 64U;
+	s_in[23] = protocol;
+	Put16(s_in + 16U, (uint16_t)(20U + transport_length));
+	memcpy(s_in + 26U, s_peer_ip, 4U);
+	memcpy(s_in + 30U, broadcast ? s_broadcast : s_board_ip, 4U);
+	Put16(s_in + 24U, Checksum(s_in + 14U, 20U));
+	s_in_length = 34U + transport_length;
+	s_pending_rx = 1U;
+	Pump(ETH_HOST_STEP_MS);
+}
+
+static void Tcp(Peer_t *peer, uint8_t flags, uint16_t window, const void *data, uint16_t bytes)
+{
+	uint8_t *p = s_in + 34U;
+	uint16_t header = (flags & SYN) ? 24U : 20U;
+	uint16_t length = (uint16_t)(header + bytes);
+	memset(p, 0, header);
+	Put16(p, peer->pc_port);
+	Put16(p + 2U, peer->board_port);
+	Put32(p + 4U, peer->pc_seq);
+	Put32(p + 8U, peer->board_ack);
+	p[12] = (uint8_t)((header / 4U) << 4);
+	p[13] = flags;
+	Put16(p + 14U, window);
+	if (flags & SYN)
+	{
+		p[20] = 2U;
+		p[21] = 4U;
+		Put16(p + 22U, 1460U);
+	}
+	if (bytes)
+		memcpy(p + header, data, bytes);
+	memcpy(s_checksum, s_peer_ip, 4U);
+	memcpy(s_checksum + 4U, s_board_ip, 4U);
+	s_checksum[8] = 0U;
+	s_checksum[9] = 6U;
+	Put16(s_checksum + 10U, length);
+	memcpy(s_checksum + 12U, p, length);
+	Put16(p + 16U, Checksum(s_checksum, 12U + length));
+	Inbound(6U, length, 0);
+	peer->pc_seq += bytes + (uint32_t)((flags & (SYN | FIN)) != 0U);
+}
+
+static const Wire_t *Last(unsigned from, uint16_t dest, uint8_t flags, int with_data)
+{
+	unsigned i = s_wire_count;
+	assert(i - from <= 128U);
+	while (i > from)
+	{
+		const Wire_t *w = &s_wire[--i % 128U];
+		if (w->dest == dest && (w->flags & flags) == flags && (!with_data || w->length))
+			return w;
+	}
+	return NULL;
+}
+
+static Peer_t WireSyn(uint16_t board_port, uint16_t port, uint32_t seq)
+{
+	Peer_t p = {board_port, port, seq, 0U};
+	unsigned n = s_wire_count;
+	const Wire_t *synack;
+	Tcp(&p, SYN, 4096U, NULL, 0U);
+	synack = Last(n, port, SYN | ACK, 0);
+	if (!synack)
+		fprintf(stderr, "no SYN-ACK for local port %u, peer port %u, listener=%d, MAC=%d\n",
+			(unsigned)board_port, (unsigned)port, eth_tcp_listening(), (int)s_state);
+	assert(synack && synack->ack == p.pc_seq && synack->source == board_port);
+	p.board_ack = synack->seq + 1U;
+	return p;
+}
+
+#endif
diff --git a/main-after/Tests/Ethernet/eth_test_board.c b/main-after/Tests/Ethernet/eth_test_board.c
