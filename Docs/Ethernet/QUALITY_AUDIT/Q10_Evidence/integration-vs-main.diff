++	uint32_t primask;
++	uint32_t region_base;
++	uint32_t attributes;
++	uint32_t region_index;
++	int memory_valid = 1;
++	const uint32_t expected = MPU_RASR_ENABLE_Msk | MPU_RASR_XN_Msk | (3UL << MPU_RASR_AP_Pos) |
