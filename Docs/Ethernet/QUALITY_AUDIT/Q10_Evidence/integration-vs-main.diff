@@ -0,0 +1,89 @@
+#include "eth_phy.h"
+#include <assert.h>
+#include <stddef.h>
+#include <stdio.h>
+static uint16_t registers[32];
+static uint16_t first_bsr;
+static unsigned reads;
+static unsigned fail_at;
+static unsigned writes;
+static int read_reg(
+	void *c,
+	uint8_t a,
+	uint8_t r,
+	uint16_t *v
+)
+{
+	(void)c;
+	assert(a == 0U);
+	++reads;
+	if (reads == fail_at)
+		return -1;
+	*v = r == 1U && reads == 1U ? first_bsr : registers[r];
+	return 0;
+}
+static int write_reg(
+	void *c,
+	uint8_t a,
+	uint8_t r,
+	uint16_t v
+)
+{
+	(void)c;
+	assert(a == 0U);
+	++writes;
+	if (fail_at != 0U)
+		return -1;
+	registers[r] = v;
+	return 0;
+}
+int main(void)
+{
+	EthPhy_t p = {NULL, read_reg, write_reg, 0U};
+	EthPhyLink_t link;
+	uint32_t id;
+
+	assert(eth_phy_probe(NULL, &id) == ETH_PHY_ARGUMENT);
+	p.address = 32U;
+	assert(eth_phy_reset_begin(&p) == ETH_PHY_ARGUMENT);
+	p.address = 0U;
+	registers[2] = 7U;
+	registers[3] = 0xC13FU;
+	assert(eth_phy_probe(&p, &id) == ETH_PHY_OK && id == 0x0007C13FUL);
+	registers[2] = 0xFFFFU;
+	registers[3] = 0xFFFFU;
+	assert(eth_phy_probe(&p, &id) == ETH_PHY_ID);
+	registers[2] = 0U;
+	registers[3] = 0U;
+	assert(eth_phy_probe(&p, &id) == ETH_PHY_ID);
+	reads = 0U;
+	fail_at = 2U;
+	assert(eth_phy_probe(&p, &id) == ETH_PHY_IO && id == 0U);
+	fail_at = 0U;
+	assert(eth_phy_reset_begin(&p) == ETH_PHY_OK && writes == 1U);
+	assert(eth_phy_reset_poll(&p) == ETH_PHY_WAIT);
+	registers[0] = 0U;
+	assert(eth_phy_reset_poll(&p) == ETH_PHY_OK);
+	fail_at = 1U;
+	assert(eth_phy_reset_begin(&p) == ETH_PHY_IO);
+	reads = 0U;
+	assert(eth_phy_reset_poll(&p) == ETH_PHY_IO);
+	fail_at = 0U;
+	reads = 0U;
+	first_bsr = 0U;
+	registers[1] = 36U;
+	assert(eth_phy_read_link(&p, &link) == ETH_PHY_OK && reads == 2U);
+	assert(link.up == 1U && link.autoneg_complete == 1U);
+	reads = 0U;
+	first_bsr = 36U;
+	registers[1] = 0U;
+	assert(eth_phy_read_link(&p, &link) == ETH_PHY_OK && link.up == 0U);
+	reads = 0U;
+	fail_at = 2U;
+	link.up = 1U;
+	assert(eth_phy_read_link(&p, &link) == ETH_PHY_IO && link.up == 0U);
+	p.read = NULL;
+	assert(eth_phy_read_link(&p, &link) == ETH_PHY_ARGUMENT);
+	puts("PASS: PHY identity, arguments, reset, latch-low and MDIO failures");
+	return 0;
+}
diff --git a/main-after/Tests/Ethernet/test_rx_check.c b/main-after/Tests/Ethernet/test_rx_check.c
new file mode 100644
index 0000000..9baccaf
--- /dev/null
+++ b/main-after/Tests/Ethernet/test_rx_check.c
@@ -0,0 +1,64 @@
+//验证测试统计器不会把缺帧、重复、乱序或损坏误判为通过
+#include "eth_test_rx.h"
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+static uint8_t s_frame[60] = {
+	2U, 0x47U, 0x47U, 0U, 0U, 1U, 0xECU, 0x1AU, 0xC3U, 0x3EU, 0xDBU, 0xB2U, 0x88U, 0xB5U};
+static void Submit(uint32_t sequence)
+{
+	size_t i;
+
+	s_frame[14] = (uint8_t)(sequence >> 24);
+	s_frame[15] = (uint8_t)(sequence >> 16);
+	s_frame[16] = (uint8_t)(sequence >> 8);
+	s_frame[17] = (uint8_t)sequence;
+	for (i = 18U;
+		 i < sizeof(s_frame);
+		 ++i)
+		s_frame[i] = (uint8_t)(i - 18U);
+	EthTestRx_Inspect(s_frame, sizeof(s_frame));
+}
+int main(void)
+{
+	uint32_t i;
+
+	EthTestRx_Reset();
+	for (i = 1U;
+		 i <= ETH_TEST_RX_LIMIT;
+		 ++i)
+		Submit(i);
+	EthTestRx_Finish();
+	assert(g_eth_test_rx_check.passed && g_eth_test_rx_check.received == 1000U);
+	assert(g_eth_test_rx_check.unique == 1000U && g_eth_test_rx_check.missing == 0U);
+	EthTestRx_Reset();
+	Submit(1U);
+	Submit(1U);
+	Submit(3U);
+	Submit(2U);
+	assert(g_eth_test_rx_check.duplicates == 1U && g_eth_test_rx_check.out_of_order == 1U);
+	assert(g_eth_test_rx_check.unique == 3U && g_eth_test_rx_check.missing == 997U);
+	s_frame[59] ^= 1U;
+	EthTestRx_Inspect(s_frame, sizeof(s_frame));
+	EthTestRx_Inspect(s_frame, 59U);
+	Submit(0U);
+	Submit(1001U);
+	assert(g_eth_test_rx_check.bad == 4U);
+	s_frame[12] = 8U;
+	EthTestRx_Inspect(s_frame, sizeof(s_frame));
+	assert(g_eth_test_rx_check.ignored == 1U);
+	EthTestRx_Finish();
+	assert(!g_eth_test_rx_check.passed);
+	s_frame[12] = 0x88U;
+	EthTestRx_Reset();
+	for (i = 1U;
+		 i < ETH_TEST_RX_LIMIT;
+		 ++i)
+		Submit(i);
+	EthTestRx_Finish();
+	assert(!g_eth_test_rx_check.passed && g_eth_test_rx_check.missing == 1U);
+	Submit(1000U);
+	assert(g_eth_test_rx_check.missing == 1U);
+	puts("PASS: fixed RX payload, sequence, missing, duplicate, reorder and session gates");
+	return 0;
+}
