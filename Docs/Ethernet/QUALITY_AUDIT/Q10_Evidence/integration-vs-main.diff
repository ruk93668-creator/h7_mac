++	if (sequence == 0U || sequence > ETH_TEST_RX_LIMIT)
++	{
++		++g_eth_test_rx_check.bad;
++		return;
++	}
++	for (i = 18U;
++		 i < length;
++		 ++i)
++	{
++		if (data[i] != (uint8_t)(i - 18U))
++		{
