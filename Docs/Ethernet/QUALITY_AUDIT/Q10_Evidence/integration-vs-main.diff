++		return ETH_ARGUMENT;
++	if (EthDma_MemoryOverlaps(ring, ticket, sizeof(*ticket)))
++		return ETH_ARGUMENT;
++	if (ring->tx_count == 0U)
++		return ETH_EMPTY;
