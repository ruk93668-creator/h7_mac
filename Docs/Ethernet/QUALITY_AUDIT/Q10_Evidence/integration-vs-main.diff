++   the subnet mask, not these masks.  */
++#define IP_CLASSA(a)        ((((u32_t)(a)) & 0x80000000UL) == 0)
++#define IP_CLASSA_NET       0xff000000
++#define IP_CLASSA_NSHIFT    24
++#define IP_CLASSA_HOST      (0xffffffff & ~IP_CLASSA_NET)
++#define IP_CLASSA_MAX       128
