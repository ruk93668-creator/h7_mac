+-#ifndef ETH_MJPEG_H
+-#define ETH_MJPEG_H
+-
+-#include "eth_tcp.h"
+-
+-typedef struct
+-{
+-    //有效的完整JPEG数据
+-    const uint8_t *data;
+-    //JPEG有效字节数
+-    uint16_t length;
+-    //该帧有效数据的CRC32
+-    uint32_t crc32;
+-} EthMjpegFrame_t;
+-
+-typedef enum
+-{
+-    ETH_MJPEG_ACQUIRED,
+-    ETH_MJPEG_UNAVAILABLE,
+-    ETH_MJPEG_INVALID
+-} EthMjpegAcquire_t;
+-
+-typedef struct
+-{
+-    void *context;
+-    EthMjpegAcquire_t (*acquire)(void *context, EthMjpegFrame_t *frame, uint32_t *lease);
+-    void (*release)(void *context, uint32_t lease);
+-} EthMjpegSource_t;
+-
+-typedef enum
+-{
+-    ETH_MJPEG_IDLE,
+-    ETH_MJPEG_RESPONSE_HEADER,
+-    ETH_MJPEG_FRAME_HEADER,
+-    ETH_MJPEG_FRAME_DATA,
+-    ETH_MJPEG_FRAME_TRAILER,
+-    ETH_MJPEG_WAIT_NEXT_FRAME,
+-    ETH_MJPEG_STOPPING,
+-    ETH_MJPEG_CLOSED,
+-    ETH_MJPEG_ERROR
+-} EthMjpegState_t;
+-
+-typedef struct
+-{
+-    //完整提交到TCP发送环的帧数
+-    uint32_t frames_submitted;
+-    //收到整帧累计TCP确认的帧数
+-    uint32_t frames_completed;
+-    uint32_t bytes_submitted;
+-    uint32_t send_busy;
+-    uint32_t send_errors;
+-    //因调度滞后或无可用帧跳过的次数
+-    uint32_t frame_skipped;
+-    //已确认帧率乘以1000
