++//复制发送数据并发布描述符所有权
++EthResult_t eth_ring_tx(
++	EthDmaRing_t *ring,
++	const void *data,
++	size_t length,
++	uint32_t *ticket
++)
++{
++	EthDmaDescriptor_t *descriptor;
++	unsigned index;
++
++	if (ring == NULL || ring->memory == NULL || data == NULL || ticket == NULL || length < 14U ||
