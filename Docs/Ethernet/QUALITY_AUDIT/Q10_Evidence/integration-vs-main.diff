++      }
++      netif = inp;
++    } else {
++      netif = NULL;
++    }
++#else /* LWIP_IGMP */
++    if ((netif_is_up(inp)) && (!ip4_addr_isany_val(*netif_ip4_addr(inp)))) {
++      netif = inp;
++    } else {
++      netif = NULL;
++    }
++#endif /* LWIP_IGMP */
