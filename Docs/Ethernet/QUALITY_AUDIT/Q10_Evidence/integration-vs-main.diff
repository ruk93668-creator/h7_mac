++  (netif)->mib2_counters.ifoutucastpkts = 0;  \
++  (netif)->mib2_counters.ifoutnucastpkts = 0; \
++  (netif)->mib2_counters.ifoutdiscards = 0; \
++  (netif)->mib2_counters.ifouterrors = 0; } while(0)
++#else /* MIB2_STATS */
