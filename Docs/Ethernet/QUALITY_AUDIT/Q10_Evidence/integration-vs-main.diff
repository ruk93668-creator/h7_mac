++                       cwd=root, check=True)
++        subprocess.run(['link', '/nologo', '/OUT:' + str(test),
++                        *(str(out / (Path(source).stem + '.obj')) for source in [*sources, HTTP[-1]])],
++                       cwd=root, check=True)
++        subprocess.run([str(test)], cwd=root, check=True)
++
++
++if __name__ == '__main__':
