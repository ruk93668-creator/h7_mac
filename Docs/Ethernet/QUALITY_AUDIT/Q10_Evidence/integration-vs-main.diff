++	uint16_t header = (flags & SYN) ? 24U : 20U;
++	uint16_t length = (uint16_t)(header + bytes);
++	memset(p, 0, header);
++	Put16(p, peer->pc_port);
++	Put16(p + 2U, peer->board_port);
++	Put32(p + 4U, peer->pc_seq);
++	Put32(p + 8U, peer->board_ack);
++	p[12] = (uint8_t)((header / 4U) << 4);
++	p[13] = flags;
++	Put16(p + 14U, window);
++	if (flags & SYN)
