+++ b/main-after/Tests/Ethernet/e4_sources.py
@@ -0,0 +1,20 @@
+"""Shared source lists for the isolated E4 Keil and host builds."""
+
+PORT = ['Platform/Ethernet/eth_netif.c', 'Platform/Ethernet/eth_network.c']
