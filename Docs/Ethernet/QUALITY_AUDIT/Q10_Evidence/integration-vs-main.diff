++#define IP6H_PLEN_SET(hdr, plen) (hdr)->_plen = lwip_htons(plen)
++#define IP6H_NEXTH_SET(hdr, nexth) (hdr)->_nexth = (nexth)
++#define IP6H_HOPLIM_SET(hdr, hl) (hdr)->_hoplim = (u8_t)(hl)
