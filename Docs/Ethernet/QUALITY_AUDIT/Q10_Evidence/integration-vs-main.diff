++tcp_ext_arg_invoke_callbacks_passive_open(struct tcp_pcb_listen *lpcb, struct tcp_pcb *cpcb)
++{
++  int i;
++  LWIP_ASSERT("lpcb != NULL", lpcb != NULL);
++  LWIP_ASSERT("cpcb != NULL", cpcb != NULL);
