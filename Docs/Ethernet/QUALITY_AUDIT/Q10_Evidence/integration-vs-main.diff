++        tcp_input_pcb = NULL;
++        if (tcp_input_delayed_close(pcb)) {
++          goto aborted;
++        }
++        /* Try to send something out. */
++        tcp_output(pcb);
++#if TCP_INPUT_DEBUG
++#if TCP_DEBUG
++        tcp_debug_print_state(pcb->state);
++#endif /* TCP_DEBUG */
++#endif /* TCP_INPUT_DEBUG */
