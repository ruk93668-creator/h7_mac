++#define IP_CLASSB(a)        ((((u32_t)(a)) & 0xc0000000UL) == 0x80000000UL)
++#define IP_CLASSB_NET       0xffff0000
++#define IP_CLASSB_NSHIFT    16
++#define IP_CLASSB_HOST      (0xffffffff & ~IP_CLASSB_NET)
++#define IP_CLASSB_MAX       65536
