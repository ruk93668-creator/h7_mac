++			channel->counted = 1U;
++		}
++		if (channel->frame[5] == E5_REQUEST)
++		{
++			channel->frame[5] = E5_REPLY;
++			if (eth_tcp_send(handle, channel->frame, channel->want) != ERR_OK)
++			{
++				channel->frame[5] = E5_REQUEST;
++				++channel->stats.blocked;
++				break;
++			}
++			++channel->stats.reply_tx;
++		}
++		channel->have = 0U;
++		channel->want = 0U;
++		channel->counted = 0U;
++	}
