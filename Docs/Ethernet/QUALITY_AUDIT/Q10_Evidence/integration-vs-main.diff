++                            struct tcp_pcb *tcp_tmp_pcb; \
++                            LWIP_ASSERT("TCP_RMV: pcbs != NULL", *(pcbs) != NULL); \
++                            LWIP_DEBUGF(TCP_DEBUG, ("TCP_RMV: removing %p from %p\n", (void *)(npcb), (void *)(*(pcbs)))); \
