++/**
++ * @ingroup pbuf
++ * Increment the reference count of the pbuf.
++ *
++ * @param p pbuf to increase reference counter of
++ *
++ */
++void
++pbuf_ref(struct pbuf *p)
++{
++  /* pbuf given? */
++  if (p != NULL) {
++    SYS_ARCH_SET(p->ref, (LWIP_PBUF_REF_T)(p->ref + 1));
++    LWIP_ASSERT("pbuf ref overflow", p->ref > 0);
++  }
++}
