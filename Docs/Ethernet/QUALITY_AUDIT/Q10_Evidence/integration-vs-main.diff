+//Ethernet 专用 MPU 和链接窗口
+#ifndef ETH_MEMORY_H
+#define ETH_MEMORY_H
+
+#include "eth_dma.h"
+#define ETH_DMA_BASE UINT32_C(0x24078000)
+#define ETH_DMA_WINDOW UINT32_C(0x8000)
+extern EthDmaMemory_t g_eth_dma_memory;
+
+//仅在 CM7 早期启动、MPU 和 DCache 禁用时配置
+void eth_memory_configure(void);
+
+int eth_memory_valid(void);
+#endif
diff --git a/main-after/Platform/Ethernet/eth_netif.c b/main-after/Platform/Ethernet/eth_netif.c
new file mode 100644
index 0000000..118af40
--- /dev/null
+++ b/main-after/Platform/Ethernet/eth_netif.c
@@ -0,0 +1,120 @@
+//pbuf 和 DMA 内存的所有权始终独立
+#include "eth_netif.h"
+#include "lwip/etharp.h"
+#include "lwip/prot/ethernet.h"
+
+typedef char eth_header_size_check[(sizeof(struct eth_hdr) == 14U) ? 1 : -1];
+
+static err_t EthNetif_Output(struct netif *netif, struct pbuf *packet)
+{
+	EthNetif_t *context = netif->state;
+	EthResult_t result;
+	uint32_t ticket;
+	u16_t length;
+
+	if (!netif_is_up(netif) || !netif_is_link_up(netif))
+		return ERR_RTE;
+	if (packet == NULL || packet->tot_len < 14U || packet->tot_len > ETH_NETIF_FRAME_MAX)
+	{
+		++context->statistics.tx_rejected;
+		return ERR_BUF;
+	}
+	length = packet->tot_len;
+	if (pbuf_copy_partial(packet, context->tx_frame, length, 0U) != length)
+	{
+		++context->statistics.tx_rejected;
+		return ERR_BUF;
+	}
+	//提交时驱动同步复制，适配层不持有 pbuf，也不等待完成
+	result = eth_mac_tx_submit(context->tx_frame, length, &ticket);
+	if (result == ETH_OK)
+	{
+		++context->statistics.tx_accepted;
+		return ERR_OK;
+	}
+	if (result == ETH_BUSY)
+	{
+		++context->statistics.tx_busy;
+		return ERR_MEM;
+	}
+	++context->statistics.tx_errors;
+	return result == ETH_LINK_DOWN ? ERR_RTE : ERR_IF;
+}
+
+err_t eth_netif_init(struct netif *netif)
+{
+	if (netif == NULL || netif->state == NULL)
+		return ERR_ARG;
+	if (eth_mac_get_address(netif->hwaddr) != ETH_OK)
+		return ERR_IF;
+	netif->name[0] = 'e';
+	netif->name[1] = 'n';
+	netif->hwaddr_len = 6U;
+	netif->mtu = ETH_NETIF_MTU;
+	netif->flags = NETIF_FLAG_BROADCAST | NETIF_FLAG_ETHARP | NETIF_FLAG_ETHERNET;
+	netif->output = etharp_output;
+	netif->linkoutput = EthNetif_Output;
+	return ERR_OK;
+}
+
+void eth_netif_poll(struct netif *netif)
+{
+	EthNetif_t *context = netif->state;
+	unsigned index;
+
+	if (!netif_is_up(netif) || !netif_is_link_up(netif))
+		return;
+	//先回收上一轮 TX，为本轮的 ARP/ICMP 应答腾出槽位
+	for (index = 0U; index < ETH_NETIF_BUDGET; ++index)
+	{
+		uint32_t ticket;
+		EthResult_t result = eth_mac_tx_reclaim(&ticket);
+
+		if (result == ETH_OK)
+			++context->statistics.tx_completed;
+		else if (result == ETH_EMPTY)
+			break;
+		else
+		{
+			++context->statistics.tx_errors;
+			if (result != ETH_FRAME_ERROR)
+				break;
+		}
+	}
+	for (index = 0U; index < ETH_NETIF_BUDGET; ++index)
+	{
+		struct pbuf *packet;
+		size_t length;
+		EthResult_t result = eth_mac_rx_poll(context->rx_frame, sizeof(context->rx_frame), &length);
+
+		if (result == ETH_EMPTY)
+			break;
+		if (result != ETH_OK)
+		{
+			++context->statistics.rx_errors;
+			if (result != ETH_FRAME_ERROR)
+				break;
+			continue;
+		}
+		if (length < 14U || length > ETH_NETIF_FRAME_MAX)
+		{
+			++context->statistics.rx_rejected;
+			continue;
+		}
+		packet = pbuf_alloc(PBUF_RAW, (u16_t)length, PBUF_POOL);
+		if (packet == NULL)
+		{
+			++context->statistics.rx_no_pbuf;
+			continue;
+		}
+		if (pbuf_take(packet, context->rx_frame, (u16_t)length) != ERR_OK ||
+			netif->input(packet, netif) != ERR_OK)
+		{
+			//输入拒绝时所有权仍由适配层持有
+			pbuf_free(packet);
+			++context->statistics.rx_rejected;
+		}
+		else
+			++context->statistics.rx_delivered;
+	}
+}
diff --git a/main-after/Platform/Ethernet/eth_netif.h b/main-after/Platform/Ethernet/eth_netif.h
new file mode 100644
index 0000000..a49ce5e
--- /dev/null
+++ b/main-after/Platform/Ethernet/eth_netif.h
@@ -0,0 +1,43 @@
+//lwIP 与复制式 Ethernet MAC 之间的适配
+#ifndef ETH_NETIF_H
+#define ETH_NETIF_H
+
+#include "eth_mac.h"
+#include "lwip/netif.h"
+
+#define ETH_NETIF_MTU 1500U
+#define ETH_NETIF_FRAME_MAX (ETH_NETIF_MTU + 14U)
+//RX 可以先消费驱动支持的更长帧，再按本 netif 的边界丢弃
+#define ETH_NETIF_RX_BUFFER 1536U
+#define ETH_NETIF_BUDGET 4U
+
+typedef struct
+{
+	uint32_t tx_accepted;
+	uint32_t tx_completed;
+	uint32_t tx_busy;
+	uint32_t tx_rejected;
+	uint32_t tx_errors;
+	uint32_t rx_delivered;
+	uint32_t rx_no_pbuf;
+	uint32_t rx_rejected;
+	uint32_t rx_errors;
+} EthNetifStatistics_t;
+
+typedef struct
+{
+	EthNetifStatistics_t statistics;
+#if defined(_MSC_VER) && !defined(__clang__)
+	__declspec(align(32)) uint8_t tx_frame[ETH_NETIF_FRAME_MAX];
+	__declspec(align(32)) uint8_t rx_frame[ETH_NETIF_RX_BUFFER];
+#else
+	uint8_t tx_frame[ETH_NETIF_FRAME_MAX] __attribute__((aligned(32)));
+	uint8_t rx_frame[ETH_NETIF_RX_BUFFER] __attribute__((aligned(32)));
+#endif
+} EthNetif_t;
+
+//netif->state 由调用者设置为独立上下文；以下操作均在 lwIP 的唯一执行上下文
+err_t eth_netif_init(struct netif *netif);
+void eth_netif_poll(struct netif *netif);
+
+#endif
diff --git a/main-after/Platform/Ethernet/eth_network.c b/main-after/Platform/Ethernet/eth_network.c
new file mode 100644
index 0000000..7ee704b
--- /dev/null
+++ b/main-after/Platform/Ethernet/eth_network.c
@@ -0,0 +1,283 @@
+//NO_SYS：同一个循环管理 MAC 和 lwIP 定时器
+#include "eth_network.h"
+#include "lwip/init.h"
+#include "lwip/sys.h"
+#include "lwip/timeouts.h"
+#include "lwip/etharp.h"
+#include "netif/ethernet.h"
+#if LWIP_DHCP
+#include "lwip/dhcp.h"
+#include "lwip/prot/dhcp.h"
+#endif
+
+#define ETH_NETWORK_SERVICE_MS 10U
+
+static uint8_t s_lwip_initialized;
+static EthNetwork_t *s_owner;
+
+#if LWIP_DHCP
+#define ETH_DHCP_RETRY_MS 1000U
+
+static void EthNetwork_ClearAddress(EthNetwork_t *network)
+{
+	netif_set_addr(&network->interface, IP4_ADDR_ANY4, IP4_ADDR_ANY4, IP4_ADDR_ANY4);
+}
+
+static void EthNetwork_StopDhcp(EthNetwork_t *network)
+{
+	if (netif_dhcp_data(&network->interface) != NULL)
+	{
+		dhcp_release_and_stop(&network->interface);
+		dhcp_cleanup(&network->interface);
+	}
+	network->dhcp_running = 0U;
+}
+
+static EthNetworkDhcpState_t EthNetwork_DhcpState(uint8_t state)
+{
+	switch (state)
+	{
+	case DHCP_STATE_INIT:
+		return ETH_DHCP_STARTING;
+	case DHCP_STATE_SELECTING:
+	case DHCP_STATE_BACKING_OFF:
+		return ETH_DHCP_SELECTING;
+	case DHCP_STATE_REQUESTING:
+	case DHCP_STATE_CHECKING:
+	case DHCP_STATE_REBOOTING:
+		return ETH_DHCP_REQUESTING;
+	case DHCP_STATE_BOUND:
+		return ETH_DHCP_BOUND;
+	case DHCP_STATE_RENEWING:
+		return ETH_DHCP_RENEWING;
+	case DHCP_STATE_REBINDING:
+		return ETH_DHCP_REBINDING;
+	default:
+		return ETH_DHCP_ERROR;
+	}
+}
+
+static void EthNetwork_AddressPoll(EthNetwork_t *network, uint32_t now)
+{
+	struct netif *interface = &network->interface;
+	struct dhcp *dhcp = netif_dhcp_data(interface);
+	EthNetworkAddressStatus_t *status = &network->address;
+	const EthNetworkAddressConfig_t *config = &network->address_config;
+	uint8_t valid = (uint8_t)(netif_is_link_up(interface) && dhcp_supplied_address(interface));
+
+	if (config->mode != ETH_ADDRESS_STATIC && netif_is_link_up(interface) &&
+		status->state != ETH_DHCP_FALLBACK)
+	{
+		if (status->lease_valid && !valid)
+		{
+			//租约到期或 NAK 后，上游继续发现；开启新的等待窗口
+			network->acquisition_tick = now;
+			network->timeout_reported = 0U;
+		}
+		if (network->dhcp_running && (dhcp == NULL || dhcp->state == DHCP_STATE_OFF))
+			network->dhcp_running = 0U;
+		if (!valid && !network->timeout_reported &&
+			(uint32_t)(now - network->acquisition_tick) >= config->timeout_ms)
+		{
+			network->timeout_reported = 1U;
+			++status->timeouts;
+			if (config->mode == ETH_ADDRESS_DHCP_FALLBACK)
+			{
+				//此处尚无有效租约，不会尝试 Release
+				EthNetwork_StopDhcp(network);
+				etharp_cleanup_netif(interface);
+				netif_set_addr(interface, &config->ip, &config->mask, &config->gateway);
+				status->state = ETH_DHCP_FALLBACK;
+				++status->fallbacks;
+			}
+		}
+		if (status->state != ETH_DHCP_FALLBACK)
+		{
+			if (!network->dhcp_running && (!network->dhcp_attempted ||
+				(uint32_t)(now - network->last_start_tick) >= ETH_DHCP_RETRY_MS))
+			{
+				network->dhcp_attempted = 1U;
+				network->last_start_tick = now;
+				status->state = ETH_DHCP_STARTING;
+				++status->starts;
+				status->start_result = dhcp_start(interface);
+				network->dhcp_running = (uint8_t)(status->start_result == ERR_OK);
+				dhcp = netif_dhcp_data(interface);
+			}
+			status->state = network->dhcp_running ? EthNetwork_DhcpState(dhcp->state) : ETH_DHCP_ERROR;
+		}
+	}
+	dhcp = netif_dhcp_data(interface);
+	status->lease_valid = valid;
+	status->lwip_state = dhcp ? dhcp->state : DHCP_STATE_OFF;
+	status->ip = *netif_ip4_addr(interface);
+	status->mask = *netif_ip4_netmask(interface);
+	status->gateway = *netif_ip4_gw(interface);
+	status->server = valid && dhcp ? *ip_2_ip4(&dhcp->server_ip_addr) : *IP4_ADDR_ANY4;
+	status->lease_seconds = valid && dhcp ? dhcp->offered_t0_lease : 0U;
+	status->t1_seconds = valid && dhcp ? dhcp->offered_t1_renew : 0U;
+	status->t2_seconds = valid && dhcp ? dhcp->offered_t2_rebind : 0U;
+}
+#endif
+
+static void EthNetwork_LinkDown(EthNetwork_t *network)
+{
+	if (netif_is_link_up(&network->interface))
+	{
+		netif_set_link_down(&network->interface);
+#if LWIP_DHCP
+		if (network->address_config.mode != ETH_ADDRESS_STATIC)
+		{
+			//上游 stop 可能尝试 Release；先关闭 linkoutput，无报文能提交给 MAC
+			EthNetwork_StopDhcp(network);
+			EthNetwork_ClearAddress(network);
+			network->address.state = ETH_DHCP_WAIT_LINK;
+		}
+#endif
+		etharp_cleanup_netif(&network->interface);
+		++network->link_downs;
+	}
+}
+
+static void EthNetwork_Service(EthNetwork_t *network)
+{
+	EthStatistics_t statistics;
+	EthResult_t result = eth_mac_get_statistics(&statistics);
+
+	if (result == ETH_OK && (statistics.state == ETH_MAC_RUNNING ||
+		(statistics.state == ETH_MAC_FAULT && netif_is_link_up(&network->interface))))
+		result = eth_mac_service();
+
+	if (result == ETH_OK && statistics.state == ETH_MAC_READY)
+	{
+		//get_link 返回 BUSY 表示协商未完成；仅在 Start 成功后开通 netif
+		result = eth_mac_get_link(&network->phy);
+		if (result == ETH_OK && network->phy.up)
+		{
+			result = eth_mac_start();
+			if (result == ETH_OK)
+			{
+				netif_set_link_up(&network->interface);
+				++network->link_ups;
+#if LWIP_DHCP
+				if (network->address_config.mode != ETH_ADDRESS_STATIC)
+				{
+					network->acquisition_tick = sys_now();
+					network->dhcp_attempted = 0U;
+					network->timeout_reported = 0U;
+					network->address.state = ETH_DHCP_STARTING;
+				}
+#endif
+			}
+		}
+		else if (result == ETH_OK)
+			result = ETH_LINK_DOWN;
+	}
+	else if (result != ETH_OK || statistics.state != ETH_MAC_RUNNING)
+	{
+		EthNetwork_LinkDown(network);
+		(void)eth_mac_get_link(&network->phy);
+		if (result == ETH_OK)
+			result = ETH_STATE;
+	}
+	network->last_driver_result = result;
+}
+
+static err_t EthNetwork_Init(EthNetwork_t *network, const uint8_t mac[6],
+	const ip4_addr_t *ip, const ip4_addr_t *mask, const ip4_addr_t *gateway)
+{
+	if (network == NULL || mac == NULL || ip == NULL || mask == NULL || gateway == NULL)
+		return ERR_ARG;
+	if (s_owner != NULL)
+		return ERR_USE;
+
+	network->last_driver_result = eth_mac_init(mac);
+	if (network->last_driver_result != ETH_OK)
+		return ERR_IF;
+	if (!s_lwip_initialized)
+	{
+		lwip_init();
+		s_lwip_initialized = 1U;
+	}
+	if (netif_add(&network->interface, ip, mask, gateway, &network->port,
+		eth_netif_init, ethernet_input) == NULL)
+		return ERR_IF;
+	s_owner = network;
+	netif_set_default(&network->interface);
+	netif_set_up(&network->interface);
+	network->initialized = 1U;
+	network->service_tick = sys_now() - ETH_NETWORK_SERVICE_MS;
+	return ERR_OK;
+}
+
+#if LWIP_DHCP
+static int EthNetwork_FallbackValid(const EthNetworkAddressConfig_t *config)
+{
+	uint32_t ip = lwip_ntohl(ip4_addr_get_u32(&config->ip));
+	uint32_t mask = lwip_ntohl(ip4_addr_get_u32(&config->mask));
+	uint32_t host = ip & ~mask;
+
+	return ip != 0U && ip != UINT32_MAX && mask != 0U &&
+		ip4_addr_netmask_valid(ip4_addr_get_u32(&config->mask)) &&
+		!ip4_addr_ismulticast(&config->ip) && !ip4_addr_isloopback(&config->ip) &&
+		(~mask < 3U || (host != 0U && host != ~mask));
+}
+
+err_t eth_network_init_address(EthNetwork_t *network, const uint8_t mac[6],
+	const EthNetworkAddressConfig_t *config)
+{
+	err_t result;
+	int use_static;
+
+	if (network == NULL || config == NULL || (config->mode != ETH_ADDRESS_STATIC &&
+		config->mode != ETH_ADDRESS_DHCP && config->mode != ETH_ADDRESS_DHCP_FALLBACK))
+		return ERR_ARG;
+	use_static = config->mode == ETH_ADDRESS_STATIC;
+	if ((!use_static && (!config->timeout_ms || config->timeout_ms > UINT32_C(0x7FFFFFFF))) ||
+		(config->mode == ETH_ADDRESS_DHCP_FALLBACK && !EthNetwork_FallbackValid(config)))
+		return ERR_ARG;
+	result = EthNetwork_Init(network, mac, use_static ? &config->ip : IP4_ADDR_ANY4,
+		use_static ? &config->mask : IP4_ADDR_ANY4, use_static ? &config->gateway : IP4_ADDR_ANY4);
+	if (result == ERR_OK)
+	{
+		network->address_config = *config;
+		network->address.state = use_static ? ETH_DHCP_DISABLED : ETH_DHCP_WAIT_LINK;
+	}
+	return result;
+}
+#endif
+
+err_t eth_network_init(EthNetwork_t *network, const uint8_t mac[6],
+	const ip4_addr_t *ip, const ip4_addr_t *mask, const ip4_addr_t *gateway)
+{
+#if LWIP_DHCP
+	EthNetworkAddressConfig_t config = {.mode = ETH_ADDRESS_STATIC};
+	if (ip == NULL || mask == NULL || gateway == NULL)
+		return ERR_ARG;
+	config.ip = *ip;
+	config.mask = *mask;
+	config.gateway = *gateway;
+	return eth_network_init_address(network, mac, &config);
+#else
+	return EthNetwork_Init(network, mac, ip, mask, gateway);
+#endif
+}
+
+void eth_network_poll(EthNetwork_t *network)
+{
+	uint32_t now;
+
+	if (network == NULL || network != s_owner)
+		return;
+	now = sys_now();
+	if ((uint32_t)(now - network->service_tick) >= ETH_NETWORK_SERVICE_MS)
+	{
+		network->service_tick = now;
+		EthNetwork_Service(network);
+	}
+	eth_netif_poll(&network->interface);
+	sys_check_timeouts();
+#if LWIP_DHCP
+	EthNetwork_AddressPoll(network, sys_now());
+#endif
+}
diff --git a/main-after/Platform/Ethernet/eth_network.h b/main-after/Platform/Ethernet/eth_network.h
new file mode 100644
index 0000000..4e34f9b
--- /dev/null
+++ b/main-after/Platform/Ethernet/eth_network.h
@@ -0,0 +1,88 @@
+//单一执行上下文管理 lwIP、MAC 与 PHY 链路
+#ifndef ETH_NETWORK_H
+#define ETH_NETWORK_H
+
+#include "eth_netif.h"
+
+#if LWIP_DHCP
+typedef enum
+{
+	ETH_ADDRESS_STATIC = 0,
+	ETH_ADDRESS_DHCP,
+	ETH_ADDRESS_DHCP_FALLBACK
+} EthNetworkAddressMode_t;
+
+typedef enum
+{
+	ETH_DHCP_DISABLED = 0,
+	ETH_DHCP_WAIT_LINK,
+	ETH_DHCP_STARTING,
+	ETH_DHCP_SELECTING,
+	ETH_DHCP_REQUESTING,
+	ETH_DHCP_BOUND,
+	ETH_DHCP_RENEWING,
+	ETH_DHCP_REBINDING,
+	ETH_DHCP_FALLBACK,
+	ETH_DHCP_ERROR
+} EthNetworkDhcpState_t;
+
+typedef struct
+{
+	EthNetworkAddressMode_t mode;
+	//STATIC 的配置，或 DHCP_FALLBACK 的显式静态地址
+	ip4_addr_t ip;
+	ip4_addr_t mask;
+	ip4_addr_t gateway;
+	uint32_t timeout_ms;
+} EthNetworkAddressConfig_t;
+
+typedef struct
+{
+	EthNetworkDhcpState_t state;
+	err_t start_result;
+	uint8_t lease_valid;
+	uint8_t lwip_state;
+	ip4_addr_t ip;
+	ip4_addr_t mask;
+	ip4_addr_t gateway;
+	ip4_addr_t server;
+	uint32_t lease_seconds;
+	uint32_t t1_seconds;
+	uint32_t t2_seconds;
+	uint32_t starts;
+	uint32_t timeouts;
+	uint32_t fallbacks;
+} EthNetworkAddressStatus_t;
+#endif
+
+typedef struct
+{
+	struct netif interface;
+	EthNetif_t port;
+	EthLinkState_t phy;
+	EthResult_t last_driver_result;
+	uint32_t link_ups;
+	uint32_t link_downs;
+	uint32_t service_tick;
+	uint8_t initialized;
+#if LWIP_DHCP
+	EthNetworkAddressConfig_t address_config;
+	EthNetworkAddressStatus_t address;
+	uint32_t acquisition_tick;
+	uint32_t last_start_tick;
+	uint8_t dhcp_running;
+	uint8_t dhcp_attempted;
+	uint8_t timeout_reported;
+#endif
+} EthNetwork_t;
+
+//系统只初始化一个默认接口。上下文需零初始化并在程序期间保持有效
+err_t eth_network_init(EthNetwork_t *network, const uint8_t mac[6],
+	const ip4_addr_t *ip, const ip4_addr_t *mask, const ip4_addr_t *gateway);
+#if LWIP_DHCP
+err_t eth_network_init_address(EthNetwork_t *network, const uint8_t mac[6],
+	const EthNetworkAddressConfig_t *config);
+#endif
+void eth_network_poll(EthNetwork_t *network);
+
+#endif
diff --git a/main-after/Platform/Ethernet/eth_phy.c b/main-after/Platform/Ethernet/eth_phy.c
new file mode 100644
index 0000000..a12669d
--- /dev/null
+++ b/main-after/Platform/Ethernet/eth_phy.c
@@ -0,0 +1,76 @@
+//LAN8742A MDIO 基础接口
+#include "eth_phy.h"
+#include <stddef.h>
+
+//内部功能函数声明
+static int EthPhy_Valid(const EthPhy_t *phy);
+
+//对外接口实现
+
+//读取并核对 PHY 器件标识
+EthPhyResult_t eth_phy_probe(
+	const EthPhy_t *phy,
+	uint32_t *id
+)
+{
+	uint16_t identifier_high;
+	uint16_t identifier_low;
+
+	if (!EthPhy_Valid(phy) || id == NULL)
+		return ETH_PHY_ARGUMENT;
+	*id = 0U;
+	if (phy->read(phy->context, phy->address, 2U, &identifier_high) != 0 ||
+		phy->read(phy->context, phy->address, 3U, &identifier_low) != 0)
+		return ETH_PHY_IO;
+	*id = ((uint32_t)identifier_high << 16) | identifier_low;
+	//核对 LAN8742A OUI 和型号，允许不同芯片修订号
+	return ((*id & 0xFFFFFFF0UL) == 0x0007C130UL) ? ETH_PHY_OK : ETH_PHY_ID;
+}
+
+//发起 PHY 软件复位
+EthPhyResult_t eth_phy_reset_begin(const EthPhy_t *phy)
+{
+	if (!EthPhy_Valid(phy))
+		return ETH_PHY_ARGUMENT;
+	return phy->write(phy->context, phy->address, 0U, 0x8000U) == 0 ? ETH_PHY_OK : ETH_PHY_IO;
+}
+
+//非阻塞检查 PHY 复位完成状态
+EthPhyResult_t eth_phy_reset_poll(const EthPhy_t *phy)
+{
+	uint16_t value;
+
+	if (!EthPhy_Valid(phy))
+		return ETH_PHY_ARGUMENT;
+	if (phy->read(phy->context, phy->address, 0U, &value) != 0)
+		return ETH_PHY_IO;
+	return (value & 0x8000U) != 0U ? ETH_PHY_WAIT : ETH_PHY_OK;
+}
+
+//双读状态寄存器取得当前链路状态
+EthPhyResult_t eth_phy_read_link(
+	const EthPhy_t *phy,
+	EthPhyLink_t *link
+)
+{
+	uint16_t value;
+
+	if (!EthPhy_Valid(phy) || link == NULL)
+		return ETH_PHY_ARGUMENT;
+	link->up = 0U;
+	link->autoneg_complete = 0U;
+	if (phy->read(phy->context, phy->address, 1U, &value) != 0 ||
+		phy->read(phy->context, phy->address, 1U, &value) != 0)
+		return ETH_PHY_IO;
+	link->up = (uint8_t)((value & 4U) != 0U);
+	link->autoneg_complete = (uint8_t)((value & 32U) != 0U);
+	return ETH_PHY_OK;
+}
+
+//内部功能函数实现
+
+//检查 MDIO 回调及 PHY 地址
+static int EthPhy_Valid(const EthPhy_t *phy)
+{
+	return phy != NULL && phy->read != NULL && phy->write != NULL && phy->address < 32U;
+}
diff --git a/main-after/Platform/Ethernet/eth_phy.h b/main-after/Platform/Ethernet/eth_phy.h
new file mode 100644
index 0000000..5428222
--- /dev/null
+++ b/main-after/Platform/Ethernet/eth_phy.h
@@ -0,0 +1,55 @@
+//LAN8742A MDIO 基础接口
+#ifndef ETH_PHY_H
+#define ETH_PHY_H
+
+#include <stdint.h>
+//MDIO 回调成功返回 0，硬件等待必须有界
+//所有操作由调用者串行执行，包括复位和链路轮询
+typedef struct
+{
+	//回调上下文，由调用者管理
+	void *context;
+	int (*read)(void *context, uint8_t address, uint8_t reg, uint16_t *value);
+	int (*write)(void *context, uint8_t address, uint8_t reg, uint16_t value);
+	//板级 PHY 地址
+	uint8_t address;
+} EthPhy_t;
+typedef enum
+{
+	ETH_PHY_OK = 0,
+	ETH_PHY_IO = -1,
+	ETH_PHY_ARGUMENT = -2,
+	ETH_PHY_ID = -3,
+	ETH_PHY_WAIT = 1
+} EthPhyResult_t;
+typedef struct
+{
+	//当前物理链路状态
+	uint8_t up;
+	//自动协商完成标志
+	uint8_t autoneg_complete;
+} EthPhyLink_t;
+
+//只探测板级指定地址，不自动选择其他 PHY
+EthPhyResult_t eth_phy_probe(
+	const EthPhy_t *phy,
+	uint32_t *id
+);
+
+//仅执行软件复位，硬件复位时序及 strap 由板级负责
+EthPhyResult_t eth_phy_reset_begin(const EthPhy_t *phy);
+
+EthPhyResult_t eth_phy_reset_poll(const EthPhy_t *phy);
+
+//双读 BSR 清除锁存低位，不推断协商速率或双工模式
+EthPhyResult_t eth_phy_read_link(
+	const EthPhy_t *phy,
+	EthPhyLink_t *link
+);
+
+//保留已有类型名，避免破坏现有 PHY 和收发调用接口
+typedef EthPhy_t eth_phy;
+typedef EthPhyResult_t eth_phy_result;
+typedef EthPhyLink_t eth_phy_link;
+
+#endif
diff --git a/main-after/Platform/Ethernet/eth_tcp.c b/main-after/Platform/Ethernet/eth_tcp.c
new file mode 100644
index 0000000..0764478
--- /dev/null
+++ b/main-after/Platform/Ethernet/eth_tcp.c
@@ -0,0 +1,491 @@
+//TCP服务端和客户端各使用一个连接，连接句柄不暴露lwIP PCB
+#include "eth_tcp.h"
+#include "lwip/tcp.h"
+#include "lwip/sys.h"
+#include <string.h>
+
+#define ETH_TCP_RETRY_MS 20U
+#define ETH_TCP_CONNECT_MS 10000U
+#define ETH_TCP_CLOSE_MS 5000U
+
+typedef struct
+{
+    struct tcp_pcb *pcb;
+    uint8_t rx[ETH_TCP_QUEUE_BYTES];
+    uint8_t tx[ETH_TCP_QUEUE_BYTES];
+    uint16_t rx_head;
+    uint16_t tx_head;
+    uint32_t generation;
+    uint32_t activity;
+    uint32_t deadline;
+    uint32_t attempt;
+    unsigned events;
+    uint8_t peer_fin;
+    uint8_t output_pending;
+    uint8_t fast_send;
+    EthTcpStats_t stats;
+} EthTcpConnection_t;
+
+static struct tcp_pcb *s_listener;
+static EthTcpConnection_t s_connections[ETH_TCP_ROLES];
+static EthTcpEvent_t s_notify;
+static void *s_notify_arg;
+static uint32_t s_idle_ms;
+
+static int EthTcp_Due(uint32_t now, uint32_t due)
+{
+    return (uint32_t)(now - due) < UINT32_C(0x80000000);
+}
+
+//按角色和代次查找连接
+static EthTcpConnection_t *EthTcp_Connection(EthTcpHandle_t handle)
+{
+    if ((unsigned)handle.role >= ETH_TCP_ROLES ||
+        s_connections[handle.role].generation != handle.generation)
+        return NULL;
+    return &s_connections[handle.role];
+}
+
+static void EthTcp_Clear(EthTcpConnection_t *connection, err_t error)
+{
+    connection->pcb = NULL;
+    connection->stats.state = ETH_TCP_IDLE;
+    connection->stats.tx_pending = 0U;
+    connection->stats.rx_pending = 0U;
+    connection->stats.unacked = 0U;
+    connection->stats.last_error = error;
+    connection->rx_head = 0U;
+    connection->tx_head = 0U;
+    connection->peer_fin = 0U;
+    connection->output_pending = 0U;
+    ++connection->stats.closes;
+    if (error != ERR_OK)
+        ++connection->stats.errors;
+    connection->events |= ETH_TCP_EVENT_CLOSED;
+}
+
+static void EthTcp_Error(void *arg, err_t error)
+{
+    //错误回调进入时旧 PCB 已失效
+    EthTcp_Clear(arg, error);
+}
+
+static err_t EthTcp_Receive(void *arg, struct tcp_pcb *pcb, struct pbuf *packet, err_t error)
+{
+    EthTcpConnection_t *connection = arg;
+    uint16_t tail;
+    uint16_t first;
+    uint16_t length;
+    (void)pcb;
+
+    if (error != ERR_OK)
+        return error;
+    connection->activity = sys_now();
+    if (!packet)
+    {
+        connection->peer_fin = 1U;
+        connection->events |= ETH_TCP_EVENT_FIN;
+        connection->deadline = connection->activity + ETH_TCP_CLOSE_MS;
+        return ERR_OK;
+    }
+    length = packet->tot_len;
+    if (length > ETH_TCP_QUEUE_BYTES - connection->stats.rx_pending)
+    {
+        ++connection->stats.recv_full;
+        return ERR_MEM; //保留pbuf与接收窗口，等待lwIP重新交付
+    }
+    tail = (uint16_t)((connection->rx_head + connection->stats.rx_pending) % ETH_TCP_QUEUE_BYTES);
+    first = (uint16_t)(ETH_TCP_QUEUE_BYTES - tail);
+    if (first > length)
+        first = length;
+    if (pbuf_copy_partial(packet, connection->rx + tail, first, 0U) != first ||
+        pbuf_copy_partial(packet, connection->rx, (uint16_t)(length - first), first) != length - first)
+        return ERR_MEM;
+    connection->stats.rx_pending += length;
+    if (connection->stats.rx_pending > connection->stats.rx_peak)
+        connection->stats.rx_peak = connection->stats.rx_pending;
+    connection->stats.received += length;
+    connection->events |= ETH_TCP_EVENT_READ;
+    pbuf_free(packet);
+    return ERR_OK;
+}
+
+static err_t EthTcp_Sent(void *arg, struct tcp_pcb *pcb, u16_t length)
+{
+    EthTcpConnection_t *connection = arg;
+    (void)pcb;
+    if (length > connection->stats.unacked)
+        length = connection->stats.unacked;
+    connection->stats.unacked -= length;
+    connection->stats.acked += length;
+    connection->activity = sys_now();
+    connection->attempt = connection->activity;
+    connection->events |= ETH_TCP_EVENT_ACK;
+    return ERR_OK;
+}
+
+static err_t EthTcp_RawPoll(void *arg, struct tcp_pcb *pcb)
+{
+    EthTcpConnection_t *connection = arg;
+    (void)pcb;
+    connection->attempt = sys_now();
+    return ERR_OK;
+}
+
+static void EthTcp_Callbacks(EthTcpConnection_t *connection, int attach)
+{
+    struct tcp_pcb *pcb = connection->pcb;
+    tcp_arg(pcb, attach ? connection : NULL);
+    tcp_recv(pcb, attach ? EthTcp_Receive : NULL);
+    tcp_sent(pcb, attach ? EthTcp_Sent : NULL);
+    tcp_err(pcb, attach ? EthTcp_Error : NULL);
+    tcp_poll(pcb, attach ? EthTcp_RawPoll : NULL, 2U);
+}
+
+static void EthTcp_Abort(EthTcpConnection_t *connection, err_t error)
+{
+    if (connection->pcb)
+    {
+        EthTcp_Callbacks(connection, 0);
+        tcp_abort(connection->pcb);
+        EthTcp_Clear(connection, error);
+    }
+}
+
+//分配新连接并更新代次，清除前一连接的发送策略
+static void EthTcp_Assign(EthTcpConnection_t *connection, struct tcp_pcb *pcb, EthTcpState_t state)
+{
+    connection->pcb = pcb;
+    connection->fast_send = 0U;
+    ++connection->generation;
+    if (!connection->generation)
+        ++connection->generation;
+    connection->stats.state = state;
+    connection->stats.last_error = ERR_OK;
+    connection->activity = sys_now();
+    connection->attempt = connection->activity;
+    connection->deadline = connection->activity + ETH_TCP_CONNECT_MS;
+    connection->events = 0U;
+    EthTcp_Callbacks(connection, 1);
+}
+
+static void EthTcp_Opened(EthTcpConnection_t *connection)
+{
+    connection->stats.state = ETH_TCP_OPEN;
+    connection->activity = sys_now();
+    ++connection->stats.opens;
+    connection->events |= ETH_TCP_EVENT_OPEN;
+}
+
+static err_t EthTcp_Connected(void *arg, struct tcp_pcb *pcb, err_t error)
+{
+    (void)pcb;
+    if (error == ERR_OK)
+        EthTcp_Opened(arg);
+    return error;
+}
+
+static err_t EthTcp_Accept(void *arg, struct tcp_pcb *pcb, err_t error)
+{
+    EthTcpConnection_t *connection = &s_connections[ETH_TCP_SERVER];
+    (void)arg;
+    if (error != ERR_OK || !pcb)
+        return error;
+    if (connection->pcb)
+    {
+        ++connection->stats.rejected;
+        tcp_abort(pcb);
+        return ERR_ABRT;
+    }
+    EthTcp_Assign(connection, pcb, ETH_TCP_OPEN);
+    EthTcp_Opened(connection);
+    return ERR_OK;
+}
+
+err_t eth_tcp_configure(EthTcpEvent_t callback, void *arg, uint32_t idle_timeout_ms)
+{
+    if (s_listener || s_connections[ETH_TCP_SERVER].pcb || s_connections[ETH_TCP_CLIENT].pcb)
+        return ERR_USE;
+    if (idle_timeout_ms >= UINT32_C(0x80000000))
+        return ERR_ARG;
+    s_notify = callback;
+    s_notify_arg = arg;
+    s_idle_ms = idle_timeout_ms;
+    return ERR_OK;
+}
+
+err_t eth_tcp_server_start(struct netif *netif, uint16_t port)
+{
+    struct tcp_pcb *pcb;
+    err_t result;
+    if (!netif || !port)
+        return ERR_ARG;
+    if (s_listener)
+        return ERR_USE;
+    pcb = tcp_new_ip_type(IPADDR_TYPE_V4);
+    if (!pcb)
+        return ERR_MEM;
+    //链路恢复或地址变化后重新绑定监听，旧连接可能仍处于TIME_WAIT
+#if SO_REUSE
+    ip_set_option(pcb, SOF_REUSEADDR);
+#endif
+    tcp_bind_netif(pcb, netif);
+    result = tcp_bind(pcb, netif_ip4_addr(netif), port);
+    if (result == ERR_OK)
+        s_listener = tcp_listen_with_backlog_and_err(pcb, 1U, &result);
+    if (!s_listener)
+    {
+        tcp_abort(pcb);
+        return result;
+    }
+    tcp_accept(s_listener, EthTcp_Accept);
+    return ERR_OK;
+}
+
+err_t eth_tcp_client_connect(struct netif *netif, const ip4_addr_t *peer, uint16_t port)
+{
+    struct tcp_pcb *pcb;
+    err_t result;
+    EthTcpConnection_t *connection = &s_connections[ETH_TCP_CLIENT];
+    if (!netif || !peer || !port || ip4_addr_isany(peer))
+        return ERR_ARG;
+    if (connection->pcb)
+        return ERR_ISCONN;
+    pcb = tcp_new_ip_type(IPADDR_TYPE_V4);
+    if (!pcb)
+        return ERR_MEM;
+    tcp_bind_netif(pcb, netif);
+    EthTcp_Assign(connection, pcb, ETH_TCP_CONNECTING);
+    result = tcp_connect(pcb, peer, port, EthTcp_Connected);
+    if (result != ERR_OK)
+        EthTcp_Abort(connection, result);
+    return result;
+}
+
+void eth_tcp_stop(void)
+{
+    unsigned role;
+    for (role = 0; role < ETH_TCP_ROLES; ++role)
+        EthTcp_Abort(&s_connections[role], ERR_RTE);
+    if (s_listener)
+    {
+        tcp_close(s_listener);
+        s_listener = NULL;
+    }
+}
+
+//处理一个连接的超时、排空及发送重试
+static void EthTcp_PollConnection(EthTcpConnection_t *connection, uint32_t now)
+{
+    EthTcpStats_t *stats = &connection->stats;
+    struct tcp_pcb *pcb = connection->pcb;
+    err_t result;
+    uint16_t count;
+    int retry = 0;
+
+    if (!pcb)
+        return;
+    if (stats->state == ETH_TCP_CONNECTING)
+    {
+        if (EthTcp_Due(now, connection->deadline))
+        {
+            ++stats->timeouts;
+            EthTcp_Abort(connection, ERR_TIMEOUT);
+        }
+        return;
+    }
+    if ((stats->state == ETH_TCP_DRAINING || connection->peer_fin) ?
+        EthTcp_Due(now, connection->deadline) :
+        (s_idle_ms && (uint32_t)(now - connection->activity) >= s_idle_ms))
+    {
+        ++stats->timeouts;
+        EthTcp_Abort(connection, ERR_TIMEOUT);
+        return;
+    }
+    if (!EthTcp_Due(now, connection->attempt))
+        return;
+    connection->attempt = now + ETH_TCP_RETRY_MS;
+    if ((stats->state == ETH_TCP_DRAINING || connection->peer_fin) &&
+        !stats->tx_pending && !stats->unacked && !stats->rx_pending)
+    {
+        EthTcp_Callbacks(connection, 0);
+        result = tcp_close(pcb);
+        if (result == ERR_OK)
+            EthTcp_Clear(connection, ERR_OK);
+        else
+        {
+            EthTcp_Callbacks(connection, 1);
+            if (result == ERR_MEM)
+                ++stats->close_mem;
+            else
+                EthTcp_Abort(connection, result);
+        }
+        return;
+    }
+    count = stats->tx_pending;
+    if (count > tcp_sndbuf(pcb))
+        count = tcp_sndbuf(pcb);
+    if (count > ETH_TCP_QUEUE_BYTES - connection->tx_head)
+        count = (uint16_t)(ETH_TCP_QUEUE_BYTES - connection->tx_head);
+    if (count > TCP_MSS)
+        count = TCP_MSS;
+    if (count && tcp_sndqueuelen(pcb) < TCP_SND_QUEUELEN)
+    {
+        result = tcp_write(pcb, connection->tx + connection->tx_head, count, TCP_WRITE_FLAG_COPY);
+        if (result == ERR_OK)
+        {
+            connection->tx_head = (uint16_t)((connection->tx_head + count) % ETH_TCP_QUEUE_BYTES);
+            stats->tx_pending -= count;
+            stats->queued_lwip += count;
+            stats->unacked += count;
+            if (stats->unacked > stats->unacked_peak)
+                stats->unacked_peak = stats->unacked;
+            connection->output_pending = 1U;
+        }
+        else if (result == ERR_MEM)
+        {
+            ++stats->write_mem;
+            retry = 1;
+        }
+        else
+        {
+            EthTcp_Abort(connection, result);
+            return;
+        }
+    }
+    else if (stats->tx_pending)
+        retry = 1;
+    if (connection->output_pending)
+    {
+        result = tcp_output(pcb);
+        if (result == ERR_OK)
+            connection->output_pending = 0U;
+        else
+        {
+            ++stats->output_errors;
+            retry = 1;
+        }
+    }
+    //成功提交后允许下一轮继续，发送窗口或队列受限时保留重试间隔
+    if (connection->fast_send && !retry && stats->state == ETH_TCP_OPEN && !connection->peer_fin)
+        connection->attempt = now;
+}
+
+void eth_tcp_poll(void)
+{
+    unsigned role;
+    for (role = 0; role < ETH_TCP_ROLES; ++role)
+    {
+        EthTcpConnection_t *connection = &s_connections[role];
+        unsigned events;
+        EthTcp_PollConnection(connection, sys_now());
+        events = connection->events;
+        connection->events = 0;
+        if (events && s_notify)
+            s_notify(eth_tcp_handle((EthTcpRole_t)role), events, s_notify_arg);
+    }
+}
+
+EthTcpHandle_t eth_tcp_handle(EthTcpRole_t role)
+{
+    EthTcpHandle_t handle;
+    handle.role = role;
+    handle.generation = (unsigned)role < ETH_TCP_ROLES ? s_connections[role].generation : 0U;
+    return handle;
+}
+
+EthTcpState_t eth_tcp_get_state(EthTcpHandle_t handle)
+{
+    EthTcpConnection_t *connection = EthTcp_Connection(handle);
+    return connection ? connection->stats.state : ETH_TCP_IDLE;
+}
+
+err_t eth_tcp_enable_fast_send(EthTcpHandle_t handle)
+{
+    EthTcpConnection_t *connection = EthTcp_Connection(handle);
+    if (!connection || !connection->pcb || connection->stats.state != ETH_TCP_OPEN)
+        return ERR_CONN;
+    connection->fast_send = 1U;
+    connection->attempt = sys_now();
+    return ERR_OK;
+}
+
+err_t eth_tcp_send(EthTcpHandle_t handle, const void *data, uint16_t length)
+{
+    EthTcpConnection_t *connection = EthTcp_Connection(handle);
+    uint16_t tail;
+    uint16_t first;
+    if (!data || !length || length > ETH_TCP_QUEUE_BYTES)
+        return ERR_ARG;
+    if (!connection || !connection->pcb || connection->stats.state != ETH_TCP_OPEN)
+        return ERR_CONN;
+    if (length > ETH_TCP_QUEUE_BYTES - connection->stats.tx_pending)
+    {
+        ++connection->stats.send_full;
+        return ERR_MEM;
+    }
+    tail = (uint16_t)((connection->tx_head + connection->stats.tx_pending) % ETH_TCP_QUEUE_BYTES);
+    first = (uint16_t)(ETH_TCP_QUEUE_BYTES - tail);
+    if (first > length)
+        first = length;
+    memcpy(connection->tx + tail, data, first);
+    memcpy(connection->tx, (const uint8_t *)data + first, length - first);
+    connection->stats.tx_pending += length;
+    if (connection->stats.tx_pending > connection->stats.tx_peak)
+        connection->stats.tx_peak = connection->stats.tx_pending;
+    connection->stats.submitted += length;
+    return ERR_OK;
+}
+
+uint16_t eth_tcp_read(EthTcpHandle_t handle, void *data, uint16_t capacity)
+{
+    EthTcpConnection_t *connection = EthTcp_Connection(handle);
+    uint16_t first;
+    if (!connection || !connection->pcb || !data || !capacity)
+        return 0U;
+    if (capacity > connection->stats.rx_pending)
+        capacity = connection->stats.rx_pending;
+    first = (uint16_t)(ETH_TCP_QUEUE_BYTES - connection->rx_head);
+    if (first > capacity)
+        first = capacity;
+    memcpy(data, connection->rx + connection->rx_head, first);
+    memcpy((uint8_t *)data + first, connection->rx, capacity - first);
+    connection->rx_head = (uint16_t)((connection->rx_head + capacity) % ETH_TCP_QUEUE_BYTES);
+    connection->stats.rx_pending -= capacity;
+    connection->stats.read += capacity;
+    if (capacity)
+        tcp_recved(connection->pcb, capacity);
+    return capacity;
+}
+
+err_t eth_tcp_close(EthTcpHandle_t handle)
+{
+    EthTcpConnection_t *connection = EthTcp_Connection(handle);
+    if (!connection || !connection->pcb)
+        return ERR_CONN;
+    if (connection->stats.state == ETH_TCP_DRAINING)
+        return ERR_ALREADY;
+    if (connection->stats.state != ETH_TCP_OPEN)
+        return ERR_INPROGRESS;
+    connection->stats.state = ETH_TCP_DRAINING;
+    connection->deadline = sys_now() + ETH_TCP_CLOSE_MS;
+    return ERR_OK;
+}
+
+void eth_tcp_abort(EthTcpHandle_t handle)
+{
+    EthTcpConnection_t *connection = EthTcp_Connection(handle);
+    if (connection)
+        EthTcp_Abort(connection, ERR_ABRT);
+}
+
+void eth_tcp_get_statistics(EthTcpRole_t role, EthTcpStats_t *stats)
+{
+    if (stats && (unsigned)role < ETH_TCP_ROLES)
+        *stats = s_connections[role].stats;
+}
+
+int eth_tcp_listening(void)
+{
+    return s_listener != NULL;
+}
diff --git a/main-after/Platform/Ethernet/eth_tcp.h b/main-after/Platform/Ethernet/eth_tcp.h
new file mode 100644
index 0000000..75d2fa0
--- /dev/null
+++ b/main-after/Platform/Ethernet/eth_tcp.h
@@ -0,0 +1,112 @@
+#ifndef ETH_TCP_PORT_H
+#define ETH_TCP_PORT_H
+
+#include "lwip/netif.h"
+
+#define ETH_TCP_QUEUE_BYTES 2920U
+
+typedef enum
+{
+    ETH_TCP_SERVER = 0,
+    ETH_TCP_CLIENT,
+    ETH_TCP_ROLES
+} EthTcpRole_t;
+
+typedef enum
+{
+    ETH_TCP_IDLE = 0,
+    ETH_TCP_CONNECTING,
+    ETH_TCP_OPEN,
+    ETH_TCP_DRAINING
+} EthTcpState_t;
+
+typedef struct
+{
+    EthTcpRole_t role;
+    //连接分配时更新，旧句柄不能操作新连接
+    uint32_t generation;
+} EthTcpHandle_t;
+
+enum
+{
+    ETH_TCP_EVENT_OPEN = 1,
+    ETH_TCP_EVENT_READ = 2,
+    ETH_TCP_EVENT_ACK = 4,
+    ETH_TCP_EVENT_FIN = 8,
+    ETH_TCP_EVENT_CLOSED = 16
+};
+
+typedef void (*EthTcpEvent_t)(EthTcpHandle_t handle, unsigned events, void *arg);
+typedef struct
+{
+    uint32_t opens;
+    uint32_t closes;
+    uint32_t errors;
+    uint32_t timeouts;
+    uint32_t rejected;
+    uint32_t submitted;
+    uint32_t queued_lwip;
+    //对端确认的累计字节数
+    uint32_t acked;
+    uint32_t received;
+    uint32_t read;
+    uint32_t send_full;
+    uint32_t write_mem;
+    uint32_t recv_full;
+    uint32_t close_mem;
+    uint32_t output_errors;
+    //应用发送环待提交字节数
+    uint16_t tx_pending;
+    uint16_t rx_pending;
+    //已交给lwIP但仍待确认的字节数
+    uint16_t unacked;
+    uint16_t tx_peak;
+    uint16_t rx_peak;
+    uint16_t unacked_peak;
+    err_t last_error;
+    EthTcpState_t state;
+} EthTcpStats_t;
+
+//配置连接事件回调和空闲超时，超时单位ms
+err_t eth_tcp_configure(EthTcpEvent_t callback, void *arg, uint32_t idle_timeout_ms);
+
+//在当前IPv4地址上建立监听
+err_t eth_tcp_server_start(struct netif *netif, uint16_t port);
+
+//向指定IPv4地址和端口发起异步连接
+err_t eth_tcp_client_connect(struct netif *netif, const ip4_addr_t *peer, uint16_t port);
+
+//停止监听并终止现有连接
+void eth_tcp_stop(void);
+
+//推进发送、关闭及超时，在网口轮询的同一上下文调用
+void eth_tcp_poll(void);
+
+//读取当前连接代次，连接重建后旧句柄失效
+EthTcpHandle_t eth_tcp_handle(EthTcpRole_t role);
+
+//读取连接状态，旧句柄返回空闲
+EthTcpState_t eth_tcp_get_state(EthTcpHandle_t handle);
+
+//允许当前连接在成功提交后继续发送，资源不足时保留重试间隔
+err_t eth_tcp_enable_fast_send(EthTcpHandle_t handle);
+
+//复制数据到内部环，成功返回后调用者可立即复用源缓冲
+err_t eth_tcp_send(EthTcpHandle_t handle, const void *data, uint16_t length);
+
+//复制可用数据并归还接收窗口，返回实际读取字节数
+uint16_t eth_tcp_read(EthTcpHandle_t handle, void *data, uint16_t capacity);
+
+//申请有序关闭，已提交的数据留待排空
+err_t eth_tcp_close(EthTcpHandle_t handle);
+
+//立即终止有效连接
+void eth_tcp_abort(EthTcpHandle_t handle);
+
+//读取指定角色的计数快照
+void eth_tcp_get_statistics(EthTcpRole_t role, EthTcpStats_t *stats);
+
+//查询服务端是否已有监听PCB
+int eth_tcp_listening(void);
+
+#endif
diff --git a/main-after/Platform/Ethernet/eth_transport.c b/main-after/Platform/Ethernet/eth_transport.c
new file mode 100644
index 0000000..a392a24
--- /dev/null
+++ b/main-after/Platform/Ethernet/eth_transport.c
@@ -0,0 +1,110 @@
+#include "eth_transport.h"
+#include "lwip/sys.h"
+
+static EthNetwork_t *s_network;
+static EthTransportConfig_t s_config;
+static EthTransportStats_t s_stats;
+static ip4_addr_t s_address;
+static uint32_t s_service_tick, s_client_tick;
+static uint8_t s_udp, s_server, s_client_wait;
+
+err_t eth_transport_init(EthNetwork_t *network, const EthTransportConfig_t *config)
+{
+	err_t result;
+	if (s_network)
+		return ERR_USE;
+	if (!network || !network->initialized || !config ||
+		(config->udp_port && !config->udp_receive) ||
+		(config->client_port && ip4_addr_isany(&config->client_ip)) ||
+		(config->reconnect_ms && (config->reconnect_ms < 100U || config->reconnect_ms > 3600000U)))
+		return ERR_ARG;
+	result = eth_tcp_configure(config->tcp_event, config->arg, config->idle_ms);
+	if (result != ERR_OK)
+		return result;
+	s_config = *config;
+	s_network = network;
+	return ERR_OK;
+}
+
+void eth_transport_poll(void)
+{
+	struct netif *interface;
+	uint32_t now;
+	int ready;
+	if (!s_network)
+		return;
+	interface = &s_network->interface;
+	now = sys_now();
+	ready = netif_is_up(interface) && netif_is_link_up(interface) &&
+		!ip4_addr_isany(netif_ip4_addr(interface));
+	if (s_stats.ready && (!ready || !ip4_addr_cmp(&s_address, netif_ip4_addr(interface))))
+	{
+		eth_udp_stop();
+		eth_tcp_stop();
+		s_udp = s_server = 0U;
+		s_stats.ready = 0U;
+		++s_stats.link_lost;
+	}
+	eth_tcp_poll();
+	if (!ready)
+		return;
+	if (!s_stats.ready)
+	{
+		s_stats.ready = 1U;
+		s_address = *netif_ip4_addr(interface);
+		++s_stats.link_ready;
+		s_service_tick = now - 1000U;
+		s_client_wait = 0U;
+	}
+	if ((uint32_t)(now - s_service_tick) >= 1000U)
+	{
+		s_service_tick = now;
+		if (s_config.udp_port && !s_udp)
+		{
+			s_stats.udp_start = eth_udp_start(interface, s_config.udp_port,
+				s_config.udp_receive, s_config.arg);
+			s_udp = (uint8_t)(s_stats.udp_start == ERR_OK);
+		}
+		if (s_config.listen_port && !s_server)
+		{
+			s_stats.server_start = eth_tcp_server_start(interface, s_config.listen_port);
+			s_server = (uint8_t)(s_stats.server_start == ERR_OK);
+		}
+	}
+	if (s_config.client_port && eth_tcp_get_state(eth_tcp_handle(ETH_TCP_CLIENT)) == ETH_TCP_IDLE)
+	{
+		if (!s_client_wait)
+		{
+			++s_stats.client_attempts;
+			s_stats.client_start = eth_tcp_client_connect(interface, &s_config.client_ip,
+				s_config.client_port);
+			s_client_tick = now;
+			s_client_wait = 1U;
+		}
+		else if (s_config.reconnect_ms && (uint32_t)(now - s_client_tick) >= s_config.reconnect_ms)
+			s_client_wait = 0U;
+	}
+	else
+		s_client_tick = now; //重连间隔从连接结束计算
+}
+
+void eth_transport_get_statistics(EthTransportStats_t *stats)
+{
+	unsigned role;
+	if (!stats)
+		return;
+	*stats = s_stats;
+	stats->listening = (uint8_t)eth_tcp_listening();
+	for (role = 0U; role < ETH_TCP_ROLES; ++role)
+	{
+		eth_tcp_get_statistics((EthTcpRole_t)role, &stats->tcp[role]);
+		if (stats->tcp[role].state != ETH_TCP_IDLE)
+			++stats->connections;
+	}
+	eth_udp_get_statistics(&stats->udp);
+}
+
+int eth_transport_ready(void)
+{
+	return s_stats.ready != 0U;
+}
