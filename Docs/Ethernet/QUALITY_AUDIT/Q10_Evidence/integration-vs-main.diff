+
+EthResult_t eth_mac_get_link(EthLinkState_t *link)
+{
+	memset(link, 0, sizeof(*link));
+	link->up = s_link;
+	link->autoneg_complete = (uint8_t)(s_link && s_negotiation == ETH_OK);
