++#define UPAPSS_PENDING	2	/* Connection down, have requested auth */
++#define UPAPSS_LISTEN	3	/* Listening for an Authenticate */
++#define UPAPSS_OPEN	4	/* We've sent an Ack */
++#define UPAPSS_BADAUTH	5	/* We've sent a Nak */
