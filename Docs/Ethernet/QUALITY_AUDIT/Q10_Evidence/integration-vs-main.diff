++		region_start = region_base & ~(region_size - 1U);
++		if (region_start < ETH_DMA_BASE + ETH_DMA_WINDOW &&
++			region_start + region_size > ETH_DMA_BASE)
++			memory_valid = 0;
++	}
++	MPU->RNR = previous_region;
++	__set_PRIMASK(primask);
++	return memory_valid;
++}
