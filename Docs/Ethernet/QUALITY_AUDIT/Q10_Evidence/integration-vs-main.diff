diff --git a/main-after/Tests/Ethernet/eth_test_rx.c b/main-after/Tests/Ethernet/eth_test_rx.c
new file mode 100644
index 0000000..69602e8
--- /dev/null
+++ b/main-after/Tests/Ethernet/eth_test_rx.c
@@ -0,0 +1,82 @@
+//测试层逐帧校验，不改变驱动所有权或中断处理
+#include "eth_test_rx.h"
+#include <string.h>
+volatile EthTestRxStatistics_t g_eth_test_rx_check;
+static uint8_t s_seen[(ETH_TEST_RX_LIMIT + 7U) / 8U];
+static const uint8_t s_destination[6] = {2U, 0x47U, 0x47U, 0U, 0U, 1U};
+static const uint8_t s_source[6] = {0xECU, 0x1AU, 0xC3U, 0x3EU, 0xDBU, 0xB2U};
+//新一轮固定从序号 1 开始，背景帧单独计数
+void EthTestRx_Reset(void)
+{
+	EthTestRxStatistics_t empty = {0};
+
+	g_eth_test_rx_check = empty;
+	memset(s_seen, 0, sizeof(s_seen));
+	g_eth_test_rx_check.missing = ETH_TEST_RX_LIMIT;
+	g_eth_test_rx_check.active = 1U;
+}
+//仅在任务已复制完有效帧后检查完整内容
+void EthTestRx_Inspect(
+	const uint8_t *data,
+	size_t length
+)
+{
+	uint32_t sequence;
+	uint32_t index;
+	uint8_t mask;
+	size_t i;
+
+	if (!g_eth_test_rx_check.active)
+		return;
+	if (!data || length < 14U || memcmp(data, s_destination, 6U) != 0 ||
+		memcmp(data + 6, s_source, 6U) != 0 || data[12] != 0x88U || data[13] != 0xB5U)
+	{
+		++g_eth_test_rx_check.ignored;
+		return;
+	}
+	++g_eth_test_rx_check.received;
+	if (length != 60U)
+	{
+		++g_eth_test_rx_check.bad;
+		return;
+	}
+	sequence = ((uint32_t)data[14] << 24) | ((uint32_t)data[15] << 16) | ((uint32_t)data[16] << 8) |
+		data[17];
+	if (sequence == 0U || sequence > ETH_TEST_RX_LIMIT)
+	{
+		++g_eth_test_rx_check.bad;
+		return;
+	}
+	for (i = 18U;
+		 i < length;
+		 ++i)
+	{
+		if (data[i] != (uint8_t)(i - 18U))
+		{
+			++g_eth_test_rx_check.bad;
+			return;
+		}
+	}
+	index = sequence - 1U;
+	mask = (uint8_t)(1U << (index % 8U));
+	if ((s_seen[index / 8U] & mask) != 0U)
+	{
+		++g_eth_test_rx_check.duplicates;
+		return;
+	}
+	s_seen[index / 8U] |= mask;
+	if (sequence < g_eth_test_rx_check.last_sequence)
+		++g_eth_test_rx_check.out_of_order;
+	else
+		g_eth_test_rx_check.last_sequence = sequence;
+	++g_eth_test_rx_check.unique;
+	g_eth_test_rx_check.missing = ETH_TEST_RX_LIMIT - g_eth_test_rx_check.unique;
+}
+//显式结束采样，只有全部正确且无重复或乱序才能通过
+void EthTestRx_Finish(void)
+{
+	g_eth_test_rx_check.active = 0U;
+	g_eth_test_rx_check.passed =
+		(g_eth_test_rx_check.unique == ETH_TEST_RX_LIMIT && g_eth_test_rx_check.bad == 0U &&
+			g_eth_test_rx_check.duplicates == 0U && g_eth_test_rx_check.out_of_order == 0U);
+}
diff --git a/main-after/Tests/Ethernet/eth_test_rx.h b/main-after/Tests/Ethernet/eth_test_rx.h
new file mode 100644
index 0000000..afc694c
--- /dev/null
+++ b/main-after/Tests/Ethernet/eth_test_rx.h
@@ -0,0 +1,28 @@
+//固定内容测试帧校验，只用于实板验收固件
+#ifndef ETH_TEST_RX_H
+#define ETH_TEST_RX_H
+
+#include <stddef.h>
+#include <stdint.h>
+#define ETH_TEST_RX_LIMIT 1000U
+typedef struct
+{
+	uint32_t received;
+	uint32_t unique;
+	uint32_t bad;
+	uint32_t duplicates;
+	uint32_t out_of_order;
+	uint32_t missing;
+	uint32_t last_sequence;
+	uint32_t ignored;
+	uint32_t active;
+	uint32_t passed;
+} EthTestRxStatistics_t;
+extern volatile EthTestRxStatistics_t g_eth_test_rx_check;
+void EthTestRx_Reset(void);
+void EthTestRx_Inspect(
+	const uint8_t *data,
+	size_t length
+);
+void EthTestRx_Finish(void);
+#endif
diff --git a/main-after/Tests/Ethernet/fake_hal.h b/main-after/Tests/Ethernet/fake_hal.h
new file mode 100644
index 0000000..4fde711
--- /dev/null
+++ b/main-after/Tests/Ethernet/fake_hal.h
@@ -0,0 +1,161 @@
+/* Numeric register constants expanded from this repo's STM32H747 CMSIS.
+ * Test-only register model; does not emulate bus timing or hardware DMA. */
+#ifndef ETH_TEST_FAKE_HAL_H
+#define ETH_TEST_FAKE_HAL_H
+#include <stdint.h>
+#include <stddef.h>
+#define ETH_DMACCR_DSL_128BIT (0x00100000U)
+#define ETH_DMACIER_AIE (0x1UL << (14U))
+#define ETH_DMACIER_CDEE (0x1UL << (13U))
+#define ETH_DMACIER_FBEE (0x1UL << (12U))
+#define ETH_DMACIER_NIE (0x1UL << (15U))
+#define ETH_DMACIER_RBUE (0x1UL << (7U))
+#define ETH_DMACIER_RIE (0x1UL << (6U))
+#define ETH_DMACIER_RSE (0x1UL << (8U))
+#define ETH_DMACIER_TBUE (0x1UL << (2U))
+#define ETH_DMACIER_TIE (0x1UL << (0U))
+#define ETH_DMACIER_TXSE (0x1UL << (1U))
+#define ETH_DMACRCR_RPBL_Pos (16U)
+#define ETH_DMACRCR_SR (0x1UL << (0U))
+#define ETH_DMACSR_AIS (0x1UL << (14U))
+#define ETH_DMACSR_CDE (0x1UL << (13U))
+#define ETH_DMACSR_FBE (0x1UL << (12U))
+#define ETH_DMACSR_NIS (0x1UL << (15U))
+#define ETH_DMACSR_RBU (0x1UL << (7U))
+#define ETH_DMACSR_RI (0x1UL << (6U))
+#define ETH_DMACSR_RPS (0x1UL << (8U))
